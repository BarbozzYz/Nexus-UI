		TextSize = 12,
		AutoButtonColor = false,
		Parent = row,
	})
	corner(btn, 6)
	create("UIGradient", {
		Color = ColorSequence.new(Theme.Accent, Theme.AccentDark),
		Parent = btn,
	})
	local outline = stroke(btn, Theme.AccentSoft, 1, 0.35)
	local press = create("UIScale", { Scale = 1, Parent = btn })

	btn.MouseEnter:Connect(function()
		tween(outline, Ease.Fast, { Transparency = 0 })
	end)
	btn.MouseLeave:Connect(function()
		tween(outline, Ease.Fast, { Transparency = 0.35 })
		tween(press, Ease.Fast, { Scale = 1 })
	end)
	btn.MouseButton1Down:Connect(function()
		tween(press, Ease.Fast, { Scale = 0.97 })
	end)
	btn.MouseButton1Up:Connect(function()
		tween(press, Ease.Back, { Scale = 1 })
	end)
	btn.Activated:Connect(function()
		fire(opts.Callback)
	end)

	function obj.SetText(_, text)
		btn.Text = text
	end
	return self:_register(name, row, obj)
end

---------------------------------------------------------------- dropdown

function Card:AddDropdown(opts)
	opts = opts or {}
	local name = opts.Name or "Dropdown"
	local options = opts.Options or {}
	local BTN_H, ITEM_H = 30, 30
	local width = opts.Width or 140
	local maxVisible = opts.MaxVisible or 5
	local obj = { Value = nil }
	local open = false

	local holder = create("Frame", {
		Name = name,
		Size = UDim2.new(1, 0, 0, BTN_H),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		LayoutOrder = self:_order(),
		Parent = self.Frame,
	})
	local button = create("TextButton", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.fromOffset(width, BTN_H),
		BackgroundColor3 = Theme.Item,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Parent = holder,
	})
	corner(button, 6)
	local text = label({
		Parent = button,
		Size = UDim2.new(1, -26, 1, 0),
		Text = name,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local arrow = chevron(button, Theme.Text)
	arrow.Position = UDim2.new(1, -16, 0.5, 0)

	local list = create("ScrollingFrame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, BTN_H + 2),
		Size = UDim2.fromOffset(width, 0),
		BackgroundColor3 = Theme.List,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = Theme.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = holder,
	})
	corner(list, 6)
	create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })

	local function listHeight()
		return math.min(#options, maxVisible) * ITEM_H
	end

	local function setOpen(state)
		open = state
		local h = listHeight()
		tween(holder, Ease.Med, { Size = UDim2.new(1, 0, 0, state and (BTN_H + 2 + h) or BTN_H) })
		tween(list, Ease.Med, { Size = UDim2.fromOffset(width, state and h or 0) })
		tween(arrow, Ease.Med, { Rotation = state and 180 or 0 })
		tween(button, Ease.Fast, { BackgroundColor3 = state and Theme.ItemHover or Theme.Item })
	end

	local items = {}
	local function paintSelection()
		for opt, entry in pairs(items) do
			tween(entry, Ease.Fast, { TextColor3 = (opt == obj.Value) and Theme.Accent or Theme.Text })
		end
	end

	function obj:Set(v, silent)
		obj.Value = v
		text.Text = v ~= nil and tostring(v) or name
		paintSelection()
		obj.Card:_flag(opts.Flag, v)
		if not silent then
			fire(opts.Callback, v)
		end
	end
	obj.Card = self
	function obj.Get()
		return obj.Value
	end

	local function build()
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("TextButton") then
				c:Destroy()
			end
		end
		items = {}
		for i, opt in ipairs(options) do
			local b = create("TextButton", {
				LayoutOrder = i,
				Size = UDim2.new(1, 0, 0, ITEM_H),
				BackgroundColor3 = Theme.ItemHover,
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				Parent = list,
			})
			corner(b, 6)
			local t = label({
				Parent = b,
				Position = UDim2.fromOffset(10, 0),
				Size = UDim2.new(1, -10, 1, 0),
				Text = tostring(opt),
				TextSize = 12,
				TextColor3 = (opt == obj.Value) and Theme.Accent or Theme.Text,
			})
			items[opt] = t
			b.MouseEnter:Connect(function()
				tween(b, Ease.Fast, { BackgroundTransparency = 0.5 })
			end)
			b.MouseLeave:Connect(function()
				tween(b, Ease.Fast, { BackgroundTransparency = 1 })
			end)
			b.Activated:Connect(function()
				obj:Set(opt)
				setOpen(false)
			end)
		end
	end

	function obj:SetOptions(newOptions)
		options = newOptions
		build()
		if open then
			setOpen(true)
		end
	end

	button.Activated:Connect(function()
		setOpen(not open)
	end)
	button.MouseEnter:Connect(function()
		if not open then
			tween(button, Ease.Fast, { BackgroundColor3 = Theme.ItemHover })
		end
	end)
	button.MouseLeave:Connect(function()
		if not open then
			tween(button, Ease.Fast, { BackgroundColor3 = Theme.Item })
		end
	end)

	build()
	if opts.Default ~= nil then
		obj.Value = opts.Default
		text.Text = tostring(opts.Default)
		paintSelection()
		self:_flag(opts.Flag, opts.Default)
	end
	return self:_register(name, holder, obj)
end

---------------------------------------------------------------- keybind

function Card:AddKeybind(opts)
	opts = opts or {}
	local name = opts.Name or "Keybind"
	local obj = { Value = nil }
	local window = self.Window

	local row = create("Frame", {
		Name = name,
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundTransparency = 1,
		LayoutOrder = self:_order(),
		Parent = self.Frame,
	})
	label({ Parent = row, Size = UDim2.new(1, -70, 1, 0), Text = name, TextSize = 12 })
	local btn = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(62, 22),
		BackgroundColor3 = Theme.KeybindBg,
		BorderSizePixel = 0,
		Text = "Input",
		TextColor3 = Theme.Text,
		Font = Theme.Font,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
		AutoButtonColor = false,
		Parent = row,
	})
	corner(btn, 6)
	local outline = stroke(btn, Theme.AccentSoft, 1, 0.4)

	local listening = false

	function obj:Set(key, silent)
		obj.Value = key
		btn.Text = key and (KeyNames[key.Name] or key.Name) or "Input"
		obj.Card:_flag(opts.Flag, key)
		if not silent then
			fire(opts.OnChanged, key)
		end
	end
	obj.Card = self
	function obj.Get()
		return obj.Value
	end

	btn.Activated:Connect(function()
		if listening then
			return
		end
		listening = true
		Nexus._listening = true
		btn.Text = "..."
		tween(outline, Ease.Fast, { Transparency = 0, Color = Theme.Accent })
		local conn
		conn = UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.Keyboard then
				return
			end
			conn:Disconnect()
			listening = false
			task.defer(function()
				Nexus._listening = false
			end)
			tween(outline, Ease.Fast, { Transparency = 0.4, Color = Theme.AccentSoft })
			if input.KeyCode == Enum.KeyCode.Escape then
				obj:Set(nil)
			else
				obj:Set(input.KeyCode)
			end
		end)
	end)

	table.insert(window.Connections, UserInputService.InputBegan:Connect(function(input, processed)
		if processed or listening or Nexus._listening or not obj.Value then
			return
		end
		if input.KeyCode == obj.Value then
			fire(opts.Callback, obj.Value)
		end
	end))

	if opts.Default then
		obj:Set(opts.Default, true)
	end
	return self:_register(name, row, obj)
end

---------------------------------------------------------------- color picker (bolinha)

function Card:AddColorPicker(opts)
	opts = opts or {}
	local name = opts.Name or "ColorPicker"
	local obj = { Value = opts.Default or Color3.fromRGB(255, 60, 60) }
	local window = self.Window

	local row = create("Frame", {
		Name = name,
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundTransparency = 1,
		LayoutOrder = self:_order(),
		Parent = self.Frame,
	})
	label({ Parent = row, Size = UDim2.new(1, -30, 1, 0), Text = name, TextSize = 12 })
	local ball = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = obj.Value,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Parent = row,
	})
	corner(ball, 10)
	stroke(ball, Color3.new(1, 1, 1), 1, 0.8)

	function obj:Set(color, silent)
		obj.Value = color
		tween(ball, Ease.Fast, { BackgroundColor3 = color })
		obj.Card:_flag(opts.Flag, color)
		if window._cp and window._cp.Target == obj then
			window._cp:Sync(color)
		end
		if not silent then
			fire(opts.Callback, color)
		end
	end
	obj.Card = self
	function obj.Get()
		return obj.Value
	end

	ball.MouseEnter:Connect(function()
		tween(ball, Ease.Back, { Size = UDim2.fromOffset(22, 22) })
	end)
	ball.MouseLeave:Connect(function()
		tween(ball, Ease.Fast, { Size = UDim2.fromOffset(20, 20) })
	end)
	ball.Activated:Connect(function()
		window:_toggleColorPicker(obj)
	end)

	self:_flag(opts.Flag, obj.Value)
	return self:_register(name, row, obj)
end

---------------------------------------------------------------- label

function Card:AddLabel(text)
	local obj = {}
	local lbl = label({
		Name = "Label",
		Size = UDim2.new(1, 0, 0, 20),
		Text = text or "Label",
		TextColor3 = Theme.SubText,
		TextSize = 11,
		TextWrapped = true,
		LayoutOrder = self:_order(),
		Parent = self.Frame,
	})
	function obj.SetText(_, t)
		lbl.Text = t
	end
	return self:_register(text or "Label", lbl, obj)
end

