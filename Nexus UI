function Window:_applySearch(query)
	query = string.lower(query or "")
	for _, tab in ipairs(self.Tabs) do
		for _, card in ipairs(tab.Cards) do
			local any = false
			for _, el in ipairs(card.Elements) do
				local match = query == "" or string.find(string.lower(el.Name), query, 1, true) ~= nil
				el.Frame.Visible = match
				if match then
					any = true
				end
			end
			card.Holder.Visible = query == "" or any
		end
	end
end

function Window:SelectTab(tab)
	if self.Current == tab then
		return
	end
	local prev = self.Current
	self.Current = tab

	for _, t in ipairs(self.Tabs) do
		t.Active = (t == tab)
		tween(t._dot, Ease.Med, { BackgroundColor3 = t.Active and Theme.Accent or Theme.Muted })
		tween(t._text, Ease.Med, { TextColor3 = t.Active and Theme.Accent or Theme.Muted })
	end

	if prev then
		local out = tween(prev.Page, Ease.Fast, { GroupTransparency = 1 })
		out.Completed:Connect(function()
			if not prev.Active then
				prev.Page.Visible = false
			end
		end)
	end

	tab.Page.Visible = true
	tab.Page.GroupTransparency = 1
	tab.Page.Position = UDim2.new(0, 0, 0, 10)
	tween(tab.Page, Ease.Med, { GroupTransparency = 0, Position = UDim2.new(0, 0, 0, 0) })
end

