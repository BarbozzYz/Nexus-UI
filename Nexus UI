function Nexus:CreateColorPicker(default, callback)
    local hue, sat, val = Color3.toHSV(default or Color3.fromRGB(255, 0, 0))
    
    local frame = create("Frame", {
        Size = UDim2.new(0, 220, 0, 260),
        Position = UDim2.new(0.5, -110, 0.5, -130),
        BackgroundColor3 = self.Theme.Panel,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 100,
        Parent = self.Gui,
    })
    corner(frame, 8)
    stroke(frame, self.Theme.Border)
    
    -- Barra superior com accent
    local header = create("Frame", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundColor3 = self.Theme.Accent,
        BorderSizePixel = 0,
        ZIndex = 101,
        Parent = frame,
    })
    corner(header, 8)
    create("Frame", {
        Size = UDim2.new(1, 0, 0, 10),
        Position = UDim2.new(0, 0, 1, -10),
        BackgroundColor3 = self.Theme.Accent,
        BorderSizePixel = 0,
        ZIndex = 101,
        Parent = header,
    })
    
    create("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "Color Picker",
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 14,
        Font = self.Theme.FontBold,
        ZIndex = 102,
        Parent = header,
    })
    
    local closeBtn = create("TextButton", {
        Size = UDim2.new(0, 30, 0, 30),
        Position = UDim2.new(1, -30, 0, 0),
        BackgroundTransparency = 1,
        Text = "×",
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 20,
        Font = self.Theme.FontBold,
        ZIndex = 102,
        Parent = header,
    })
    closeBtn.MouseButton1Click:Connect(function()
        frame.Visible = false
    end)
    
    -- Color wheel (feito com ImageLabel ou Gradient + frame)
    local wheelFrame = create("Frame", {
        Size = UDim2.new(0, 160, 0, 160),
        Position = UDim2.new(0.5, -80, 0, 45),
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BorderSizePixel = 0,
        ZIndex = 101,
        Parent = frame,
    })
    corner(wheelFrame, 80)
    
    -- Simulação de roda: usamos Hue gradient + Saturation gradient over
    local hueImg = create("ImageLabel", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Image = "rbxassetid://10251045145", -- Hue wheel asset
        ZIndex = 101,
        Parent = wheelFrame,
    })
    corner(hueImg, 80)
    
    local satOverlay = create("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        ZIndex = 102,
        Parent = wheelFrame,
    })
    corner(satOverlay, 80)
    
    -- Selector
    local selector = create("Frame", {
        Size = UDim2.new(0, 12, 0, 12),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundColor3 = Color3.new(0, 0, 0),
        BorderSizePixel = 0,
        ZIndex = 103,
        Parent = wheelFrame,
    })
    corner(selector, 6)
    stroke(selector, Color3.new(1, 1, 1), 2)
    
    -- Textboxes hex e RGB
    local hexBox = create("TextBox", {
        Size = UDim2.new(0, 95, 0, 30),
        Position = UDim2.new(0, 15, 0, 215),
        BackgroundColor3 = self.Theme.Element,
        Text = "",
        PlaceholderText = "Hex...",
        PlaceholderColor3 = self.Theme.SubText,
        TextColor3 = self.Theme.Text,
        TextSize = 13,
        Font = self.Theme.Font,
        BorderSizePixel = 0,
        ZIndex = 101,
        Parent = frame,
    })
    corner(hexBox, 4)
    
    local rgbBox = create("TextBox", {
        Size = UDim2.new(0, 95, 0, 30),
        Position = UDim2.new(1, -110, 0, 215),
        BackgroundColor3 = self.Theme.Element,
        Text = "",
        PlaceholderText = "R, G, B",
        PlaceholderColor3 = self.Theme.SubText,
        TextColor3 = self.Theme.Text,
        TextSize = 13,
        Font = self.Theme.Font,
        BorderSizePixel = 0,
        ZIndex = 101,
        Parent = frame,
    })
    corner(rgbBox, 4)
    
    -- State
    local currentColor = default or Color3.fromRGB(255, 0, 0)
    
    local function updateWheel()
        selector.Position = UDim2.new(sat, 0, 1 - val, 0)
        satOverlay.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
        satOverlay.BackgroundTransparency = 0
        local h, s, v = Color3.toHSV(currentColor)
        hue, sat, val = h, s, v
        selector.Position = UDim2.new(sat, 0, 1 - val, 0)
    end
    
    local function fromWheel(px, py)
        local relX = (px - wheelFrame.AbsolutePosition.X) / wheelFrame.AbsoluteSize.X
        local relY = (py - wheelFrame.AbsolutePosition.Y) / wheelFrame.AbsoluteSize.Y
        relX = math.clamp(relX, 0, 1)
        relY = math.clamp(relY, 0, 1)
        sat = relX
        val = 1 - relY
        currentColor = Color3.fromHSV(hue, sat, val)
        selector.Position = UDim2.new(sat, 0, 1 - val, 0)
        selector.BackgroundColor3 = currentColor
        hexBox.Text = string.format("%02X%02X%02X",
            math.floor(currentColor.R * 255),
            math.floor(currentColor.G * 255),
            math.floor(currentColor.B * 255))
        rgbBox.Text = string.format("%d, %d, %d",
            math.floor(currentColor.R * 255),
            math.floor(currentColor.G * 255),
            math.floor(currentColor.B * 255))
        callback(currentColor)
    end
    
    local dragging = false
    wheelFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            fromWheel(input.Position.X, input.Position.Y)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            fromWheel(input.Position.X, input.Position.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    -- Inicializa
    selector.BackgroundColor3 = currentColor
    selector.Position = UDim2.new(sat, 0, 1 - val, 0)
    satOverlay.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
    hexBox.Text = string.format("%02X%02X%02X",
        math.floor(currentColor.R * 255),
        math.floor(currentColor.G * 255),
        math.floor(currentColor.B * 255))
    rgbBox.Text = string.format("%d, %d, %d",
        math.floor(currentColor.R * 255),
        math.floor(currentColor.G * 255),
        math.floor(currentColor.B * 255))
    
    hexBox.FocusLost:Connect(function()
        local hex = hexBox.Text:gsub("#", "")
        if #hex == 6 then
            local r = tonumber(hex:sub(1, 2), 16)
            local g = tonumber(hex:sub(3, 4), 16)
            local b = tonumber(hex:sub(5, 6), 16)
            if r and g and b then
                currentColor = Color3.fromRGB(r, g, b)
                hue, sat, val = Color3.toHSV(currentColor)
                selector.BackgroundColor3 = currentColor
                selector.Position = UDim2.new(sat, 0, 1 - val, 0)
                callback(currentColor)
            end
        end
    end)
    
    rgbBox.FocusLost:Connect(function()
        local parts = string.split(rgbBox.Text, ",")
        if #parts >= 3 then
            local r, g, b = tonumber(parts[1]), tonumber(parts[2]), tonumber(parts[3])
            if r and g and b then
                currentColor = Color3.fromRGB(r, g, b)
                hue, sat, val = Color3.toHSV(currentColor)
                selector.BackgroundColor3 = currentColor
                selector.Position = UDim2.new(sat, 0, 1 - val, 0)
                callback(currentColor)
            end
        end
    end)
    
    return frame, function()
        frame.Visible = not frame.Visible
    end
end

