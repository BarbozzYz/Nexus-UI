function Window:SetVisible(state)
	if state == self.Visible then
		return
	end
	self.Visible = state
	self._toggleToken = (self._toggleToken or 0) + 1
	local token = self._toggleToken

	if state then
		self.Root.Visible = true
		tween(self.Scale, Ease.Back, { Scale = 1 })
		tween(self.Root, Ease.Med, { GroupTransparency = 0 })
		for _, p in ipairs(self.Popups) do
			if p.WasOpen then
				p:Open()
			end
		end
		if self._cursorActivate then
			self._cursorActivate()
		end
	else
		for _, p in ipairs(self.Popups) do
			p.WasOpen = p.IsOpen
			p:Close(true)
		end
		tween(self.Scale, Ease.Fast, { Scale = 0.94 })
		local t = tween(self.Root, Ease.Fast, { GroupTransparency = 1 })
		t.Completed:Connect(function()
			if self._toggleToken == token and not self.Visible then
				self.Root.Visible = false
			end
		end)
		if self._cursorDeactivate then
			self._cursorDeactivate()
		end
	end
end

function Window:Toggle()
	self:SetVisible(not self.Visible)
end

-- cria, dentro do card passado, um Keybind ja ligado a abrir/fechar este painel
function Window:BindToggleKeybind(card, opts)
	opts = opts or {}
	local window = self
	return card:AddKeybind({
		Name = opts.Name or "Abrir / Fechar Painel",
		Default = window.ToggleKey,
		Flag = opts.Flag,
		OnChanged = function(key)
			window.ToggleKey = key or window.ToggleKey
			fire(opts.OnChanged, key)
		end,
	})
end

function Window:Notify(opts)
	Nexus:Notify(opts)
end

function Window:Destroy()
	if self._cursorDeactivate then
		self._cursorDeactivate()
	end
	for _, c in ipairs(self.Connections) do
		c:Disconnect()
	end
	for _, p in ipairs(self.Popups) do
		if p.Destroying then
			p.Destroying()
		end
		p.Root:Destroy()
	end
	self.Root:Destroy()
end

