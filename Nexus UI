------------------------------------------------------------------ tema runtime

function Nexus:SetThemeColor(key, color, animate)
	if typeof(Theme[key]) ~= "Color3" then
		return
	end
	local old = Theme[key]
	Theme[key] = color
	local list = self._paints[key]
	if not list then
		return
	end
	local kept = {}
	for _, e in ipairs(list) do
		if e.inst and e.inst.Parent then
			local ok, current = pcall(function()
				return e.inst[e.prop]
			end)
			if ok and current == old then
				if animate then
					tween(e.inst, Ease.Fast, { [e.prop] = color })
				else
					e.inst[e.prop] = color
				end
			end
			kept[#kept + 1] = e
		end
	end
	self._paints[key] = kept
end

function Nexus:GetTheme()
	local out = {}
	for key, val in pairs(Theme) do
		if typeof(val) == "Color3" then
			out[key] = { val.R, val.G, val.B }
		end
	end
	return out
end

function Nexus:ApplyTheme(tbl, animate)
	if not tbl then
		return
	end
	for key, v in pairs(tbl) do
		if typeof(Theme[key]) == "Color3" and typeof(v) == "table" and v[1] then
			self:SetThemeColor(key, Color3.new(v[1], v[2], v[3]), animate)
		end
	end
end

function Nexus:SaveTheme(name)
	local ok, json = pcall(function()
		return HttpService:JSONEncode(self:GetTheme())
	end)
	if not ok then
		return false
	end
	if not writefile then
		return false, json
	end
	local ok2 = pcall(writefile, (name or "NexusTheme") .. ".json", json)
	return ok2, json
end

function Nexus:LoadTheme(name, animate)
	if not readfile then
		return false
	end
	local ok, json = pcall(readfile, (name or "NexusTheme") .. ".json")
	if not ok then
		return false
	end
	local ok2, tbl = pcall(function()
		return HttpService:JSONDecode(json)
	end)
	if not ok2 then
		return false
	end
	self:ApplyTheme(tbl, animate)
	return true
end

