function Window:_sidePosition(popup)
	local abs, sz = self.Root.AbsolutePosition, self.Root.AbsoluteSize
	local view = self.Gui.AbsoluteSize
	local w, h = popup.Size.X, popup.Size.Y
	local x = abs.X + sz.X + 16 + w / 2
	if x + w / 2 > view.X - 8 then
		x = abs.X - 16 - w / 2
	end
	if x - w / 2 < 8 then
		x = view.X / 2
	end
	local y = abs.Y + h / 2 + (popup.Slot or 0) * 340
	y = math.clamp(y, h / 2 + 8, math.max(h / 2 + 8, view.Y - h / 2 - 8))
	return UDim2.fromOffset(x, y)
end

