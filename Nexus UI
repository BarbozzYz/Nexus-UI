        optBtn.MouseEnter:Connect(function() tween(optBtn, { BackgroundColor3 = self.Theme.ElementHover }, 0.1) end)
        optBtn.MouseLeave:Connect(function() tween(optBtn, { BackgroundColor3 = self.Theme.Element }, 0.1) end)
