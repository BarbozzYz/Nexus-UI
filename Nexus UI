        state = not state
        tween(toggleBg, { BackgroundColor3 = state and self.Theme.Accent or self.Theme.ToggleOff }, 0.15)
        tween(knob, { Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8) }, 0.15)
        callback(state)
    end)
