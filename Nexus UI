------------------------------------------------------------------ helpers

Nexus._paints = {}

local ThemedProps = { BackgroundColor3 = true, TextColor3 = true, ImageColor3 = true }

local function registerThemed(inst, prop, color)
	for key, val in pairs(Theme) do
		if typeof(val) == "Color3" and val == color then
			local list = Nexus._paints[key]
			if not list then
				list = {}
				Nexus._paints[key] = list
			end
			list[#list + 1] = { inst = inst, prop = prop }
		end
	end
end

local function create(class, props, children)
	props = props or {}
	-- Instance.new(classe, pai) de 2 argumentos: alem de ser o jeito recomendado pela Roblox,
	-- alguns executores mais simples (ex.: Nexomia) tem bugs com Instance.new(classe) de 1
	-- argumento quando a classe vem de uma variavel, e retornam nil
	local inst = Instance.new(class, props.Parent)
	if not inst then
		task.wait()
		inst = Instance.new(class, props.Parent)
	end
	assert(inst, "Nexus Lib: Instance.new('" .. tostring(class) .. "') retornou nil - o executor esta bloqueando essa classe, ou o script foi colado incompleto.")
	for k, v in pairs(props) do
		if k ~= "Parent" then
			inst[k] = v
			if ThemedProps[k] and typeof(v) == "Color3" then
				registerThemed(inst, k, v)
			end
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	return inst
end

local function tween(obj, info, props)
	local t = TweenService:Create(obj, info, props)
	t:Play()
	return t
end

-- instant = true aplica direto, sem animar (usado na criacao dos elementos)
local function apply(obj, info, props, instant)
	if instant then
		for k, v in pairs(props) do
			obj[k] = v
		end
		return nil
	end
	return tween(obj, info, props)
end

local function corner(obj, radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius or 6), Parent = obj })
end

local function stroke(obj, color, thickness, transparency, mode)
	return create("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = mode or Enum.ApplyStrokeMode.Border,
		Parent = obj,
	})
end

local function label(props)
	local base = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Theme.Font,
		TextColor3 = Theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	return create("TextLabel", base)
end

local function fire(callback, ...)
	if callback then
		task.spawn(callback, ...)
	end
end

