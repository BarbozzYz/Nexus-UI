function Nexus:CreateColorPicker(default, callback)
    local color = default or Color3.fromRGB(255, 0, 0)
    local hue, sat, val = Color3.toHSV(color)
    
    local frame = create("Frame", {
        Size = UDim2.new(0, 220, 0, 260),
