Nexus.Notifications = {}

function Nexus:Notify(title, text, duration)
    duration = duration or 4
    
    local idx = #self.Notifications
    local frame = create("Frame", {
        Size = UDim2.new(0, 280, 0, 55),
        Position = UDim2.new(0, -300, 1, -75 - (idx * 65)),
        BackgroundColor3 = self.Theme.Panel,
        BorderSizePixel = 0,
        Parent = self.Gui,
        ZIndex = 999999,
    })
    corner(frame, 6)
    stroke(frame, self.Theme.Border)
    
    create("Frame", {
        Size = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = self.Theme.Accent,
        BorderSizePixel = 0,
        ZIndex = 999999,
        Parent = frame,
    })
    
    create("TextLabel", {
        Size = UDim2.new(1, -40, 0, 20),
        Position = UDim2.new(0, 12, 0, 8),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = self.Theme.Text,
        TextSize = 14,
        Font = self.Theme.FontBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 999999,
        Parent = frame,
    })
    
    create("TextLabel", {
        Size = UDim2.new(1, -40, 0, 20),
        Position = UDim2.new(0, 12, 0, 28),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = self.Theme.SubText,
        TextSize = 12,
        Font = self.Theme.Font,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 999999,
        Parent = frame,
    })
    
    table.insert(self.Notifications, frame)
    tween(frame, { Position = UDim2.new(0, 20, 1, -75 - (idx * 65)) }, 0.3)
    
    task.delay(duration, function()
        tween(frame, { Position = UDim2.new(0, -300, 1, frame.Position.Y.Offset) }, 0.3)
        task.wait(0.35)
        local i = table.find(self.Notifications, frame)
        if i then table.remove(self.Notifications, i) end
        frame:Destroy()
        for k, n in ipairs(self.Notifications) do
            tween(n, { Position = UDim2.new(0, 20, 1, -75 - ((k-1) * 65)) }, 0.2)
        end
    end)
end

