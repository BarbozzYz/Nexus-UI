                        preview.Size=UDim2.new(0,22,0,22)
                        preview.Position=UDim2.new(1,-26,0.5,-11)
                        preview.BackgroundColor3=cpdef
                        preview.BorderSizePixel=0
                        preview.ZIndex=13
                        preview.Parent=row
                        Instance.new("UICorner",preview).CornerRadius=UDim.new(0,5)

                        local pickerOpen=false
                        local pickerFrame=nil

                        local openBtn=Instance.new("TextButton")
                        openBtn.Size=UDim2.new(1,0,1,0)
                        openBtn.BackgroundTransparency=1
                        openBtn.Text=""
                        openBtn.ZIndex=14
                        openBtn.Parent=row

                        openBtn.MouseButton1Click:Connect(function()
                            if pickerOpen and pickerFrame then
                                pickerFrame:Destroy()
                                pickerFrame=nil
                                pickerOpen=false
                                return
                            end
                            pickerOpen=true
                            local pf=Instance.new("Frame")
                            pf.Size=UDim2.new(1,0,0,120)
                            pf.BackgroundTransparency=1
                            pf.ZIndex=12
                            pf.Parent=sec
                            pickerFrame=pf
                            createColorPicker(pf, cpdef, function(c)
                                preview.BackgroundColor3=c
                                cpdef=c
                                if cpcb then cpcb(c) end
                            end)
                        end)

                        return {
                            Get=function() return cpdef end,
                            Set=function(c)
                                cpdef=c
                                preview.BackgroundColor3=c
                            end,
                        }
                    end

                    -- ── Input ──
                    function secData.AddInput(icfg)
                        local ilabel=icfg.Name or "Input"
                        local iph=icfg.Placeholder or "Write here..."
                        local icb=icfg.Callback

                        local row=Instance.new("Frame")
                        row.Size=UDim2.new(1,0,0,28)
                        row.BackgroundTransparency=1
                        row.ZIndex=12
                        row.Parent=sec

                        local lbl=Instance.new("TextLabel")
                        lbl.Size=UDim2.new(0.45,0,1,0)
                        lbl.BackgroundTransparency=1
                        lbl.Text=ilabel.."..."
                        lbl.TextColor3=C.Muted
                        lbl.TextSize=11
                        lbl.Font=Enum.Font.Gotham
                        lbl.TextXAlignment=Enum.TextXAlignment.Left
                        lbl.ZIndex=13
                        lbl.Parent=row

                        local box=Instance.new("TextBox")
                        box.Size=UDim2.new(0.55,0,1,0)
                        box.Position=UDim2.new(0.45,0,0,0)
                        box.BackgroundColor3=C.Surface2
                        box.BorderSizePixel=0
                        box.Text=""
                        box.PlaceholderText=iph
                        box.TextColor3=C.Text
                        box.PlaceholderColor3=C.Muted
                        box.TextSize=11
                        box.Font=Enum.Font.Gotham
                        box.ZIndex=13
                        box.ClearTextOnFocus=false
                        box.Parent=row
                        Instance.new("UICorner",box).CornerRadius=UDim.new(0,5)
                        Instance.new("UIPadding",box).PaddingLeft=UDim.new(0,6)

                        box.FocusLost:Connect(function(enter)
                            if icb then icb(box.Text, enter) end
                        end)

                        return {Get=function() return box.Text end}
                    end

                    -- ── Keybind ──
                    function secData.AddKeybind(kcfg)
                        local klabel=kcfg.Name or "Keybind"
                        local kkey=kcfg.Default or Enum.KeyCode.Unknown
                        local kcb=kcfg.Callback
                        local waiting=false

                        local row=Instance.new("Frame")
                        row.Size=UDim2.new(1,0,0,28)
                        row.BackgroundTransparency=1
                        row.ZIndex=12
                        row.Parent=sec

                        local lbl=Instance.new("TextLabel")
                        lbl.Size=UDim2.new(0.55,0,1,0)
                        lbl.BackgroundTransparency=1
                        lbl.Text=klabel
                        lbl.TextColor3=C.Text
                        lbl.TextSize=12
                        lbl.Font=Enum.Font.Gotham
                        lbl.TextXAlignment=Enum.TextXAlignment.Left
                        lbl.ZIndex=13
                        lbl.Parent=row

                        local kbtn=Instance.new("TextButton")
                        kbtn.Size=UDim2.new(0.45,0,1,-2)
                        kbtn.Position=UDim2.new(0.55,0,0,1)
                        kbtn.BackgroundColor3=C.Surface2
                        kbtn.BorderSizePixel=0
                        kbtn.Text=tostring(kkey).gsub("Enum.KeyCode.","")
                        kbtn.TextColor3=C.Text
                        kbtn.TextSize=11
                        kbtn.Font=Enum.Font.Code
                        kbtn.ZIndex=13
                        kbtn.Parent=row
                        Instance.new("UICorner",kbtn).CornerRadius=UDim.new(0,5)

                        kbtn.MouseButton1Click:Connect(function()
                            waiting=true
                            kbtn.Text="..."
                            kbtn.TextColor3=C.Accent
                        end)

                        UserInputService.InputBegan:Connect(function(i,gp)
                            if waiting and not gp then
                                waiting=false
                                kkey=i.KeyCode
                                kbtn.Text=tostring(kkey):gsub("Enum.KeyCode.","")
                                kbtn.TextColor3=C.Text
                                if kcb then kcb(kkey) end
                                addKeybindEntry(klabel, kkey)
                            end
                        end)

                        return {Get=function() return kkey end}
                    end

                    return secData
                end -- AddSection

                return colData
            end -- AddColumn

            return tabData
        end -- AddTab

        -- auto-select first page
        if #navButtons==1 then
            setPage(pageData)
        end

        return pageData
    end -- AddPage

    -- ── Window Controls ──
    function win.AddWindowButton(wcfg)
        local wlabel=wcfg.Name or "Button"
        local wcb=wcfg.Callback

        local btn=Instance.new("TextButton")
        btn.Size=UDim2.new(0,24,0,24)
        btn.Position=UDim2.new(1,-#screenGui:GetChildren()*30,0,8)
        btn.BackgroundColor3=C.Surface
        btn.BorderSizePixel=0
        btn.Text=wlabel
        btn.TextColor3=C.Accent
        btn.TextSize=11
        btn.Font=Enum.Font.GothamBold
        btn.ZIndex=15
        btn.Parent=frame
        Instance.new("UICorner",btn).CornerRadius=UDim.new(0,5)
        btn.MouseButton1Click:Connect(function()
            ripple(btn,mouse.X,mouse.Y)
            if wcb then wcb() end
        end)
    end

    -- ── Open/Close ──
    local isOpen=false

    local function openWindow()
        isOpen=true
        frame.Visible=true
        frame.Size=UDim2.new(0,0,0,height)
        frame.AnchorPoint=Vector2.new(0,0.5)
        frame.ClipsDescendants=true

        tween(blur,0.3,{Size=14}):Play()
        setCursorVisible(true)

        local elapsed=0
        local conn2
        conn2=RunService.Heartbeat:Connect(function(dt)
            elapsed=elapsed+dt
            local t=math.clamp(elapsed/0.5,0,1)
            local e=elasticOut(t)
            frame.Size=UDim2.new(0,math.max(0,e*width),0,height)
            if t>=1 then
                conn2:Disconnect()
                frame.Size=UDim2.new(0,width,0,height)
                frame.AnchorPoint=Vector2.new(0.5,0.5)
                frame.Position=UDim2.new(0.5,0,0.5,0)
                frame.ClipsDescendants=false
            end
        end)
    end

    local function closeWindow()
        isOpen=false
        tween(blur,0.2,{Size=0}):Play()
        setCursorVisible(false)
        tween(frame,0.2,{Size=UDim2.new(0,0,0,height)},Enum.EasingStyle.Quad):Play()
        task.delay(0.25,function() frame.Visible=false end)
    end

    UserInputService.InputBegan:Connect(function(i,gp)
        if gp then return end
        if i.KeyCode==toggleKey then
            if isOpen then closeWindow() else openWindow() end
        end
    end)

    openWindow()
    return win
end

return Nexus
