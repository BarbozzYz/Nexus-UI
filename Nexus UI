function Nexus:AddTab(name, icon)
    local tab = {
        Name = name,
        Icon = icon or "●",
        Elements = {},
        Button = nil,
        ContentFrame = nil,
    }
    
    -- Botão na sidebar
    local btn = create("TextButton", {
        Size = UDim2.new(1, -20, 0, 36),
        BackgroundColor3 = self.Theme.Sidebar,
        Text = "",
        BorderSizePixel = 0,
        Parent = self.Sidebar,
    })
    corner(btn, 6)
    
    create("TextLabel", {
        Size = UDim2.new(0, 20, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Text = tab.Icon,
        TextColor3 = self.Theme.Accent,
        TextSize = 12,
        Font = self.Theme.FontBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = btn,
    })
    create("TextLabel", {
        Size = UDim2.new(1, -40, 1, 0),
        Position = UDim2.new(0, 34, 0, 0),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = self.Theme.Text,
        TextSize = 13,
        Font = self.Theme.Font,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = btn,
    })
    
    -- Conteúdo
    local content = create("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = self.Theme.Border,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        Visible = false,
        Parent = self.Content,
    })
    
    create("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = content,
    })
    create("UIPadding", {
        PaddingTop = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 10),
        PaddingBottom = UDim.new(0, 10),
        Parent = content,
    })
    
    tab.Button = btn
    tab.ContentFrame = content
    table.insert(self.Tabs, tab)
    
    btn.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)
    
    btn.MouseEnter:Connect(function()
        if self.SelectedTab ~= tab then
            tween(btn, { BackgroundColor3 = self.Theme.Element }, 0.1)
        end
    end)
    btn.MouseLeave:Connect(function()
        if self.SelectedTab ~= tab then
            tween(btn, { BackgroundColor3 = self.Theme.Sidebar }, 0.1)
        end
    end)
    
    return tab
end

function Nexus:SelectTab(tab)
    for _, t in ipairs(self.Tabs) do
        t.ContentFrame.Visible = false
        tween(t.Button, { BackgroundColor3 = self.Theme.Sidebar }, 0.1)
    end
    tab.ContentFrame.Visible = true
    tween(tab.Button, { BackgroundColor3 = self.Theme.Accent }, 0.1)
    self.SelectedTab = tab
end

-- ============================================================
-- WINDOW CREATION
-- ============================================================
function Nexus.new(config)
    local self = setmetatable({}, Nexus)
    
    self.Config = config or {}
    self.Tabs = {}
    self.Notifications = {}
    
    -- Gui principal
    local gui = create("ScreenGui", {
        Name = "NexusLib",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = CoreGui,
    })
    self.Gui = gui
    
    -- Main frame
    local main = create("Frame", {
        Size = UDim2.new(0, 580, 0, 380),
        Position = UDim2.new(0.5, -290, 0.5, -190),
        BackgroundColor3 = self.Theme.Background,
        BorderSizePixel = 0,
        Active = true,
        Draggable = true,
        Parent = gui,
    })
    corner(main, 12)
    stroke(main, self.Theme.Border)
    self.Main = main
    
    -- Sidebar
    local sidebar = create("Frame", {
        Size = UDim2.new(0, 150, 1, 0),
        BackgroundColor3 = self.Theme.Sidebar,
