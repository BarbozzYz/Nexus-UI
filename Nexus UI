		end
		if input.KeyCode == self.ToggleKey then
			self:SetVisible(not self.Visible)
		end
	end))

	if opts.Resizable ~= false then
		local minSize = opts.MinSize or Nexus.Sizes.MinWindow
		local maxSize = opts.MaxSize or Nexus.Sizes.MaxWindow

		local grip = create("Frame", {
			Name = "Resize",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 3, 1, -3),
			Size = UDim2.fromOffset(16, 16),
			BackgroundTransparency = 1,
			ZIndex = 5,
			Parent = root,
		})
		local gripIcon = createIcon(grip, "resize", 14, Theme.SubText)
		if gripIcon then
			gripIcon.Frame.Position = UDim2.fromOffset(1, 1)
		end
		local gripHit = create("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 6,
			Parent = grip,
		})

		local topRight, resizeConn

		local function updateResize()
			local m = mousePos()
			local newW = math.clamp(topRight.X - m.X, minSize.X, maxSize.X)
			local newH = math.clamp(m.Y - topRight.Y, minSize.Y, maxSize.Y)
			root.Size = UDim2.fromOffset(newW, newH)
			root.Position = UDim2.fromOffset(topRight.X - newW / 2, topRight.Y + newH / 2)
			self.Size = Vector2.new(newW, newH)
		end

		local function stopResize()
			if resizeConn then
				resizeConn:Disconnect()
				resizeConn = nil
			end
		end

		gripHit.InputBegan:Connect(function(input)
			if isPress(input) then
				stopResize()
				local abs, sz = root.AbsolutePosition, root.AbsoluteSize
				topRight = Vector2.new(abs.X + sz.X, abs.Y)
				bringFront(root)
				resizeConn = RunService.RenderStepped:Connect(updateResize)
			end
		end)
		table.insert(self.Connections, UserInputService.InputEnded:Connect(function(input)
			if isPress(input) then
				stopResize()
			end
		end))
		if gripIcon then
			grip.MouseEnter:Connect(function()
				gripIcon.SetColor(Theme.Accent)
			end)
			grip.MouseLeave:Connect(function()
				gripIcon.SetColor(Theme.SubText)
			end)
		end
	end

	tween(scale, Ease.Back, { Scale = 1 })
	tween(root, Ease.Slow, { GroupTransparency = 0 })

	return self
end

function Window:_applySearch(query)
	query = string.lower(query or "")
	for _, tab in ipairs(self.Tabs) do
		for _, card in ipairs(tab.Cards) do
			local any = false
			for _, el in ipairs(card.Elements) do
				local match = query == "" or string.find(string.lower(el.Name), query, 1, true) ~= nil
				el.Frame.Visible = match
				if match then
					any = true
				end
			end
			card.Holder.Visible = query == "" or any
		end
	end
end

function Window:SelectTab(tab)
	if self.Current == tab then
		return
	end
	local prev = self.Current
	self.Current = tab

	for _, t in ipairs(self.Tabs) do
		t.Active = (t == tab)
		t._icon.SetColor(t.Active and Theme.Accent or Theme.Muted)
		tween(t._text, Ease.Med, { TextColor3 = t.Active and Theme.Accent or Theme.Muted })
	end

	if prev then
		local out = tween(prev.Page, Ease.Fast, { GroupTransparency = 1 })
		if out then
			out.Completed:Connect(function()
				if not prev.Active then
					prev.Page.Visible = false
				end
			end)
		end
	end

	tab.Page.Visible = true
	tab.Page.GroupTransparency = 1
	tab.Page.Position = UDim2.new(0, 0, 0, 10)
	tween(tab.Page, Ease.Med, { GroupTransparency = 0, Position = UDim2.new(0, 0, 0, 0) })
end

function Window:CreateCategory(name, opts)
	opts = opts or {}
	self._catCount = (self._catCount or 0) + 1
	local cat = setmetatable({
		Name = name,
		Window = self,
		Tabs = {},
		Base = self._catCount * 1000,
		Count = 0,
		Collapsible = opts.Collapsible == true,
		Collapsed = false,
	}, Category)

	local spaced = self._catCount > 1 or (self._looseCount or 0) > 0
	local wrapper = create("TextButton", {
		Name = "Category_" .. name,
		Size = UDim2.new(1, 0, 0, spaced and 30 or 20),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = cat.Base,
		Parent = self._nav,
	})
	local title = string.upper(name)
	local textSize = TextService:GetTextSize(title, 10, Theme.FontMedium, Vector2.new(1000, 20))
	label({
		Parent = wrapper,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 6, 1, -2),
		Size = UDim2.fromOffset(textSize.X + 4, 14),
		Text = title,
		TextColor3 = Color3.fromRGB(105, 105, 112),
		Font = Theme.FontMedium,
		TextSize = 10,
	})
	local reserved = cat.Collapsible and 28 or 8
	local lineStart = 6 + textSize.X + 10
	local line = create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, lineStart, 1, -9),
		Size = UDim2.new(1, -(lineStart + reserved), 0, 1),
		BackgroundColor3 = Theme.Outline,
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
		Parent = wrapper,
	})
	if cat.Collapsible then
		cat._chevron = chevron(wrapper, Color3.fromRGB(105, 105, 112))
		cat._chevron.Position = UDim2.new(1, -12, 1, -9)
		wrapper.Activated:Connect(function()
			cat:SetCollapsed(not cat.Collapsed)
		end)
		wrapper.MouseEnter:Connect(function()
			tween(line, Ease.Fast, { BackgroundTransparency = 0.2 })
		end)
		wrapper.MouseLeave:Connect(function()
			tween(line, Ease.Fast, { BackgroundTransparency = 0.55 })
		end)
	end
	cat.Header = wrapper

	table.insert(self.Categories, cat)
	if opts.Collapsed and cat.Collapsible then
		cat.Collapsed = true
		cat._chevron.Rotation = -90
	end
	return cat
end

function Category:CreateTab(name, iconArg)
	return self.Window:CreateTab(name, iconArg, self)
end

function Category:SetCollapsed(state)
	if not self.Collapsible then
		return
	end
	self.Collapsed = state and true or false
	tween(self._chevron, Ease.Med, { Rotation = self.Collapsed and -90 or 0 })
	for _, tab in ipairs(self.Tabs) do
		local w = tab.Wrapper
		if self.Collapsed then
			local t = tween(w, Ease.Med, { Size = UDim2.new(1, 0, 0, 0) })
			if t then
				t.Completed:Connect(function()
					if self.Collapsed then
						w.Visible = false
					end
				end)
			end
		else
			w.Visible = true
			tween(w, Ease.Med, { Size = UDim2.new(1, 0, 0, 26) })
		end
	end
end

function Window:CreateTab(name, iconArg, category)
	local tab = setmetatable({ Name = name, Window = self, Cards = {}, Active = false, Category = category }, Tab)
	local index = #self.Tabs + 1

	local order
	if category then
		category.Count = category.Count + 1
		order = category.Base + category.Count
	else
		self._looseCount = (self._looseCount or 0) + 1
		order = self._looseCount
	end

	local wrapper = create("Frame", {
		Name = name,
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		LayoutOrder = order,
		Parent = self._nav,
	})
	tab.Wrapper = wrapper
	if category then
		table.insert(category.Tabs, tab)
		if category.Collapsed then
			wrapper.Size = UDim2.new(1, 0, 0, 0)
			wrapper.Visible = false
		end
	end

	local row = create("TextButton", {
		Name = name,
		Position = UDim2.new(0, -14, 0, 0),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = wrapper,
	})
	local slot = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 5, 0.5, 0),
		Size = UDim2.fromOffset(18, 18),
		BackgroundTransparency = 1,
		Parent = row,
	})
	local icon = createIcon(slot, iconArg or string.lower(name), 16, Theme.Muted)
	if icon then
		icon.Frame.Position = UDim2.fromOffset(1, 1)
	else
		local dot = create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Theme.Muted,
			BorderSizePixel = 0,
			Parent = slot,
		})
		corner(dot, 9)
		icon = {
			SetColor = function(c, instant)
				apply(dot, Ease.Med, { BackgroundColor3 = c }, instant)
			end,
		}
	end
	local text = label({
		Parent = row,
		Position = UDim2.fromOffset(32, 0),
		Size = UDim2.new(1, -32, 1, 0),
		Text = name,
		TextColor3 = Theme.Muted,
		Font = Theme.FontMedium,
		TextSize = 12,
	})
	tab._icon, tab._text = icon, text

	row.MouseEnter:Connect(function()
		if not tab.Active then
			tween(text, Ease.Fast, { TextColor3 = Color3.fromRGB(190, 190, 190) })
			icon.SetColor(Color3.fromRGB(190, 190, 190))
		end
	end)
	row.MouseLeave:Connect(function()
		if not tab.Active then
			tween(text, Ease.Fast, { TextColor3 = Theme.Muted })
			icon.SetColor(Theme.Muted)
		end
	end)
	row.Activated:Connect(function()
		self:SelectTab(tab)
	end)

	task.delay(0.15 + index * 0.06, function()
		if row.Parent then
			tween(row, Ease.Slow, { Position = UDim2.new(0, 0, 0, 0) })
		end
	end)

	local page = create("CanvasGroup", {
		Name = name,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Visible = false,
		Parent = self._content,
	})
	local scroll = create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = Theme.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = page,
	})
	create("UIPadding", {
		PaddingLeft = UDim.new(0, 25),
		PaddingTop = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 8),
		Parent = scroll,
	})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Wraps = true,
		Padding = UDim.new(0, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = scroll,
	})
	tab.Page, tab.Scroll = page, scroll

	table.insert(self.Tabs, tab)
	if index == 1 then
		task.delay(0.12, function()
			self:SelectTab(tab)
		end)
	end
	return tab
end

function Window:SetVisible(state)
	if state == self.Visible then
		return
	end
	self.Visible = state
	self._toggleToken = (self._toggleToken or 0) + 1
	local token = self._toggleToken

	if state then
		self.Root.Visible = true
		tween(self.Scale, Ease.Back, { Scale = 1 })
		tween(self.Root, Ease.Med, { GroupTransparency = 0 })
		for _, p in ipairs(self.Popups) do
			if p.WasOpen then
				p:Open()
			end
		end
	else
		for _, p in ipairs(self.Popups) do
			p.WasOpen = p.IsOpen
			p:Close(true)
		end
		tween(self.Scale, Ease.Fast, { Scale = 0.94 })
		local t = tween(self.Root, Ease.Fast, { GroupTransparency = 1 })
		if t then
			t.Completed:Connect(function()
				if self._toggleToken == token and not self.Visible then
					self.Root.Visible = false
				end
			end)
		end
	end
end

function Window:Toggle()
	self:SetVisible(not self.Visible)
end

function Window:BindToggleKeybind(card, opts)
	opts = opts or {}
	local window = self
	return card:AddKeybind({
		Name = opts.Name or "Abrir / Fechar Painel",
		Default = window.ToggleKey,
		Flag = opts.Flag,
		OnChanged = function(key)
			window.ToggleKey = key or window.ToggleKey
			fire(opts.OnChanged, key)
		end,
	})
end

function Window:Notify(opts)
	Nexus:Notify(opts)
end

function Window:Destroy()
	for _, c in ipairs(self.Connections) do
		c:Disconnect()
	end
	for _, p in ipairs(self.Popups) do
		if p.Destroying then
			p.Destroying()
		end
		p.Root:Destroy()
	end
	self.Root:Destroy()
end

