function Nexus:CreateCard(parent, name)
    local card = create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),                    -- <- era -20, era 50 fixo
        BackgroundColor3 = self.Theme.Panel,
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,            -- <- deixa o card crescer
        Parent = parent,
    })
    corner(card, 8)
    stroke(card, self.Theme.Border)
    
    -- Header
    local header = create("Frame", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = self.Theme.Element,
        BorderSizePixel = 0,
        Parent = card,
    })
    corner(header, 8)
    create("Frame", {
        Size = UDim2.new(1, 0, 0, 10),
        Position = UDim2.new(0, 0, 1, -10),
        BackgroundColor3 = self.Theme.Element,
        BorderSizePixel = 0,
        Parent = header,
    })
    
    create("TextLabel", {
        Size = UDim2.new(1, -20, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = self.Theme.Text,
        TextSize = 13,
        Font = self.Theme.FontBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = header,
    })
    
    -- CONTAINER DOS ELEMENTOS (com padding próprio)
    local content = create("Frame", {
        Size = UDim2.new(1, -20, 0, 0),                  -- largura menos padding
        Position = UDim2.new(0, 10, 0, 42),              -- abaixo do header
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,            -- <- cresce com os filhos
        Parent = card,
    })
    create("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = content,
    })
    create("UIPadding", {
        PaddingBottom = UDim.new(0, 10),
        Parent = content,
    })
    
    -- ⚠️ ESSENCIAL: recalcula altura do card quando adiciona elementos
    content:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        local h = content.AbsoluteSize.Y
        card.Size = UDim2.new(1, 0, 0, 42 + h + 10)
    end)
    
    card.ContentFrame = content
    return card
end

