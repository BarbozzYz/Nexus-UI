	----------------------------------------------------------- lado direito
	local main = create("Frame", {
		Name = "Main",
		Position = UDim2.fromOffset(135, 0),
		Size = UDim2.new(1, -135, 1, 0),
		BackgroundTransparency = 1,
		Parent = root,
	})

	local topbar = create("Frame", {
		Name = "Topbar",
		Size = UDim2.new(1, 0, 0, 43),
		BackgroundColor3 = Theme.Topbar,
		BorderSizePixel = 0,
		Parent = main,
	})

	local searchFrame = create("Frame", {
		Name = "Search",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -53, 0.5, 0),
		Size = UDim2.fromOffset(180, 20),
		BackgroundColor3 = Color3.fromRGB(30, 30, 34),
		BorderSizePixel = 0,
		Parent = topbar,
	})
	corner(searchFrame, 5)
	local searchStroke = stroke(searchFrame, Theme.Outline, 1, 0)
	local searchBox = create("TextBox", {
		Size = UDim2.new(1, -16, 1, 0),
		Position = UDim2.fromOffset(8, 0),
		BackgroundTransparency = 1,
		Text = "",
		PlaceholderText = "Search Bar...",
		PlaceholderColor3 = Color3.fromRGB(118, 118, 124),
		TextColor3 = Theme.Text,
		Font = Theme.Font,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		Parent = searchFrame,
	})
	searchBox.Focused:Connect(function()
		tween(searchStroke, Ease.Fast, { Color = Theme.Accent })
	end)
	searchBox.FocusLost:Connect(function()
		tween(searchStroke, Ease.Fast, { Color = Theme.Outline })
	end)
	searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		self:_applySearch(searchBox.Text)
	end)

	-- icone de lupa desenhado com frames
	local icon = create("Frame", {
		Name = "SearchIcon",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -25, 0.5, 0),
		Size = UDim2.fromOffset(15, 15),
		BackgroundTransparency = 1,
		Parent = topbar,
	})
	local lens = create("Frame", {
		Position = UDim2.fromOffset(1, 1),
		Size = UDim2.fromOffset(10, 10),
		BackgroundTransparency = 1,
		Parent = icon,
	})
	corner(lens, 5)
	stroke(lens, Color3.fromRGB(140, 140, 146), 1.5, 0)
	create("Frame", {
		Position = UDim2.fromOffset(9, 11.25),
		Size = UDim2.fromOffset(6, 1.5),
		Rotation = 45,
		BackgroundColor3 = Color3.fromRGB(140, 140, 146),
		BorderSizePixel = 0,
		Parent = icon,
	})

	self._content = create("Frame", {
		Name = "Content",
		Position = UDim2.fromOffset(0, 43),
		Size = UDim2.new(1, 0, 1, -57),
		BackgroundColor3 = Theme.Content,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = main,
	})

	local footer = create("Frame", {
		Name = "Footer",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundColor3 = Theme.Footer,
		BorderSizePixel = 0,
		Parent = main,
	})
	label({
		Parent = footer,
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -20, 1, 0),
		Text = opts.Footer or "Nexus | Lib",
		TextColor3 = Theme.SubText,
		TextSize = 9,
	})

	makeDraggable(topbar, root)
	makeDraggable(sidebar, root)

	table.insert(self.Connections, UserInputService.InputBegan:Connect(function(input, processed)
		if processed or Nexus._listening then
			return
		end
		if input.KeyCode == self.ToggleKey then
			self:SetVisible(not self.Visible)
		end
	end))

	----------------------------------------------------------- redimensionar (canto inferior esquerdo)
	if opts.Resizable ~= false then
		local minSize = opts.MinSize or Nexus.Sizes.MinWindow
		local maxSize = opts.MaxSize or Nexus.Sizes.MaxWindow

		local grip = create("Frame", {
			Name = "Resize",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 3, 1, -3),
			Size = UDim2.fromOffset(16, 16),
			BackgroundTransparency = 1,
			ZIndex = 5,
			Parent = root,
		})
		local gripIcon = createIcon(grip, "resize", 14, Theme.SubText)
		if gripIcon then
			gripIcon.Frame.Position = UDim2.fromOffset(1, 1)
		end
		local gripHit = create("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 6,
			Parent = grip,
		})

		local topRight, resizeConn

		local function updateResize()
			local m = mousePos()
			local newW = math.clamp(topRight.X - m.X, minSize.X, maxSize.X)
			local newH = math.clamp(m.Y - topRight.Y, minSize.Y, maxSize.Y)
			root.Size = UDim2.fromOffset(newW, newH)
			root.Position = UDim2.fromOffset(topRight.X - newW / 2, topRight.Y + newH / 2)
			self.Size = Vector2.new(newW, newH)
		end

		local function stopResize()
			if resizeConn then
				resizeConn:Disconnect()
				resizeConn = nil
			end
		end

		gripHit.InputBegan:Connect(function(input)
			if isPress(input) then
				stopResize()
				local abs, sz = root.AbsolutePosition, root.AbsoluteSize
				topRight = Vector2.new(abs.X + sz.X, abs.Y)
				bringFront(root)
				resizeConn = RunService.RenderStepped:Connect(updateResize)
			end
		end)
		table.insert(self.Connections, UserInputService.InputEnded:Connect(function(input)
			if isPress(input) then
				stopResize()
			end
		end))
		if gripIcon then
			grip.MouseEnter:Connect(function()
				gripIcon.SetColor(Theme.Accent)
			end)
			grip.MouseLeave:Connect(function()
				gripIcon.SetColor(Theme.SubText)
			end)
		end
	end

	self:_setupCursor(opts.Cursor)

	-- entrada
	tween(scale, Ease.Back, { Scale = 1 })
	tween(root, Ease.Slow, { GroupTransparency = 0 })

	return self
end

function Window:_applySearch(query)
	query = string.lower(query or "")
	for _, tab in ipairs(self.Tabs) do
		for _, card in ipairs(tab.Cards) do
			local any = false
			for _, el in ipairs(card.Elements) do
				local match = query == "" or string.find(string.lower(el.Name), query, 1, true) ~= nil
				el.Frame.Visible = match
				if match then
					any = true
				end
			end
			card.Holder.Visible = query == "" or any
		end
	end
end

function Window:SelectTab(tab)
	if self.Current == tab then
		return
	end
	local prev = self.Current
	self.Current = tab

	for _, t in ipairs(self.Tabs) do
		t.Active = (t == tab)
		t._icon.SetColor(t.Active and Theme.Accent or Theme.Muted)
		tween(t._text, Ease.Med, { TextColor3 = t.Active and Theme.Accent or Theme.Muted })
	end

	if prev then
		local out = tween(prev.Page, Ease.Fast, { GroupTransparency = 1 })
		out.Completed:Connect(function()
			if not prev.Active then
				prev.Page.Visible = false
			end
		end)
	end

	tab.Page.Visible = true
	tab.Page.GroupTransparency = 1
	tab.Page.Position = UDim2.new(0, 0, 0, 10)
	tween(tab.Page, Ease.Med, { GroupTransparency = 0, Position = UDim2.new(0, 0, 0, 0) })
end

function Window:CreateCategory(name, opts)
	opts = opts or {}
	self._catCount = (self._catCount or 0) + 1
	local cat = setmetatable({
		Name = name,
		Window = self,
		Tabs = {},
		Base = self._catCount * 1000,
		Count = 0,
		Collapsible = opts.Collapsible == true,
		Collapsed = false,
	}, Category)

	local spaced = self._catCount > 1 or (self._looseCount or 0) > 0
	local wrapper = create("TextButton", {
		Name = "Category_" .. name,
		Size = UDim2.new(1, 0, 0, spaced and 30 or 20),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = cat.Base,
		Parent = self._nav,
	})
	local title = string.upper(name)
	local textSize = TextService:GetTextSize(title, 10, Theme.FontMedium, Vector2.new(1000, 20))
	label({
		Parent = wrapper,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 6, 1, -2),
		Size = UDim2.fromOffset(textSize.X + 4, 14),
		Text = title,
		TextColor3 = Color3.fromRGB(105, 105, 112),
		Font = Theme.FontMedium,
		TextSize = 10,
	})
	local reserved = cat.Collapsible and 28 or 8
	local lineStart = 6 + textSize.X + 10
	local line = create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, lineStart, 1, -9),
		Size = UDim2.new(1, -(lineStart + reserved), 0, 1),
		BackgroundColor3 = Theme.Outline,
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
		Parent = wrapper,
	})
	if cat.Collapsible then
		cat._chevron = chevron(wrapper, Color3.fromRGB(105, 105, 112))
		cat._chevron.Position = UDim2.new(1, -12, 1, -9)
		wrapper.Activated:Connect(function()
			cat:SetCollapsed(not cat.Collapsed)
		end)
		wrapper.MouseEnter:Connect(function()
			tween(line, Ease.Fast, { BackgroundTransparency = 0.2 })
		end)
		wrapper.MouseLeave:Connect(function()
			tween(line, Ease.Fast, { BackgroundTransparency = 0.55 })
		end)
	end
	cat.Header = wrapper

	table.insert(self.Categories, cat)
	if opts.Collapsed and cat.Collapsible then
		cat.Collapsed = true
		cat._chevron.Rotation = -90
	end
	return cat
end

function Category:CreateTab(name, iconArg)
	return self.Window:CreateTab(name, iconArg, self)
end

function Category:SetCollapsed(state)
	if not self.Collapsible then
		return
	end
	self.Collapsed = state and true or false
	tween(self._chevron, Ease.Med, { Rotation = self.Collapsed and -90 or 0 })
	for _, tab in ipairs(self.Tabs) do
		local w = tab.Wrapper
		if self.Collapsed then
			local t = tween(w, Ease.Med, { Size = UDim2.new(1, 0, 0, 0) })
			t.Completed:Connect(function()
				if self.Collapsed then
					w.Visible = false
				end
			end)
		else
			w.Visible = true
			tween(w, Ease.Med, { Size = UDim2.new(1, 0, 0, 26) })
		end
	end
end

function Window:CreateTab(name, iconArg, category)
