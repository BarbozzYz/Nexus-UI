function Nexus.Notify(cfg)
    -- cfg: { Title, Description, Duration, Buttons }
    -- Buttons: nil | { {Text="Yes", Callback=fn}, {Text="No", Callback=fn} }
    local title    = cfg.Title       or "Notification"
    local desc     = cfg.Description or ""
    local duration = cfg.Duration    or 4
    local buttons  = cfg.Buttons     or nil

    local h = (desc ~= "" and 68 or 44) + (buttons and 38 or 0)

    local card = Instance.new("Frame")
    card.Size = UDim2.new(1,0,0,h)
    card.BackgroundColor3 = C.Surface
    card.BorderSizePixel = 0
    card.ClipsDescendants = true
    card.ZIndex = 201
    card.Parent = notifyContainer
    Instance.new("UICorner",card).CornerRadius = UDim.new(0,7)

    -- accent bar bottom
    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0,0,0,2)
    bar.Position = UDim2.new(0,0,1,-2)
    bar.BackgroundColor3 = C.Accent
    bar.BorderSizePixel = 0
    bar.ZIndex = 202
    bar.Parent = card

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1,-12,0,22)
    titleLbl.Position = UDim2.new(0,10,0,8)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = title
    titleLbl.TextColor3 = C.Text
    titleLbl.TextSize = 13
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.ZIndex = 202
    titleLbl.Parent = card

    if desc ~= "" then
        local descLbl = Instance.new("TextLabel")
        descLbl.Size = UDim2.new(1,-12,0,18)
        descLbl.Position = UDim2.new(0,10,0,28)
        descLbl.BackgroundTransparency = 1
        descLbl.Text = desc
        descLbl.TextColor3 = C.Muted
        descLbl.TextSize = 11
        descLbl.Font = Enum.Font.Gotham
        descLbl.TextXAlignment = Enum.TextXAlignment.Left
        descLbl.ZIndex = 202
        descLbl.Parent = card
    end

    if buttons then
        local bx = 10
        for _, bdef in ipairs(buttons) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(0,70,0,24)
            btn.Position = UDim2.new(1,-(bx+70),1,-32)
            btn.BackgroundColor3 = C.Accent
            btn.BorderSizePixel = 0
            btn.Text = bdef.Text
            btn.TextColor3 = C.Text
            btn.TextSize = 12
            btn.Font = Enum.Font.GothamBold
            btn.ZIndex = 203
            btn.Parent = card
            Instance.new("UICorner",btn).CornerRadius = UDim.new(0,5)
            btn.MouseButton1Click:Connect(function()
                if bdef.Callback then bdef.Callback() end
                tween(card,0.25,{BackgroundTransparency=1}):Play()
                task.delay(0.3, function() card:Destroy() end)
            end)
            btn.MouseEnter:Connect(function()
                tween(btn,0.15,{BackgroundColor3=C.AccentHov}):Play()
            end)
            btn.MouseLeave:Connect(function()
                tween(btn,0.15,{BackgroundColor3=C.Accent}):Play()
            end)
            bx = bx + 78
        end
    end

    -- slide in
    card.Position = UDim2.new(1,10,1,0)
    tween(card,0.3,{Position=UDim2.new(0,0,1,0)},Enum.EasingStyle.Back):Play()

    -- progress bar
    tween(bar, duration, {Size=UDim2.new(1,0,0,2)}):Play()

    -- auto dismiss
    if not buttons then
        task.delay(duration, function()
            if card and card.Parent then
                tween(card,0.3,{Position=UDim2.new(1,10,1,0)}):Play()
                task.delay(0.35, function()
                    if card and card.Parent then card:Destroy() end
                end)
            end
        end)
    end
end

