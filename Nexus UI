-- ============================================================
-- UTILS
-- ============================================================
local function create(className, props, children)
    local inst = Instance.new(className)
    for k, v in pairs(props or {}) do inst[k] = v end
    for _, c in ipairs(children or {}) do c.Parent = inst end
    return inst
end

local function corner(parent, radius)
    return create("UICorner", { CornerRadius = UDim.new(0, radius or 6), Parent = parent })
end

local function stroke(parent, color, thickness)
    return create("UIStroke", {
        Color = color or Nexus.Theme.Border,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
end

local function tween(obj, props, time, style, dir)
    return TweenService:Create(obj, TweenInfo.new(
        time or 0.15,
        style or Enum.EasingStyle.Quad,
        dir or Enum.EasingDirection.Out
    ), props):Play()
end

local function getIcon(name)
    return Nexus.Icons.Filled[name] or Nexus.Icons.Filled.Dashboard
end

local function updateCanvas(sf)
    local layout = sf:FindFirstChildOfClass("UIListLayout")
    local padding = sf:FindFirstChildOfClass("UIPadding")
    if layout then
        local topPad = padding and padding.PaddingTop.Offset or 0
        local bottomPad = padding and padding.PaddingBottom.Offset or 0
        sf.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + topPad + bottomPad)
    end
end

