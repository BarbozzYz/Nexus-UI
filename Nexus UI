function Nexus:AddTab(name, iconName)
    local tab = {
        Name = name,
        Icon = iconName or "Dashboard",
        Button = nil,
        ContentFrame = nil,
    }
    
    local btn = create("TextButton", {
        Size = UDim2.new(1, -20, 0, 36),
        BackgroundColor3 = self.Theme.Sidebar,
        Text = "",
        BorderSizePixel = 0,
        Parent = self.Sidebar,
    })
    corner(btn, 6)
    
    create("ImageLabel", {
        Size = UDim2.new(0, 16, 0, 16),
        Position = UDim2.new(0, 10, 0.5, -8),
        BackgroundTransparency = 1,
        Image = getIcon(tab.Icon),
        ImageColor3 = self.Theme.Accent,
        Parent = btn,
    })
    create("TextLabel", {
        Size = UDim2.new(1, -40, 1, 0),
        Position = UDim2.new(0, 34, 0, 0),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = self.Theme.Text,
        TextSize = 13,
        Font = self.Theme.Font,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = btn,
    })
    
    local content = create("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = self.Theme.Border,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        Visible = false,
        Parent = self.Content,
    })
    
    local layout = create("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = content,
    })
    create("UIPadding", {
        PaddingTop = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 10),
        PaddingBottom = UDim.new(0, 10),
        Parent = content,
    })
    
    content.ChildAdded:Connect(function(child)
        task.wait()
        if child:IsA("GuiObject") and not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
            updateCanvas(content)
        end
    end)
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        updateCanvas(content)
    end)
    
    tab.Button = btn
    tab.ContentFrame = content
    table.insert(self.Tabs, tab)
    
    btn.MouseButton1Click:Connect(function() self:SelectTab(tab) end)
    btn.MouseEnter:Connect(function()
        if self.SelectedTab ~= tab then tween(btn, { BackgroundColor3 = self.Theme.Element }, 0.1) end
    end)
    btn.MouseLeave:Connect(function()
        if self.SelectedTab ~= tab then tween(btn, { BackgroundColor3 = self.Theme.Sidebar }, 0.1) end
    end)
    
    return tab
end

function Nexus:SelectTab(tab)
    for _, t in ipairs(self.Tabs) do
        t.ContentFrame.Visible = false
        tween(t.Button, { BackgroundColor3 = self.Theme.Sidebar }, 0.1)
    end
    tab.ContentFrame.Visible = true
    tween(tab.Button, { BackgroundColor3 = self.Theme.Accent }, 0.1)
    self.SelectedTab = tab
end

