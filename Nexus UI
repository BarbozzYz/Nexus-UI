------------------------------------------------------------------ color picker (janela propria)

function Window:_getColorPicker()
	if self._cp then
		return self._cp
	end

	local R = 115
	local cp = { H = 0, S = 0, V = 1, Color = Color3.new(1, 1, 1), Target = nil }
	local popup = self:_createPopup({ Title = "Color Picker", Size = Vector2.new(336, 363), Slot = 0 })
	local body = popup.Body
	cp.Popup = popup

	local holder = create("Frame", {
		Name = "WheelHolder",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 32),
		Size = UDim2.fromOffset(R * 2, R * 2),
		BackgroundTransparency = 1,
		Parent = body,
	})
	local wheel = create("CanvasGroup", {
		Name = "Wheel",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = holder,
	})
	corner(wheel, R)

	-- roda feita com "raios": cada raio cobre um diametro, so a metade direita e visivel
	local white = Color3.new(1, 1, 1)
	local step = 2
	for i = 0, (360 / step) - 1 do
		local a = i * step
		local spoke = create("Frame", {
			Name = "Spoke",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(R * 2, 7),
			Rotation = a,
			BackgroundColor3 = white,
			BorderSizePixel = 0,
			Parent = wheel,
		})
		create("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, white),
				ColorSequenceKeypoint.new(0.5, white),
				ColorSequenceKeypoint.new(1, Color3.fromHSV(((a + 90) % 360) / 360, 1, 1)),
			}),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.499, 1),
				NumberSequenceKeypoint.new(0.5, 0),
				NumberSequenceKeypoint.new(1, 0),
			}),
			Parent = spoke,
		})
	end

	local cursor = create("Frame", {
		Name = "Cursor",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(15, 15),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = holder,
	})
	local ring = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(9, 9),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = cursor,
	})
	corner(ring, 5)
	stroke(ring, Color3.new(0, 0, 0), 1, 0)
	create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = cursor,
	})
	create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 1, 1, 0),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = cursor,
	})

	local function makeInput(x, w, placeholder)
		local box = create("TextBox", {
			Position = UDim2.fromOffset(x, 284),
			Size = UDim2.fromOffset(w, 30),
			BackgroundColor3 = Theme.Input,
			BorderSizePixel = 0,
			Text = "",
			PlaceholderText = placeholder,
			PlaceholderColor3 = Color3.fromRGB(100, 100, 108),
			TextColor3 = Color3.fromRGB(215, 215, 215),
			Font = Theme.Font,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			ClearTextOnFocus = false,
			Parent = body,
		})
		corner(box, 4)
		create("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 8), Parent = box })
		local s = stroke(box, Theme.Accent, 1, 1)
		box.Focused:Connect(function()
			tween(s, Ease.Fast, { Transparency = 0.2 })
		end)
		box.FocusLost:Connect(function()
			tween(s, Ease.Fast, { Transparency = 1 })
		end)
		return box
	end
	local hexBox = makeInput(29, 130, "Hex...")
	local rgbBox = makeInput(174, 131, "R, G, B")

	local function refresh(animate)
		local c = cp.Color
		local angle = math.rad(cp.H * 360 - 90)
		local pos = UDim2.new(0.5, math.cos(angle) * R * cp.S, 0.5, math.sin(angle) * R * cp.S)
		if animate then
			tween(cursor, Ease.Fast, { Position = pos })
		else
			cursor.Position = pos
		end
		hexBox.Text = "#" .. string.upper(c:ToHex())
		rgbBox.Text = string.format("%d, %d, %d", math.round(c.R * 255), math.round(c.G * 255), math.round(c.B * 255))
	end

	local function commit(color, animate)
		cp.Color = color
		cp.H, cp.S, cp.V = color:ToHSV()
		refresh(animate)
		if cp.Target then
			cp.Target:Set(color)
		end
	end

	-- chamado pelo elemento quando o valor muda de fora
	function cp:Sync(color)
		if color == cp.Color then
			return
		end
		cp.Color = color
		cp.H, cp.S, cp.V = color:ToHSV()
		refresh(true)
	end

	local dragging = false
	local function fromMouse()
		local m = UserInputService:GetMouseLocation()
		local center = holder.AbsolutePosition + holder.AbsoluteSize / 2
		local radius = holder.AbsoluteSize.X / 2
		local d = m - center
		local dist = math.min(d.Magnitude, radius)
		local deg = math.deg(math.atan2(d.Y, d.X))
		cp.H = ((deg + 90) % 360) / 360
		cp.S = dist / radius
		cp.Color = Color3.fromHSV(cp.H, cp.S, cp.V)
		refresh(false)
		if cp.Target then
			cp.Target:Set(cp.Color)
		end
	end

	holder.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fromMouse()
		end
	end)
	table.insert(self.Connections, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			fromMouse()
		end
	end))
	table.insert(self.Connections, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))

	hexBox.FocusLost:Connect(function()
		local txt = string.gsub(hexBox.Text, "[#%s]", "")
		if #txt == 3 then
			txt = string.gsub(txt, "(%x)", "%1%1")
		end
		if #txt == 6 and string.match(txt, "^%x+$") then
			local ok, color = pcall(Color3.fromHex, txt)
			if ok then
				commit(color, true)
				return
			end
		end
		refresh(false)
	end)

	rgbBox.FocusLost:Connect(function()
		local nums = {}
		for n in string.gmatch(rgbBox.Text, "%d+") do
			nums[#nums + 1] = math.clamp(tonumber(n), 0, 255)
		end
		if #nums >= 3 then
			commit(Color3.fromRGB(nums[1], nums[2], nums[3]), true)
			return
		end
		refresh(false)
	end)

	popup.OnClose = function()
		cp.Target = nil
	end
	cp.Refresh = refresh

	self._cp = cp
	return cp
end

function Window:_toggleColorPicker(target)
	local cp = self:_getColorPicker()
	if cp.Popup.IsOpen and cp.Target == target then
		cp.Popup:Close()
		return
	end
	cp.Target = nil
	cp:Sync(target.Value)
	cp.Refresh(false)
	cp.Target = target
	if cp.Popup.IsOpen then
		return
	end
	cp.Popup:Open(self:_sidePosition(cp.Popup))
end

------------------------------------------------------------------ preview (Window Part Preview)

function Window:CreatePreview(opts)
	opts = opts or {}
	local popup = self:_createPopup({
		Title = opts.Title or "Window Part Preview",
		Size = opts.Size or Vector2.new(335, 363),
		Slot = 1,
	})
	local viewport = create("ViewportFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(19, 19, 19),
		BorderSizePixel = 0,
		Parent = popup.Body,
	})
	local camera = create("Camera", { FieldOfView = 50, Parent = viewport })
	viewport.CurrentCamera = camera

	local preview = { Popup = popup }
	local subject, center, distance
	local angle = 0
	local conn

	function preview:SetModel(inst)
		if subject then
			subject:Destroy()
			subject = nil
		end
		if not inst then
			return
		end
		subject = inst:Clone()
		subject.Parent = viewport
		local cf, size
		if subject:IsA("Model") then
			cf, size = subject:GetBoundingBox()
		else
			cf, size = subject.CFrame, subject.Size
		end
		center = cf.Position
		distance = (size.Magnitude / 2) / math.tan(math.rad(camera.FieldOfView / 2)) * 1.15
	end

	popup.OnOpen = function()
		if conn then
			conn:Disconnect()
		end
		conn = RunService.RenderStepped:Connect(function(dt)
			if not subject then
				return
			end
			angle = angle + dt * 0.9
			local pos = center + Vector3.new(math.sin(angle) * distance, distance * 0.3, math.cos(angle) * distance)
			camera.CFrame = CFrame.lookAt(pos, center)
		end)
	end
	local function stop()
		if conn then
			conn:Disconnect()
			conn = nil
		end
	end
	popup.OnHide = stop
	popup.Destroying = stop

	function preview:Open()
		popup:Open(self.Window and self.Window:_sidePosition(popup))
	end
	preview.Window = self
	function preview:Close()
		popup:Close()
	end
	function preview:Toggle()
		if popup.IsOpen then
			popup:Close()
		else
			popup:Open(self.Window:_sidePosition(popup))
		end
	end

	return preview
end

