        BackgroundColor3 = self.Theme.Panel,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 999990,
        Active = true,
        Draggable = true,
        Parent = self.Gui,
    })
    corner(frame, 8)
    stroke(frame, self.Theme.Accent, 1)
    
    local header = create("Frame", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundColor3 = self.Theme.Accent,
        BorderSizePixel = 0,
        ZIndex = 999991,
        Parent = frame,
    })
    corner(header, 8)
    create("Frame", {
        Size = UDim2.new(1, 0, 0, 10),
        Position = UDim2.new(0, 0, 1, -10),
        BackgroundColor3 = self.Theme.Accent,
        BorderSizePixel = 0,
        ZIndex = 999991,
        Parent = header,
    })
    
    create("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "Color Picker",
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 14,
        Font = self.Theme.FontBold,
        ZIndex = 999992,
        Parent = header,
    })
    
    create("TextButton", {
        Size = UDim2.new(0, 30, 0, 30),
        Position = UDim2.new(1, -30, 0, 0),
        BackgroundTransparency = 1,
        Text = "×",
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 20,
        Font = self.Theme.FontBold,
        ZIndex = 999992,
        Parent = header,
    }).MouseButton1Click:Connect(function() frame.Visible = false end)
    
    local wheel = create("Frame", {
        Size = UDim2.new(0, 160, 0, 160),
        Position = UDim2.new(0.5, -80, 0, 45),
        BackgroundColor3 = Color3.new(0, 0, 0),
        BorderSizePixel = 0,
        ZIndex = 999991,
        Parent = frame,
    })
    corner(wheel, 80)
    
    local hueImg = create("ImageLabel", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Image = "rbxassetid://10251045145",
        ZIndex = 999991,
        Parent = wheel,
    })
    corner(hueImg, 80)
    
    local satOverlay = create("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        ZIndex = 999992,
        Parent = wheel,
    })
    corner(satOverlay, 80)
    
    local selector = create("Frame", {
        Size = UDim2.new(0, 12, 0, 12),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        ZIndex = 999993,
        Parent = wheel,
    })
    corner(selector, 6)
    stroke(selector, Color3.new(1, 1, 1), 2)
    
    local hexBox = create("TextBox", {
        Size = UDim2.new(0, 95, 0, 30),
        Position = UDim2.new(0, 15, 0, 215),
        BackgroundColor3 = self.Theme.Element,
        Text = "",
        PlaceholderText = "Hex...",
        PlaceholderColor3 = self.Theme.SubText,
        TextColor3 = self.Theme.Text,
        TextSize = 13,
        Font = self.Theme.Font,
        BorderSizePixel = 0,
        ZIndex = 999991,
        Parent = frame,
    })
    corner(hexBox, 4)
    
    local rgbBox = create("TextBox", {
        Size = UDim2.new(0, 95, 0, 30),
        Position = UDim2.new(1, -110, 0, 215),
        BackgroundColor3 = self.Theme.Element,
        Text = "",
        PlaceholderText = "R, G, B",
        PlaceholderColor3 = self.Theme.SubText,
        TextColor3 = self.Theme.Text,
        TextSize = 13,
        Font = self.Theme.Font,
        BorderSizePixel = 0,
        ZIndex = 999991,
        Parent = frame,
    })
    corner(rgbBox, 4)
    
    local function refreshText()
        hexBox.Text = string.format("%02X%02X%02X",
            math.floor(color.R * 255), math.floor(color.G * 255), math.floor(color.B * 255))
        rgbBox.Text = string.format("%d, %d, %d",
            math.floor(color.R * 255), math.floor(color.G * 255), math.floor(color.B * 255))
    end
    
    local function fromWheel(px, py)
        local relX = math.clamp((px - wheel.AbsolutePosition.X) / wheel.AbsoluteSize.X, 0, 1)
        local relY = math.clamp((py - wheel.AbsolutePosition.Y) / wheel.AbsoluteSize.Y, 0, 1)
        sat = relX
        val = 1 - relY
        color = Color3.fromHSV(hue, sat, val)
        selector.Position = UDim2.new(sat, 0, 1 - val, 0)
        selector.BackgroundColor3 = color
        refreshText()
        callback(color)
    end
    
    local dragging = false
    wheel.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            fromWheel(input.Position.X, input.Position.Y)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            fromWheel(input.Position.X, input.Position.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    
    selector.BackgroundColor3 = color
    selector.Position = UDim2.new(sat, 0, 1 - val, 0)
    satOverlay.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
    refreshText()
    
    hexBox.FocusLost:Connect(function()
        local hex = hexBox.Text:gsub("#", "")
        if #hex == 6 then
            local r = tonumber(hex:sub(1, 2), 16)
            local g = tonumber(hex:sub(3, 4), 16)
            local b = tonumber(hex:sub(5, 6), 16)
            if r and g and b then
                color = Color3.fromRGB(r, g, b)
                hue, sat, val = Color3.toHSV(color)
                selector.BackgroundColor3 = color
                selector.Position = UDim2.new(sat, 0, 1 - val, 0)
                callback(color)
            end
        end
    end)
    
    rgbBox.FocusLost:Connect(function()
        local parts = string.split(rgbBox.Text, ",")
        if #parts >= 3 then
            local r, g, b = tonumber(parts[1]), tonumber(parts[2]), tonumber(parts[3])
            if r and g and b then
                color = Color3.fromRGB(r, g, b)
                hue, sat, val = Color3.toHSV(color)
                selector.BackgroundColor3 = color
                selector.Position = UDim2.new(sat, 0, 1 - val, 0)
                callback(color)
            end
        end
    end)
    
    return frame, function()
        frame.Visible = not frame.Visible
    end
end

