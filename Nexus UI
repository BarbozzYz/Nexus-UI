-- ligado automaticamente: aparece enquanto a janela esta visivel, some quando ela fecha

function Window:_setupCursor(opts)
	opts = opts or {}
	if opts.Enabled == false then
		return
	end
	local window = self
	local layer = create("Frame", {
		Name = "Cursor",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 90,
		Parent = self.Gui,
	})

	-- "bolinha atras": alguns aneis semi-transparentes concentricos, sem precisar de imagem
	local glow = create("Frame", {
		Name = "Glow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 90,
		Parent = layer,
	})
	for _, ring in ipairs({ { 44, 0.86 }, { 32, 0.74 }, { 22, 0.55 }, { 13, 0.3 } }) do
		local c = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(ring[1], ring[1]),
			BackgroundColor3 = Theme.Accent,
			BackgroundTransparency = ring[2],
			BorderSizePixel = 0,
			Parent = glow,
		})
		corner(c, ring[1] / 2)
	end

	-- ponteiro: um circulo pequeno na frente do brilho (troque por um icone seu com
	-- window.Cursor.Tip.Icon.Image = "rbxassetid://..." se quiser um formato de seta)
	local tip = create("Frame", {
		Name = "Tip",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(9, 9),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		ZIndex = 91,
		Parent = layer,
	})
	corner(tip, 5)
	stroke(tip, Color3.new(1, 1, 1), 1.5, 0.1)
	local icon = create("ImageLabel", {
		Name = "Icon",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Image = "",
		Visible = false,
		Parent = tip,
	})

	local function spawnClickEffect(pos)
		local ripple = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(pos.X, pos.Y),
			Size = UDim2.fromOffset(8, 8),
			BackgroundColor3 = Theme.Accent,
			BackgroundTransparency = 0.15,
			BorderSizePixel = 0,
			ZIndex = 89,
			Parent = layer,
		})
		corner(ripple, 20)
		local ringStroke = stroke(ripple, Theme.Accent, 1.5, 0.15)
		local t = tween(ripple, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(36, 36),
			BackgroundTransparency = 1,
		})
		tween(ringStroke, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 1 })
		t.Completed:Connect(function()
			ripple:Destroy()
		end)
	end

	local renderConn, clickConn

	local function activate()
		layer.Visible = true
		UserInputService.MouseIconEnabled = false
		local m = mousePos()
		glow.Position = UDim2.fromOffset(m.X, m.Y)
		tip.Position = UDim2.fromOffset(m.X, m.Y)
		if renderConn then
			renderConn:Disconnect()
		end
		renderConn = RunService.RenderStepped:Connect(function()
			local p = mousePos()
			glow.Position = UDim2.fromOffset(p.X, p.Y)
			tip.Position = UDim2.fromOffset(p.X, p.Y)
		end)
		if clickConn then
			clickConn:Disconnect()
		end
		clickConn = UserInputService.InputBegan:Connect(function(input, processed)
			if isPress(input) then
				spawnClickEffect(mousePos())
			end
		end)
	end

	local function deactivate()
		layer.Visible = false
		UserInputService.MouseIconEnabled = true
		if renderConn then
			renderConn:Disconnect()
			renderConn = nil
		end
		if clickConn then
			clickConn:Disconnect()
			clickConn = nil
		end
	end

	self.Cursor = {
		Glow = glow,
		Tip = tip,
		Icon = icon,
		SetIcon = function(_, assetId)
			icon.Image = assetId and ("rbxassetid://" .. tostring(assetId)) or ""
			icon.Visible = icon.Image ~= ""
			tip.BackgroundTransparency = icon.Visible and 1 or 0
		end,
	}
	self._cursorActivate, self._cursorDeactivate = activate, deactivate
	if self.Visible then
		activate()
	end
end

