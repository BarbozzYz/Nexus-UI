local function tween(obj, t, props, style, dir)
    style = style or Enum.EasingStyle.Quad
    dir   = dir   or Enum.EasingDirection.Out
    return TweenService:Create(obj, TweenInfo.new(t, style, dir), props)
end

local function elasticOut(t)
    if t == 0 then return 0 end
    if t == 1 then return 1 end
    local p, s = 0.4, 0.1
    return math.pow(2,-10*t)*math.sin((t-s)*(2*math.pi)/p)*-1+1
end

local function ripple(parent, x, y)
    local r = Instance.new("Frame")
    r.Size = UDim2.new(0,0,0,0)
    r.Position = UDim2.new(0, x - parent.AbsolutePosition.X,
                           0, y - parent.AbsolutePosition.Y)
    r.AnchorPoint = Vector2.new(0.5,0.5)
    r.BackgroundColor3 = Color3.fromRGB(150,90,255)
    r.BackgroundTransparency = 0.6
    r.BorderSizePixel = 0
    r.ZIndex = 20
    r.Parent = parent
    Instance.new("UICorner",r).CornerRadius = UDim.new(1,0)
    local sz = math.max(parent.AbsoluteSize.X, parent.AbsoluteSize.Y)*2.5
    tween(r,0.45,{Size=UDim2.new(0,sz,0,sz),
        BackgroundTransparency=1},Enum.EasingStyle.Quad):Play()
    game:GetService("Debris"):AddItem(r,0.5)
end

