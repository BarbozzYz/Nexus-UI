        BackgroundColor3 = default or self.Theme.Accent,
        Text = "",
        BorderSizePixel = 0,
        Parent = frame,
    })
    corner(colorBtn, 12)
    
    colorBtn.MouseButton1Click:Connect(function()
        if not self._sharedPicker then
            self._sharedPicker = self:CreateColorPicker(default, function(c)
