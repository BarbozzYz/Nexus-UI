		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(38, 18),
		BackgroundColor3 = Theme.ToggleOff,
		BorderSizePixel = 0,
		Parent = row,
	})
	corner(track, 9)
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = track,
	})
	corner(knob, 6)

	local knobInfo = TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	local function render(v, instant)
		apply(track, Ease.Med, { BackgroundColor3 = v and Theme.ToggleOn or Theme.ToggleOff }, instant)
		apply(knob, knobInfo, { Position = UDim2.new(0, v and 23 or 3, 0.5, 0) }, instant)
	end

	function obj:Set(v, silent)
		v = v and true or false
		obj.Value = v
		render(v, false)
		self.Card:_flag(opts.Flag, v)
		if not silent then
			fire(opts.Callback, v)
		end
	end
	obj.Card = self
	function obj.Get()
		return obj.Value
	end

	row.Activated:Connect(function()
		obj:Set(not obj.Value)
	end)
	row.MouseEnter:Connect(function()
		tween(knob, Ease.Fast, { Size = UDim2.fromOffset(14, 12) })
	end)
	row.MouseLeave:Connect(function()
		tween(knob, Ease.Fast, { Size = UDim2.fromOffset(12, 12) })
	end)

	obj.Value = opts.Default and true or false
	render(obj.Value, true)
	self:_flag(opts.Flag, obj.Value)
	return self:_register(name, row, obj)
end

