                    -- auto-resize
                    secInnerLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                        sec.Size=UDim2.new(1,0,0,
                            secInnerLayout.AbsoluteContentSize.Y+16)
                    end)

                    -- header da section
                    local hRow=new("Frame",{
                        Size=UDim2.new(1,0,0,18),
                        BackgroundTransparency=1,
                        ZIndex=15,
                        LayoutOrder=0,
                    },sec)
                    local hDot=new("Frame",{
                        Size=UDim2.new(0,10,0,10),
                        Position=UDim2.new(0,0,0.5,-5),
                        BackgroundColor3=ACCENT2,
                        BorderSizePixel=0,
                        ZIndex=16,
                    },hRow)
                    corner(5,hDot)
                    new("TextLabel",{
                        Size=UDim2.new(1,-16,1,0),
                        Position=UDim2.new(0,16,0,0),
                        BackgroundTransparency=1,
                        Text=sname,
                        TextColor3=TEXT,
                        TextSize=12,Font=Enum.Font.GothamBold,
