-- Nexus Lib | arquivo unico para executor (lib + exemplo). Cole tudo e execute.

do -- fecha uma execucao anterior
	local function cleanup(parent)
		local ok, old = pcall(function()
			return parent and parent:FindFirstChild("NexusLib")
		end)
		if ok and old then
			old:Destroy()
		end
	end
	pcall(function()
		cleanup(gethui and gethui())
	end)
	cleanup(game:GetService("CoreGui"))
	cleanup(game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui"))
end

