		AutoButtonColor = false,
		Parent = row,
	})
	local fill = create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = btn,
	})
	corner(fill, 6)
	local outline = stroke(fill, Theme.AccentSoft, 1, 0.35)
	local lbl = label({
		Name = "Text",
		Parent = btn,
		Size = UDim2.fromScale(1, 1),
		Text = name,
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Theme.FontMedium,
		TextSize = 12,
		ZIndex = 2,
	})
	local press = create("UIScale", { Scale = 1, Parent = btn })

	btn.MouseEnter:Connect(function()
		tween(outline, Ease.Fast, { Transparency = 0 })
	end)
	btn.MouseLeave:Connect(function()
		tween(outline, Ease.Fast, { Transparency = 0.35 })
		tween(press, Ease.Fast, { Scale = 1 })
	end)
	btn.MouseButton1Down:Connect(function()
		tween(press, Ease.Fast, { Scale = 0.97 })
	end)
	btn.MouseButton1Up:Connect(function()
		tween(press, Ease.Back, { Scale = 1 })
	end)
	btn.Activated:Connect(function()
		fire(opts.Callback)
	end)

	function obj.SetText(_, text)
		lbl.Text = text
	end
	return self:_register(name, row, obj)
end

---------------------------------------------------------------- slider

function Card:AddSlider(opts)
	self:_beginElement()
	opts = opts or {}
	local name = opts.Name or "Slider"
	local min = opts.Min or 0
	local max = opts.Max or 100
	local step = opts.Step or 1
	local suffix = opts.Suffix or ""

	local function clampValue(v)
		v = math.clamp(v, min, max)
		if step and step > 0 then
			v = min + math.floor((v - min) / step + 0.5) * step
		end
		return v
	end

	local obj = { Value = clampValue(opts.Default or min) }

	local row = create("Frame", {
		Name = name,
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundTransparency = 1,
		LayoutOrder = self:_order(),
		Parent = self.Frame,
	})
	label({ Parent = row, Size = UDim2.new(1, -60, 0, 16), Text = name, TextSize = 12 })
	local valueLabel = label({
		Parent = row,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(55, 16),
		Text = tostring(obj.Value) .. suffix,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextSize = 12,
	})

	local BAR_H = 8
	local barHolder = create("Frame", {
		Name = "Bar",
		Position = UDim2.fromOffset(0, 23),
		Size = UDim2.new(1, 0, 0, BAR_H),
		BackgroundColor3 = Theme.ToggleOff,
		BorderSizePixel = 0,
		Parent = row,
	})
	corner(barHolder, BAR_H / 2)
	local fill = create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = barHolder,
	})
	corner(fill, BAR_H / 2)

	local bubble = create("Frame", {
		Name = "Bubble",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0, 0, 0, -6),
		Size = UDim2.fromOffset(0, 20),
		BackgroundColor3 = Theme.Item,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 5,
		Parent = barHolder,
	})
	corner(bubble, 5)
	stroke(bubble, Theme.Accent, 1, 0.3)
	local bubbleLabel = label({
		Parent = bubble,
		Size = UDim2.fromScale(1, 1),
		Text = "",
		TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 12,
		ZIndex = 5,
	})

	local hit = create("TextButton", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = barHolder,
	})

	local function render(v, instant)
		local pct = (max > min) and (v - min) / (max - min) or 0
		local text = tostring(v) .. suffix
		apply(fill, Ease.Fast, { Size = UDim2.fromScale(pct, 1) }, instant)
		valueLabel.Text = text
		local w = TextService:GetTextSize(text, 12, Theme.Font, Vector2.new(200, 20)).X + 16
		bubble.Size = UDim2.fromOffset(w, 20)
		bubble.Position = UDim2.new(pct, 0, 0, -6)
		bubbleLabel.Text = text
	end

	function obj:Set(v, silent)
		v = clampValue(v)
		obj.Value = v
		render(v, false)
		self.Card:_flag(opts.Flag, v)
		if not silent then
			fire(opts.Callback, v)
		end
	end
	obj.Card = self
	function obj.Get()
		return obj.Value
	end

	local dragConn, lastMouse

	local function update()
		local m = mousePos()
		if m == lastMouse then
			return
		end
		lastMouse = m
		local p, sz = barHolder.AbsolutePosition, barHolder.AbsoluteSize
		local pct = math.clamp((m.X - p.X) / sz.X, 0, 1)
		obj:Set(min + pct * (max - min))
	end

	local function stopDrag()
		lastMouse = nil
		if dragConn then
			dragConn:Disconnect()
			dragConn = nil
		end
		tween(bubble, Ease.Fast, { BackgroundTransparency = 1 })
		tween(bubbleLabel, Ease.Fast, { TextTransparency = 1 })
	end

	hit.InputBegan:Connect(function(input)
		if isPress(input) then
			stopDrag()
			bubble.Visible = true
			tween(bubble, Ease.Fast, { BackgroundTransparency = 0 })
			tween(bubbleLabel, Ease.Fast, { TextTransparency = 0 })
			update()
			dragConn = RunService.RenderStepped:Connect(update)
		end
	end)
	table.insert(self.Window.Connections, UserInputService.InputEnded:Connect(function(input)
		if isPress(input) and dragConn then
			stopDrag()
		end
	end))

	render(obj.Value, true)
	self:_flag(opts.Flag, obj.Value)
	return self:_register(name, row, obj)
end

---------------------------------------------------------------- dropdown

function Card:AddDropdown(opts)
	self:_beginElement()
	opts = opts or {}
	local name = opts.Name or "Dropdown"
	local options = opts.Options or {}
	local BTN_H, ITEM_H = 30, 30
	local width = opts.Width or 140
	local maxVisible = opts.MaxVisible or 5
	local obj = { Value = nil }
	local open = false

	local holder = create("Frame", {
		Name = name,
		Size = UDim2.new(1, 0, 0, BTN_H),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		LayoutOrder = self:_order(),
		Parent = self.Frame,
	})
	local button = create("TextButton", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.fromOffset(width, BTN_H),
		BackgroundColor3 = Theme.Item,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Parent = holder,
	})
	corner(button, 6)
	stroke(button, Color3.new(1, 1, 1), 1, Nexus.Style.DropdownBorderTransparency)
	local text = label({
		Parent = button,
		Size = UDim2.new(1, -26, 1, 0),
		Text = name,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local arrow = chevron(button, Theme.Text)
	arrow.Position = UDim2.new(1, -16, 0.5, 0)

	local list = create("ScrollingFrame", {
		Name = "List",
		Position = UDim2.fromOffset(0, BTN_H),
		Size = UDim2.fromOffset(width, 0),
		BackgroundColor3 = Theme.List,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = Theme.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false,
		Parent = holder,
	})

	local listCorner = corner(list, 6)
	local listStroke = stroke(list, Theme.Outline, 1, 0.3)

	local items = {}

	local function refreshText()
		local display = obj.Value
		if display == nil then
			display = name
		end
		text.Text = tostring(display)
	end

	function obj:Set(v, silent)
		obj.Value = v
		refreshText()
		self.Card:_flag(opts.Flag, v)
		if not silent then
			fire(opts.Callback, v)
		end
	end
	obj.Card = self
	function obj.Get()
		return obj.Value
	end

	function obj:SetOptions(newOptions)
		options = newOptions or {}
		for _, item in ipairs(items) do
			item:Destroy()
		end
		items = {}
		for i, opt in ipairs(options) do
			local item = create("TextButton", {
				Name = tostring(opt),
				Size = UDim2.new(1, 0, 0, ITEM_H),
				Position = UDim2.fromOffset(0, (i - 1) * ITEM_H),
				BackgroundColor3 = Theme.List,
				BackgroundTransparency = 1,
				Text = tostring(opt),
				TextColor3 = Theme.Text,
				Font = Theme.Font,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Center,
				AutoButtonColor = false,
				Parent = list,
			})
			item.MouseEnter:Connect(function()
				tween(item, Ease.Fast, { BackgroundTransparency = 0.7 })
			end)
			item.MouseLeave:Connect(function()
				tween(item, Ease.Fast, { BackgroundTransparency = 1 })
			end)
			item.Activated:Connect(function()
				obj:Set(opt)
				open = false
				list.Visible = false
				tween(holder, Ease.Fast, { Size = UDim2.new(1, 0, 0, BTN_H) })
				tween(arrow, Ease.Fast, { Rotation = 0 })
			end)
			table.insert(items, item)
		end
		list.CanvasSize = UDim2.fromOffset(0, #options * ITEM_H)
	end
	obj:SetOptions(options)

	button.Activated:Connect(function()
		open = not open
		if open then
			list.Visible = true
			local visible = math.min(#options, maxVisible)
			local h = visible * ITEM_H
			tween(holder, Ease.Fast, { Size = UDim2.new(1, 0, 0, BTN_H + h) })
			tween(list, Ease.Fast, { Size = UDim2.fromOffset(width, h) })
			tween(arrow, Ease.Fast, { Rotation = 180 })
		else
			tween(holder, Ease.Fast, { Size = UDim2.new(1, 0, 0, BTN_H) })
			tween(list, Ease.Fast, { Size = UDim2.fromOffset(width, 0) })
			tween(arrow, Ease.Fast, { Rotation = 0 })
			task.delay(0.15, function()
				if not open then
					list.Visible = false
				end
			end)
		end
	end)

	if opts.Default then
		obj:Set(opts.Default, true)
	end
	refreshText()
	self:_flag(opts.Flag, obj.Value)
	return self:_register(name, holder, obj)
end

---------------------------------------------------------------- keybind

function Card:AddKeybind(opts)
	self:_beginElement()
	opts = opts or {}
	local name = opts.Name or "Keybind"
	local obj = { Value = opts.Default }

	local row = create("Frame", {
		Name = name,
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundTransparency = 1,
		LayoutOrder = self:_order(),
		Parent = self.Frame,
	})
	label({ Parent = row, Size = UDim2.new(1, -80, 1, 0), Text = name, TextSize = 12 })

	local btn = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(70, 20),
		BackgroundColor3 = Theme.KeybindBg,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Parent = row,
	})
	corner(btn, 5)
	stroke(btn, Theme.Outline, 1, 0.4)
	local keyLabel = label({
		Parent = btn,
		Size = UDim2.fromScale(1, 1),
		Text = opts.Default and (opts.Default.Name or tostring(opts.Default)) or "...",
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 11,
	})

	local listening = false

	local function stopListening()
		listening = false
		Nexus._listening = false
		tween(btn, Ease.Fast, { BackgroundColor3 = Theme.KeybindBg })
		if obj.Value then
			keyLabel.Text = obj.Value.Name or tostring(obj.Value)
		else
			keyLabel.Text = "..."
		end
	end

	local function startListening()
		listening = true
		Nexus._listening = true
		keyLabel.Text = "..."
		tween(btn, Ease.Fast, { BackgroundColor3 = Theme.AccentDark })
	end

	btn.Activated:Connect(function()
		if listening then
			stopListening()
		else
			startListening()
		end
	end)

	table.insert(self.Window.Connections, UserInputService.InputBegan:Connect(function(input, gp)
		if not listening then
			return
		end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			local key = input.KeyCode
			if key == Enum.KeyCode.Escape then
				stopListening()
				return
			end
			local display = KeyNames[key.Name] or key.Name
			keyLabel.Text = display
			obj.Value = key
			self.Card:_flag(opts.Flag, key)
			fire(opts.Callback, key)
			fire(opts.OnChanged, key)
			stopListening()
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 then
			local key = input.UserInputType
			keyLabel.Text = "Mouse"
			obj.Value = key
			self.Card:_flag(opts.Flag, key)
			fire(opts.Callback, key)
			fire(opts.OnChanged, key)
			stopListening()
		end
	end))

	function obj:Set(newKey, silent)
		obj.Value = newKey
		keyLabel.Text = (newKey and (newKey.Name or tostring(newKey))) or "..."
		self.Card:_flag(opts.Flag, newKey)
		if not silent then
			fire(opts.OnChanged, newKey)
		end
	end
	obj.Card = self
	obj.Listening = function()
		return listening
	end
	obj.StopListening = stopListening

	self:_flag(opts.Flag, obj.Value)
	return self:_register(name, row, obj)
end

