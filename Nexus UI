function Nexus:Notify(cfg)
    local title   = cfg.Title       or "Notification"
    local desc    = cfg.Description or ""
    local dur     = cfg.Duration    or 4
    local buttons = cfg.Buttons

    local hasDesc = desc ~= ""
    local hasBtns = buttons ~= nil and #buttons > 0
    local h = 14 + 20 + (hasDesc and 18 or 0) + (hasBtns and 36 or 0) + 10

    local card = new("Frame",{
        Size=UDim2.new(1,0,0,h),
        BackgroundColor3=SURFACE,
        BorderSizePixel=0,
        ClipsDescendants=true,
        ZIndex=501,
        Position=UDim2.new(1,20,0,0),
    },notifyHolder)
    corner(7,card)

    -- accent bottom bar
    local bar = new("Frame",{
        Size=UDim2.new(0,0,0,2),
        Position=UDim2.new(0,0,1,-2),
        BackgroundColor3=ACCENT2,
        BorderSizePixel=0,
        ZIndex=502,
    },card)

    new("TextLabel",{
        Size=UDim2.new(1,-10,0,20),
        Position=UDim2.new(0,10,0,10),
        BackgroundTransparency=1,
        Text=title,
        TextColor3=TEXT,
        TextSize=13,
        Font=Enum.Font.GothamBold,
        TextXAlignment=Enum.TextXAlignment.Left,
        ZIndex=502,
    },card)

    if hasDesc then
        new("TextLabel",{
            Size=UDim2.new(1,-10,0,18),
            Position=UDim2.new(0,10,0,30),
            BackgroundTransparency=1,
            Text=desc,
            TextColor3=MUTED,
            TextSize=11,
            Font=Enum.Font.Gotham,
            TextXAlignment=Enum.TextXAlignment.Left,
            ZIndex=502,
        },card)
    end

    if hasBtns then
        local bx = 10
        for i=#buttons,1,-1 do
            local bdef=buttons[i]
            local btn=new("TextButton",{
                Size=UDim2.new(0,68,0,24),
                Position=UDim2.new(1,-(bx+68),1,-32),
                BackgroundColor3=ACCENT,
                BorderSizePixel=0,
                Text=bdef.Text or "OK",
                TextColor3=TEXT,
                TextSize=12,
                Font=Enum.Font.GothamBold,
                ZIndex=503,
            },card)
            corner(5,btn)
            btn.MouseEnter:Connect(function() tw(btn,.12,{BackgroundColor3=ACCENT2}):Play() end)
            btn.MouseLeave:Connect(function() tw(btn,.12,{BackgroundColor3=ACCENT}):Play() end)
            btn.MouseButton1Click:Connect(function()
                if bdef.Callback then bdef.Callback() end
                tw(card,.2,{Position=UDim2.new(1,20,0,0)}):Play()
                task.delay(.25,function() card:Destroy() end)
            end)
            bx=bx+76
        end
    end

    -- slide in
    tw(card,.25,{Position=UDim2.new(0,0,0,0)},Enum.EasingStyle.Back,Enum.EasingDirection.Out):Play()
    -- progress bar
    tw(bar,hasBtns and 60 or dur,{Size=UDim2.new(1,0,0,2)}):Play()

    if not hasBtns then
        task.delay(dur,function()
            if card and card.Parent then
                tw(card,.25,{Position=UDim2.new(1,20,0,0)}):Play()
                task.delay(.3,function() if card and card.Parent then card:Destroy() end end)
            end
        end)
    end
end

