local function drawIcon(name, holder, s, color)
	local builder = Drawn[name]
	if not builder then
		return nil
	end
	local u = s / 16
	local parts = {}
	local function box(x, y, w, h, radius)
		local f = create("Frame", {
			Position = UDim2.fromOffset(x * u, y * u),
			Size = UDim2.fromOffset(w * u, h * u),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Parent = holder,
		})
		if radius and radius > 0 then
			corner(f, radius * u)
		end
		parts[#parts + 1] = { inst = f, prop = "BackgroundColor3" }
	end
	local function ring(x, y, w, h, thickness)
		local f = create("Frame", {
			Position = UDim2.fromOffset(x * u, y * u),
			Size = UDim2.fromOffset(w * u, h * u),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = holder,
		})
		corner(f, math.min(w, h) / 2 * u)
		local st = stroke(f, color, math.max(1, thickness * u), 0)
		parts[#parts + 1] = { inst = st, prop = "Color" }
	end
	local function bar(cx, cy, len, thick, rot)
		local f = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(cx * u, cy * u),
			Size = UDim2.fromOffset(len * u, thick * u),
			Rotation = rot or 0,
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Parent = holder,
		})
		corner(f, thick * u / 2)
		parts[#parts + 1] = { inst = f, prop = "BackgroundColor3" }
	end
	builder(box, ring, bar)
	return parts
end

local function asAsset(icon)
	local kind = typeof(icon)
	if kind == "number" then
		return { Url = "rbxassetid://" .. icon }
	elseif kind == "string" then
		if string.match(icon, "^%d+$") then
			return { Url = "rbxassetid://" .. icon }
		end
		if string.find(icon, "rbxasset", 1, true) then
			return { Url = icon }
		end
	elseif kind == "table" then
		if icon.Url then
			return icon
		end
		if icon.Id then
			return {
				Url = "rbxassetid://" .. icon.Id,
				ImageRectSize = icon.ImageRectSize,
				ImageRectOffset = icon.ImageRectOffset,
			}
		end
	end
	return nil
end

local function resolveIcon(icon)
	if icon == nil or icon == "" then
		return nil
	end
	local asset = asAsset(icon)
	if asset then
		return "image", asset
	end
	if type(icon) == "string" then
		local key = string.lower(icon)
		local registered = Nexus.Icons[icon] or Nexus.Icons[key]
		if registered ~= nil then
			local a = asAsset(registered)
			if a then
				return "image", a
			end
		end
		if Nexus._iconProvider then
			local ok, res = pcall(Nexus._iconProvider, icon)
			if ok and res then
				local a = asAsset(res)
				if a then
					return "image", a
				end
			end
		end
		if Drawn[key] then
			return "drawn", key
		end
	end
	return nil
end

local function createIcon(parent, icon, size, color)
	local kind, data = resolveIcon(icon)
	if not kind then
		return nil
	end
	local holder = create("Frame", {
		Name = "Icon",
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		ClipsDescendants = (kind == "drawn"),
		Parent = parent,
	})
	if not holder then
		return nil
	end
	local obj = { Frame = holder }
	if kind == "image" then
		local img = create("ImageLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Image = data.Url,
			ImageColor3 = color,
			ScaleType = Enum.ScaleType.Fit,
			Parent = holder,
		})
		if data.ImageRectSize then
			img.ImageRectSize = data.ImageRectSize
			img.ImageRectOffset = data.ImageRectOffset or Vector2.new(0, 0)
		end
		function obj.SetColor(c, instant)
			apply(img, Ease.Med, { ImageColor3 = c }, instant)
		end
	else
		local parts = drawIcon(data, holder, size, color)
		function obj.SetColor(c, instant)
			for _, p in ipairs(parts or {}) do
				apply(p.inst, Ease.Med, { [p.prop] = c }, instant)
			end
		end
	end
	return obj
end

local zCounter = 1
local function bringFront(obj)
	zCounter = zCounter + 1
	obj.ZIndex = zCounter
end

local function makeDraggable(handle, target)
	local dragging = false
	local startInput, startPos
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			startInput = Vector2.new(input.Position.X, input.Position.Y)
			startPos = target.Position
			bringFront(target)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = Vector2.new(input.Position.X, input.Position.Y) - startInput
			target.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function mousePos()
	local x, y
	if Mouse then
		x, y = Mouse.X, Mouse.Y
	else
		local m = UserInputService:GetMouseLocation() - GuiService:GetGuiInset()
		x, y = m.X, m.Y
	end
	return Vector2.new(x, y) + Nexus.MouseOffset
end

-- [CORRIGIDO] valida se o ScreenGui foi criado e tenta múltiplos containers
-- com pcall antes de desistir, reportando um erro claro no lugar de deixar
-- o script quebrar mais adiante com "index nil".
local function getGui(parent)
	if Nexus._gui and Nexus._gui.Parent then
		return Nexus._gui
	end
	local gui = create("ScreenGui", {
		Name = "NexusLib",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 100,
	})

	if not gui then
		error("[Nexus] Não foi possível criar o ScreenGui principal. Verifique se o executor bloqueou Instance.new(\"ScreenGui\").")
	end

	if parent then
		gui.Parent = parent
	else
		local placed = false
		local ok, hidden = pcall(function()
			return gethui and gethui()
		end)
		if ok and hidden then
			placed = pcall(function()
				gui.Parent = hidden
			end)
		end
		if not placed then
			placed = pcall(function()
				gui.Parent = game:GetService("CoreGui")
			end)
		end
		if not placed then
			placed = pcall(function()
				gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
			end)
		end
		if not placed then
			error("[Nexus] Não foi possível parentear o ScreenGui a nenhum container (gethui/CoreGui/PlayerGui falharam).")
		end
	end
	Nexus._gui = gui
	return gui
end

