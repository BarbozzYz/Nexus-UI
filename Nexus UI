    local function setPage(pageData)
        if activePage then
            activePage.pageFrame.Visible=false
        end
        activePage=pageData
        pageData.pageFrame.Visible=true
        -- update nav highlight
        for _,nb in ipairs(navButtons) do
            local isActive=(nb.data==pageData)
            nb.dot.BackgroundColor3=isActive and C.Accent or Color3.fromRGB(55,55,65)
            nb.label.TextColor3=isActive and C.Accent or C.Muted
            if isActive then
                nb.bar.Visible=true
            else
                nb.bar.Visible=false
            end
        end
    end

    local function setTab(pageData, tabData)
        -- hide all sections in page
        for _,s in ipairs(pageData.sections) do
            s.frame.Visible=false
        end
        tabData.frame.Visible=true
        -- update tab buttons
        for _,tb in ipairs(pageData.tabBtns) do
            local isActive=(tb.data==tabData)
            tb.btn.BackgroundColor3=isActive and Color3.fromRGB(30,30,36)
                or Color3.fromRGB(0,0,0,0)
            tb.btn.BackgroundTransparency=isActive and 0 or 1
            tb.btn.TextColor3=isActive and C.Accent or C.Muted
        end
    end

