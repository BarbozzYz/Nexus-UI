		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = holder,
	})
	return holder
end

function Nexus:Notify(opts)
	opts = opts or {}
	local gui = getGui()
	local holder = getNotifyHolder(gui)
	local W, H = Nexus.Sizes.Notify.X, Nexus.Sizes.Notify.Y
	local scale = H / 36
	local duration = opts.Duration or 4

	Nexus._notifyCount = (Nexus._notifyCount or 0) + 1

	local wrapper = create("Frame", {
		Name = "Notify",
		Size = UDim2.fromOffset(W, H),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		LayoutOrder = Nexus._notifyCount,
		Parent = holder,
	})
	local group = create("CanvasGroup", {
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.new(-1.15, 0, 0, 0),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Parent = wrapper,
	})
	corner(group, 6)

	local theta = 14
	local rad = math.rad(theta)
	local bodyW = W * 2
	local midX = W - (H / 2) * math.tan(rad)
	local cx = midX - (bodyW / 2) * math.cos(rad)
	local cy = H / 2 - (bodyW / 2) * math.sin(rad)
	create("Frame", {
		Name = "Body",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(cx, cy),
		Size = UDim2.fromOffset(bodyW, 300),
		Rotation = theta,
		BackgroundColor3 = Theme.Item,
		BorderSizePixel = 0,
		Parent = group,
	})

	label({
		Name = "Title",
		Parent = group,
		Position = UDim2.fromOffset(12, 3 * scale),
		Size = UDim2.fromOffset(W - 40, 16 * scale),
		Text = opts.Title or "Title Notify....",
		Font = Theme.FontMedium,
		TextSize = math.floor(13 * scale + 0.5),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	label({
		Name = "Description",
		Parent = group,
		Position = UDim2.fromOffset(16, 19 * scale),
		Size = UDim2.fromOffset(W - 46, 12 * scale),
		Text = opts.Description or "Description...",
		TextColor3 = Theme.SubText,
		TextSize = math.floor(10 * scale + 0.5),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	local maxLine = W - H * math.tan(rad) - 8
	local line = create("Frame", {
		Name = "Timer",
		Position = UDim2.new(0, 0, 1, -2),
		Size = UDim2.fromOffset(maxLine, 2),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = group,
	})
	create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(1, 0.45),
		}),
		Parent = line,
	})

	local dead = false
	local function dismiss()
		if dead then
			return
		end
		dead = true
		tween(group, Ease.Med, { Position = UDim2.new(-1.15, 0, 0, 0), GroupTransparency = 1 })
		task.delay(0.26, function()
			local t = tween(wrapper, Ease.Med, { Size = UDim2.fromOffset(W, 0) })
			if t then
				t.Completed:Connect(function()
					wrapper:Destroy()
				end)
			else
				wrapper:Destroy()
			end
		end)
	end

	local hit = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 10,
		Parent = group,
	})
	hit.Activated:Connect(dismiss)

	tween(group, Ease.Slow, { Position = UDim2.new(0, 0, 0, 0) })
	tween(group, Ease.Med, { GroupTransparency = 0 })
	tween(line, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.fromOffset(0, 2) })
	task.delay(duration, dismiss)
end

