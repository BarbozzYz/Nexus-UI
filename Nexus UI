                    -- ── Toggle ─────────────────────────────────────────────
                    function Sec:AddToggle(tcfg)
                        local lname   = tcfg.Name    or "Toggle"
                        local default = tcfg.Default or false
                        local keybind = tcfg.Keybind
                        local cb      = tcfg.Callback

                        local val=default
                        local row=makeRow(28)

                        new("TextLabel",{
                            Size=UDim2.new(0.6,0,1,0),
                            BackgroundTransparency=1,
                            Text=lname,
                            TextColor3=TEXT,TextSize=12,
                            Font=Enum.Font.Gotham,
                            TextXAlignment=Enum.TextXAlignment.Left,
                            ZIndex=16,
                        },row)

                        -- track
                        local track=new("Frame",{
                            Size=UDim2.new(0,38,0,20),
                            Position=UDim2.new(1,-54,0.5,-10),
                            BackgroundColor3=val and ACCENT or Color3.fromRGB(50,50,62),
                            BorderSizePixel=0,
                            ZIndex=16,
                        },row)
                        corner(10,track)

                        local thumb=new("Frame",{
                            Size=UDim2.new(0,16,0,16),
                            Position=val and UDim2.new(1,-18,0.5,-8)
                                         or UDim2.new(0,2,0.5,-8),
                            BackgroundColor3=Color3.fromRGB(220,215,255),
                            BorderSizePixel=0,
                            ZIndex=17,
                        },track)
                        corner(8,thumb)

                        -- segundo indicador (dot cinza ao lado)
                        local dot2=new("Frame",{
                            Size=UDim2.new(0,10,0,10),
                            Position=UDim2.new(1,-12,0.5,-5),
                            BackgroundColor3=Color3.fromRGB(80,80,100),
                            BorderSizePixel=0,
                            ZIndex=16,
                        },row)
                        corner(5,dot2)

                        local function setVal(v)
                            val=v
                            tw(track,.15,{BackgroundColor3=v and ACCENT
                                or Color3.fromRGB(50,50,62)}):Play()
                            tw(thumb,.15,{Position=v and UDim2.new(1,-18,0.5,-8)
                                or UDim2.new(0,2,0.5,-8)}):Play()
                            if cb then cb(v) end
                        end

                        local hit=new("TextButton",{
                            Size=UDim2.new(1,0,1,0),
                            BackgroundTransparency=1,Text="",ZIndex=18,
                        },row)
                        hit.MouseButton1Click:Connect(function() setVal(not val) end)

                        -- keybind
                        if keybind then
                            addKbEntry(lname,keybind)
                            UserInputService.InputBegan:Connect(function(i,gp)
                                if not gp and i.KeyCode==keybind then setVal(not val) end
                            end)
                        end

                        return {
                            Set=setVal,
                            Get=function() return val end,
                        }
                    end

                    -- ── Slider ─────────────────────────────────────────────
                    function Sec:AddSlider(scfg)
                        local lname=scfg.Name    or "Slider"
                        local smin =scfg.Min     or 0
                        local smax =scfg.Max     or 100
                        local sval =scfg.Default or 50
                        local cb   =scfg.Callback

                        local row=makeRow(32)

                        local nameLbl=new("TextLabel",{
                            Size=UDim2.new(0.65,0,0,16),
                            BackgroundTransparency=1,
                            Text=lname,
                            TextColor3=TEXT,TextSize=12,
                            Font=Enum.Font.Gotham,
                            TextXAlignment=Enum.TextXAlignment.Left,
                            ZIndex=16,
                        },row)

                        local valLbl=new("TextLabel",{
                            Size=UDim2.new(0.35,0,0,16),
                            BackgroundTransparency=1,
                            Text=tostring(sval),
                            TextColor3=MUTED,TextSize=11,
                            Font=Enum.Font.Code,
                            TextXAlignment=Enum.TextXAlignment.Right,
                            ZIndex=16,
                        },row)

                        local track=new("Frame",{
                            Size=UDim2.new(1,0,0,5),
                            Position=UDim2.new(0,0,0,20),
                            BackgroundColor3=SURFACE2,
                            BorderSizePixel=0,
                            ZIndex=16,
                        },row)
                        corner(3,track)

                        local norm=(sval-smin)/(smax-smin)
                        local fill=new("Frame",{
                            Size=UDim2.new(norm,0,1,0),
                            BackgroundColor3=ACCENT2,
                            BorderSizePixel=0,
                            ZIndex=17,
                        },track)
                        corner(3,fill)

                        local dragging=false
                        local function updateSlider(mx)
                            local rel=math.clamp(
                                (mx-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
                            sval=math.floor(smin+rel*(smax-smin))
                            fill.Size=UDim2.new(rel,0,1,0)
                            valLbl.Text=tostring(sval)
                            if cb then cb(sval) end
                        end

                        track.InputBegan:Connect(function(i)
                            if i.UserInputType==Enum.UserInputType.MouseButton1 then
                                dragging=true
                                updateSlider(i.Position.X)
                            end
                        end)
                        UserInputService.InputEnded:Connect(function(i)
                            if i.UserInputType==Enum.UserInputType.MouseButton1 then
                                dragging=false
                            end
                        end)
                        UserInputService.InputChanged:Connect(function(i)
                            if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then
                                updateSlider(i.Position.X)
                            end
                        end)

                        return {
                            Get=function() return sval end,
                            Set=function(v)
                                sval=math.clamp(v,smin,smax)
                                local r=(sval-smin)/(smax-smin)
                                fill.Size=UDim2.new(r,0,1,0)
                                valLbl.Text=tostring(sval)
                            end,
                        }
                    end

                    -- ── Button ─────────────────────────────────────────────
