                    -- ── Keybind ────────────────────────────────────────────
                    function Sec:AddKeybind(kcfg)
                        local lname = kcfg.Name    or "Keybind"
                        local kkey  = kcfg.Default or Enum.KeyCode.Unknown
                        local cb    = kcfg.Callback
                        local waiting=false

                        local row=makeRow(28)

                        new("TextLabel",{
                            Size=UDim2.new(0.5,0,1,0),
                            BackgroundTransparency=1,
                            Text=lname,
                            TextColor3=TEXT,TextSize=12,
                            Font=Enum.Font.Gotham,
                            TextXAlignment=Enum.TextXAlignment.Left,
                            ZIndex=16,
                        },row)

                        -- botão "Click" como no vídeo
                        local kbtn=new("TextButton",{
                            Size=UDim2.new(0.5,0,1,-4),
                            Position=UDim2.new(0.5,0,0,2),
                            BackgroundColor3=SURFACE2,
                            BorderSizePixel=0,
                            Text=waiting and "..." or tostring(kkey):gsub("Enum%.KeyCode%.",""),
                            TextColor3=TEXT,TextSize=11,
                            Font=Enum.Font.Code,
                            ZIndex=16,
                            AutoButtonColor=false,
                        },row)
                        corner(5,kbtn)

                        kbtn.MouseButton1Click:Connect(function()
                            if not waiting then
                                waiting=true
                                kbtn.Text="..."
                                kbtn.TextColor3=ACCENT2
                            end
                        end)

                        UserInputService.InputBegan:Connect(function(i,gp)
                            if waiting and not gp then
                                waiting=false
                                kkey=i.KeyCode
                                local ks=tostring(kkey):gsub("Enum%.KeyCode%.","")
                                kbtn.Text=ks
                                kbtn.TextColor3=TEXT
                                addKbEntry(lname,kkey)
                                if cb then cb(kkey) end
                            end
                        end)

                        return {Get=function() return kkey end}
                    end

                    return Sec
                end -- AddSection

                return Col
            end -- AddColumn

            return tabData
        end -- AddTab

        return pageData
    end -- AddPage

    -- ── Toggle visibilidade ───────────────────────────────────────────────────
    local isOpen=false

    local function openWin()
        isOpen=true
        frame.Visible=true
        frame.Size=UDim2.new(0,0,0,H)
        frame.AnchorPoint=Vector2.new(0,0.5)
        frame.Position=UDim2.new(0.5,-W/2,0.5,0)
        frame.ClipsDescendants=true
        tw(blurEffect,.3,{Size=14}):Play()

        local elapsed=0
        local conn=RunService.Heartbeat:Connect(function(dt)
            elapsed=elapsed+dt
            local t=math.clamp(elapsed/.5,0,1)
            local e=elasticOut(t)
            frame.Size=UDim2.new(0,math.max(0,e*W),0,H)
            if t>=1 then
                frame.Size=UDim2.new(0,W,0,H)
                frame.AnchorPoint=Vector2.new(0.5,0.5)
                frame.Position=UDim2.new(0.5,0,0.5,0)
                frame.ClipsDescendants=false
            end
        end)
        -- desconecta depois de 1s (margem de segurança)
        task.delay(1,function()
            pcall(function() conn:Disconnect() end)
            frame.Size=UDim2.new(0,W,0,H)
            frame.AnchorPoint=Vector2.new(0.5,0.5)
            frame.Position=UDim2.new(0.5,0,0.5,0)
            frame.ClipsDescendants=false
        end)
    end

    local function closeWin()
        isOpen=false
        tw(blurEffect,.2,{Size=0}):Play()
        tw(frame,.2,{Size=UDim2.new(0,0,0,H)},Enum.EasingStyle.Quad):Play()
        task.delay(.25,function() frame.Visible=false end)
    end

    UserInputService.InputBegan:Connect(function(i,gp)
        if gp then return end
        if i.KeyCode==toggleKey then
            if isOpen then closeWin() else openWin() end
        end
    end)

    openWin()
    return Win
end

return Nexus
