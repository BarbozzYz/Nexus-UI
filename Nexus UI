		Parent = body,
	})

	local good = Color3.fromRGB(110, 220, 130)
	local mid = Color3.fromRGB(240, 200, 90)
	local bad = Color3.fromRGB(240, 90, 90)

	local frames, acc, conn = 0, 0, nil

	local function stop()
		if conn then
			conn:Disconnect()
			conn = nil
		end
	end

	popup.OnOpen = function()
		stop()
		frames, acc = 0, 0
		conn = RunService.RenderStepped:Connect(function(dt)
			frames = frames + 1
			acc = acc + dt
			if acc < 0.6 then
				return
			end
			local fps = frames / acc
			frames, acc = 0, 0

			local ms
			pcall(function()
				ms = StatsService.Network.ServerStatsItem["Data Ping"]:GetValue()
			end)

			fpsValue.Text = tostring(math.floor(fps + 0.5))
			tween(fpsValue, Ease.Fast, { TextColor3 = fps >= 55 and good or (fps >= 30 and mid or bad) })
			if ms then
				msValue.Text = tostring(math.floor(ms + 0.5))
				tween(msValue, Ease.Fast, { TextColor3 = ms <= 80 and good or (ms <= 150 and mid or bad) })
			end
		end)
	end
	popup.OnHide = stop
	popup.Destroying = stop

	return popup
end

