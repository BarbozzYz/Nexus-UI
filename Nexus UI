------------------------------------------------------------------ notificacoes

local function getNotifyHolder(gui)
	local holder = gui:FindFirstChild("Notifications")
	if holder then
		return holder
	end
	holder = create("Frame", {
		Name = "Notifications",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 20, 1, -20),
		Size = UDim2.fromOffset(340, 500),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	create("UIListLayout", {
		Padding = UDim.new(0, 8),
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = holder,
	})
	return holder
end

function Nexus:Notify(opts)
	opts = opts or {}
	local gui = getGui()
	local holder = getNotifyHolder(gui)
	local W = Nexus.Sizes.Notify.X
	local hasButtons = opts.Buttons and #opts.Buttons > 0

	Nexus._notifyCount = (Nexus._notifyCount or 0) + 1

	if hasButtons then
		------------------------------------------------------ variante com botoes (ex.: Yes / No)
		local H = 78
		local wrapper = create("Frame", {
			Name = "Notify",
			Size = UDim2.fromOffset(W, H),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			LayoutOrder = Nexus._notifyCount,
			Parent = holder,
		})
		local card = create("CanvasGroup", {
			Size = UDim2.fromScale(1, 1),
			Position = UDim2.new(1.15, 0, 0, 0),
			BackgroundColor3 = Theme.Item,
			BorderSizePixel = 0,
			GroupTransparency = 1,
			Parent = wrapper,
		})
		corner(card, 8)
		local accentLine = create("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, 0),
			Size = UDim2.new(1, 0, 0, 2),
			BackgroundColor3 = Theme.Accent,
			BorderSizePixel = 0,
			Parent = card,
		})
		create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 0.6),
			}),
			Parent = accentLine,
		})
		label({
			Name = "Title",
			Parent = card,
			Position = UDim2.fromOffset(14, 12),
			Size = UDim2.fromOffset(W - 28, 18),
			Text = opts.Title or "Notify",
			Font = Theme.FontMedium,
			TextSize = 14,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		label({
			Name = "Description",
			Parent = card,
			Position = UDim2.fromOffset(14, 32),
			Size = UDim2.fromOffset(W - 28, 16),
			Text = opts.Description or "",
			TextColor3 = Theme.SubText,
			TextSize = 12,
			TextWrapped = true,
		})

		local dead = false
		local dismissTimer
		local function dismiss()
			if dead then
				return
			end
			dead = true
			if dismissTimer then
				task.cancel(dismissTimer)
			end
			tween(card, Ease.Med, { Position = UDim2.new(1.15, 0, 0, 0), GroupTransparency = 1 })
			task.delay(0.26, function()
				local t = tween(wrapper, Ease.Med, { Size = UDim2.fromOffset(W, 0) })
				t.Completed:Connect(function()
					wrapper:Destroy()
				end)
			end)
		end

		local buttonW, gap = 58, 8
		local totalW = (#opts.Buttons * buttonW) + (#opts.Buttons - 1) * gap
		local startX = W - 14 - totalW
		for i, btnOpts in ipairs(opts.Buttons) do
			local btn = create("TextButton", {
				Position = UDim2.fromOffset(startX + (i - 1) * (buttonW + gap), 52),
				Size = UDim2.fromOffset(buttonW, 22),
				BackgroundColor3 = Theme.Accent,
				BorderSizePixel = 0,
				Text = btnOpts.Text or "OK",
				TextColor3 = Theme.Text,
				Font = Theme.FontMedium,
				TextSize = 12,
				AutoButtonColor = false,
				Parent = card,
			})
			corner(btn, 5)
			btn.MouseEnter:Connect(function()
				tween(btn, Ease.Fast, { BackgroundTransparency = 0.15 })
			end)
			btn.MouseLeave:Connect(function()
				tween(btn, Ease.Fast, { BackgroundTransparency = 0 })
			end)
			btn.Activated:Connect(function()
				fire(btnOpts.Callback)
				dismiss()
			end)
		end

		tween(card, Ease.Slow, { Position = UDim2.new(0, 0, 0, 0) })
		tween(card, Ease.Med, { GroupTransparency = 0 })
		if opts.Duration then
			dismissTimer = task.delay(opts.Duration, dismiss)
		end
		return
	end

	------------------------------------------------------------ variante padrao (sem botoes)
	local W2, H = W, Nexus.Sizes.Notify.Y
	local scale = H / 36
	local duration = opts.Duration or 4

	local wrapper = create("Frame", {
		Name = "Notify",
		Size = UDim2.fromOffset(W2, H),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		LayoutOrder = Nexus._notifyCount,
		Parent = holder,
	})
	local group = create("CanvasGroup", {
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.new(-1.15, 0, 0, 0),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Parent = wrapper,
	})
	corner(group, 6)

	-- corpo com a borda direita inclinada: retangulo rotacionado e cortado pelo CanvasGroup
	local theta = 14
	local rad = math.rad(theta)
	local bodyW = W2 * 2
	local midX = W2 - (H / 2) * math.tan(rad)
	local cx = midX - (bodyW / 2) * math.cos(rad)
	local cy = H / 2 - (bodyW / 2) * math.sin(rad)
	create("Frame", {
		Name = "Body",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(cx, cy),
		Size = UDim2.fromOffset(bodyW, 300),
		Rotation = theta,
		BackgroundColor3 = Theme.Item,
		BorderSizePixel = 0,
		Parent = group,
	})

	label({
		Name = "Title",
		Parent = group,
		Position = UDim2.fromOffset(12, 3 * scale),
		Size = UDim2.fromOffset(W2 - 40, 16 * scale),
		Text = opts.Title or "Title Notify....",
		Font = Theme.FontMedium,
		TextSize = math.floor(13 * scale + 0.5),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	label({
		Name = "Description",
		Parent = group,
		Position = UDim2.fromOffset(16, 19 * scale),
		Size = UDim2.fromOffset(W2 - 46, 12 * scale),
		Text = opts.Description or "Description...",
		TextColor3 = Theme.SubText,
		TextSize = math.floor(10 * scale + 0.5),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	local maxLine = W2 - H * math.tan(rad) - 8
	local line = create("Frame", {
		Name = "Timer",
		Position = UDim2.new(0, 0, 1, -2),
		Size = UDim2.fromOffset(maxLine, 2),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = group,
	})
	create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(1, 0.45),
		}),
		Parent = line,
	})

	local dead = false
	local function dismiss()
		if dead then
			return
		end
		dead = true
		tween(group, Ease.Med, { Position = UDim2.new(-1.15, 0, 0, 0), GroupTransparency = 1 })
		task.delay(0.26, function()
			local t = tween(wrapper, Ease.Med, { Size = UDim2.fromOffset(W2, 0) })
			t.Completed:Connect(function()
				wrapper:Destroy()
			end)
		end)
	end

	local hit = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 10,
		Parent = group,
	})
	hit.Activated:Connect(dismiss)

	tween(group, Ease.Slow, { Position = UDim2.new(0, 0, 0, 0) })
	tween(group, Ease.Med, { GroupTransparency = 0 })
	tween(line, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.fromOffset(0, 2) })
	task.delay(duration, dismiss)
end

------------------------------------------------------------------ Window

function Nexus:CreateWindow(opts)
	opts = opts or {}
	local self = setmetatable({}, Window)
	local gui = getGui(opts.Parent)
	local size = opts.Size or Nexus.Sizes.Window

	self.Gui = gui
	self.Size = size
	self.Tabs = {}
	self.Categories = {}
	self.Popups = {}
	self.Flags = {}
	self.Connections = {}
	self.Visible = true
	self.ToggleKey = opts.ToggleKey or Enum.KeyCode.RightShift
	self._keybindObjs = {}

	local root = create("CanvasGroup", {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundColor3 = Theme.Window,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		Parent = gui,
	})
	corner(root, 8)
	stroke(root, Color3.fromRGB(52, 52, 58), 1, 0.35)
	local scale = create("UIScale", { Scale = 0.9, Parent = root })
	self.Root, self.Scale = root, scale

	----------------------------------------------------------- sidebar
	local sidebar = create("Frame", {
		Name = "Sidebar",
		Size = UDim2.new(0, 135, 1, 0),
		BackgroundColor3 = Theme.Sidebar,
		BorderSizePixel = 0,
		Parent = root,
	})

	local name = opts.Name or "Nexus"
	local first, rest = name:sub(1, 1), name:sub(2)
	local logoSize = Nexus.Sizes.LogoText
	label({
		Name = "Logo",
		Parent = sidebar,
		Position = UDim2.fromOffset(24, 20),
		Size = UDim2.fromOffset(120, logoSize + 10),
		RichText = true,
		Text = string.format('<font color="#A000FF" size="%d">%s</font>%s', logoSize + 8, first, rest),
		Font = Theme.FontLogo,
		TextSize = logoSize,
	})
	-- SubName e opcional agora (antes vinha fixo como "LIB")
	if opts.SubName then
		label({
			Name = "SubLogo",
			Parent = sidebar,
			Position = UDim2.fromOffset(26, 20 + logoSize + 6),
			Size = UDim2.fromOffset(90, 20),
			Text = opts.SubName,
			Font = Theme.FontLogo,
			TextSize = 19,
		})
	end

	self._nav = create("ScrollingFrame", {
		Name = "Nav",
		Position = UDim2.fromOffset(10, 89),
		Size = UDim2.new(1, -20, 1, -160),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = sidebar,
	})
	create("UIListLayout", {
		Padding = UDim.new(0, 3),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = self._nav,
	})

	local user = create("Frame", {
		Name = "User",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundColor3 = Theme.SidebarUser,
		BorderSizePixel = 0,
		Parent = sidebar,
	})
	local avatar = create("ImageLabel", {
		Name = "Avatar",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 20, 0.5, 0),
		Size = UDim2.fromOffset(24, 24),
		BackgroundColor3 = Color3.fromRGB(217, 217, 217),
		BorderSizePixel = 0,
		Image = "",
		Parent = user,
	})
	corner(avatar, 12)
	local userId = opts.UserId or (LocalPlayer and LocalPlayer.UserId)
	local showId = opts.ShowUserId ~= false and userId ~= nil
	label({
		Name = "Username",
		Parent = user,
		Position = showId and UDim2.fromOffset(52, 9) or UDim2.fromOffset(52, 0),
		Size = showId and UDim2.new(1, -60, 0, 16) or UDim2.new(1, -60, 1, 0),
		Text = opts.Username or (LocalPlayer and LocalPlayer.DisplayName) or "Username",
