--[[
    Nexus Lib  |  UI library para Roblox (Luau)
    Coloque como ModuleScript (ou use loadstring) e retorne a tabela Nexus.

    Nexus:CreateWindow({
      Name, SubName, Username, UserId, ShowUserId, Footer, ToggleKey,
      Size, Parent, Resizable, MinSize, MaxSize,
    })
      Window:CreateCategory(nome, {Collapsible, Collapsed}) -> Category (:CreateTab(nome, icone))
      Window:CreateTab(nome, icone)         -> Tab
        Tab:CreateCard(titulo, {Icon, IconColor}) -> Card
          Card:AddToggle{Name, Default, Flag, Callback}
          Card:AddButton{Name, Callback}
          Card:AddSlider{Name, Min, Max, Default, Step, Suffix, Flag, Callback}
          Card:AddDropdown{Name, Options, Default, MaxVisible, Width, Flag, Callback}
          Card:AddKeybind{Name, Default, Flag, Callback, OnChanged}
          Card:AddColorPicker{Name, Default, Flag, Callback}
          Card:AddThemeColor{Key, Name}
          Card:AddLabel(texto)
      Window:CreatePreview{Title, Size}     -> Preview (:SetModel, :Open, :Close, :Toggle)
      Window:BindToggleKeybind(card, {Name, Flag})
      Window:SetVisible(bool) / Window:Toggle() / Window:Destroy()
      Window.Flags[flag]                    -> valor atual dos elementos
    Nexus:Notify({ Title, Description, Duration })

    ------------------------------------------------------------------
    CORREÇÕES APLICADAS NESTA VERSÃO:
    1) A função `tween()` estava faltando no arquivo original (foi cortada
       sem querer), causando erro em cascata em qualquer elemento animado.
       Ela foi restaurada logo antes de `apply()`.
    2) `create()` agora usa pcall ao redor de Instance.new e valida se a
       instância não é nil ANTES de tentar setar propriedades nela —
       isso corrige o erro "attempt to index nil with 'ResetOnSpawn'".
    3) `getGui()` agora valida se o ScreenGui foi criado com sucesso e
       tenta gethui() -> CoreGui -> PlayerGui em cascata com pcall,
       reportando um erro claro caso todos falhem.
    ------------------------------------------------------------------
]]

