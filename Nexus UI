------------------------------------------------------------------ popups (janelas avulsas)

local Popup = {}
Popup.__index = Popup

function Popup:Open(position)
	if self.IsOpen then
		return
	end
	self.IsOpen = true
	self.Token = self.Token + 1
	if position then
		self.Root.Position = position
	end
	self.Root.Visible = true
	bringFront(self.Root)
	self.Scale.Scale = 0.9
	self.Root.GroupTransparency = 1
	tween(self.Scale, Ease.Back, { Scale = 1 })
	tween(self.Root, Ease.Med, { GroupTransparency = 0 })
	if self.OnOpen then
		self.OnOpen()
	end
end

function Popup:Close(silent)
	if not self.IsOpen then
		return
	end
	self.IsOpen = false
	self.Token = self.Token + 1
	local token = self.Token
	tween(self.Scale, Ease.Fast, { Scale = 0.94 })
	local t = tween(self.Root, Ease.Fast, { GroupTransparency = 1 })
	t.Completed:Connect(function()
		if self.Token == token then
			self.Root.Visible = false
		end
	end)
	if self.OnHide then
		self.OnHide()
	end
	if self.OnClose and not silent then
		self.OnClose()
	end
end

function Popup:Toggle(position)
	if self.IsOpen then
		self:Close()
	else
		self:Open(position)
	end
end

