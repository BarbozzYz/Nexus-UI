                    -- ── Dropdown ───────────────────────────────────────────
                    function Sec:AddDropdown(dcfg)
                        local lname  = dcfg.Name    or "Dropdown"
                        local items  = dcfg.Items   or {}
                        local dval   = dcfg.Default or (items[1] or "")
                        local cb     = dcfg.Callback
                        local isOpen = false

                        local row=makeRow(28)

                        new("TextLabel",{
                            Size=UDim2.new(0.42,0,1,0),
                            BackgroundTransparency=1,
                            Text=lname,
                            TextColor3=TEXT,TextSize=12,
                            Font=Enum.Font.Gotham,
                            TextXAlignment=Enum.TextXAlignment.Left,
                            ZIndex=16,
                        },row)

                        local ddBtn=new("TextButton",{
                            Size=UDim2.new(0.58,0,1,-2),
                            Position=UDim2.new(0.42,0,0,1),
                            BackgroundColor3=SURFACE2,
                            BorderSizePixel=0,
                            Text=dval.."  ∧",
                            TextColor3=TEXT,TextSize=11,
                            Font=Enum.Font.Gotham,
                            ZIndex=16,
                            AutoButtonColor=false,
                        },row)
                        corner(5,ddBtn)

                        local dropFrame=new("Frame",{
                            Size=UDim2.new(0.58,0,0,0),
                            Position=UDim2.new(0.42,0,1,2),
                            BackgroundColor3=SURFACE2,
                            BorderSizePixel=0,
                            ClipsDescendants=true,
                            ZIndex=30,
                            Visible=false,
                        },row)
                        corner(5,dropFrame)

                        local dropLayout=new("UIListLayout",{
                            Padding=UDim.new(0,0),
                        },dropFrame)
                        pad(0,0,2,2,dropFrame)

                        for _,item in ipairs(items) do
                            local iBtn=new("TextButton",{
                                Size=UDim2.new(1,0,0,24),
                                BackgroundTransparency=1,
                                Text=item,
                                TextColor3=MUTED,TextSize=11,
                                Font=Enum.Font.Gotham,
                                ZIndex=31,
                                AutoButtonColor=false,
                            },dropFrame)
                            iBtn.MouseEnter:Connect(function() iBtn.TextColor3=TEXT end)
                            iBtn.MouseLeave:Connect(function() iBtn.TextColor3=MUTED end)
                            iBtn.MouseButton1Click:Connect(function()
                                dval=item
                                ddBtn.Text=dval.."  ∧"
                                isOpen=false
                                tw(dropFrame,.12,{Size=UDim2.new(0.58,0,0,0)}):Play()
                                task.delay(.13,function() dropFrame.Visible=false end)
                                if cb then cb(item) end
                            end)
                        end

                        ddBtn.MouseButton1Click:Connect(function()
                            isOpen=not isOpen
                            if isOpen then
                                dropFrame.Visible=true
                                tw(dropFrame,.15,{Size=UDim2.new(0.58,0,0,#items*24+4)},
                                    Enum.EasingStyle.Quad):Play()
                                ddBtn.Text=dval.."  ∨"
                            else
                                tw(dropFrame,.12,{Size=UDim2.new(0.58,0,0,0)}):Play()
                                task.delay(.13,function() dropFrame.Visible=false end)
                                ddBtn.Text=dval.."  ∧"
                            end
                        end)

                        return {Get=function() return dval end}
                    end

                    -- ── ColorPicker ────────────────────────────────────────
                    function Sec:AddColorPicker(cpcfg)
                        local lname = cpcfg.Name    or "ColorPicker"
                        local def   = cpcfg.Default or Color3.fromRGB(100,50,255)
                        local cb    = cpcfg.Callback

                        local H0,S0,V0=Color3.toHSV(def)
                        local H,S,V=H0,S0,V0
                        local pickerOpen=false
                        local pickerFrame=nil

                        local row=makeRow(28)

                        new("TextLabel",{
                            Size=UDim2.new(0.7,0,1,0),
                            BackgroundTransparency=1,
                            Text=lname,
                            TextColor3=TEXT,TextSize=12,
                            Font=Enum.Font.Gotham,
                            TextXAlignment=Enum.TextXAlignment.Left,
                            ZIndex=16,
                        },row)

                        local preview=new("Frame",{
                            Size=UDim2.new(0,24,0,24),
                            Position=UDim2.new(1,-28,0.5,-12),
                            BackgroundColor3=def,
                            BorderSizePixel=0,
                            ZIndex=16,
                        },row)
                        corner(5,preview)

                        local function buildHsvSlider(parent,lbl,yOff,getV,setV,fillCol)
                            local lblEl=new("TextLabel",{
                                Size=UDim2.new(0,12,0,12),
                                Position=UDim2.new(0,0,0,yOff+1),
                                BackgroundTransparency=1,
                                Text=lbl,TextColor3=MUTED,TextSize=9,
                                Font=Enum.Font.GothamBold,ZIndex=20,
                            },parent)
                            local trk=new("Frame",{
                                Size=UDim2.new(1,-52,0,5),
                                Position=UDim2.new(0,16,0,yOff+4),
                                BackgroundColor3=SURFACE2,BorderSizePixel=0,ZIndex=20,
                            },parent)
                            corner(3,trk)
                            local fl=new("Frame",{
                                Size=UDim2.new(getV(),0,1,0),
                                BackgroundColor3=fillCol,BorderSizePixel=0,ZIndex=21,
                            },trk)
                            corner(3,fl)
                            local vLbl=new("TextLabel",{
                                Size=UDim2.new(0,30,0,12),
                                Position=UDim2.new(1,-32,0,yOff),
                                BackgroundTransparency=1,
                                Text=math.floor(getV()*255),
                                TextColor3=MUTED,TextSize=9,Font=Enum.Font.Code,
                                TextXAlignment=Enum.TextXAlignment.Right,ZIndex=20,
                            },parent)

                            local drag2=false
                            trk.InputBegan:Connect(function(i)
                                if i.UserInputType==Enum.UserInputType.MouseButton1 then
                                    drag2=true
                                end
                            end)
                            UserInputService.InputEnded:Connect(function(i)
                                if i.UserInputType==Enum.UserInputType.MouseButton1 then
                                    drag2=false
                                end
                            end)
                            UserInputService.InputChanged:Connect(function(i)
                                if drag2 and i.UserInputType==Enum.UserInputType.MouseMovement then
                                    local rel=math.clamp(
                                        (i.Position.X-trk.AbsolutePosition.X)/trk.AbsoluteSize.X,
                                        0,1)
                                    setV(rel)
                                    fl.Size=UDim2.new(rel,0,1,0)
                                    vLbl.Text=math.floor(rel*255)
                                    local nc=Color3.fromHSV(H,S,V)
                                    preview.BackgroundColor3=nc
                                    def=nc
                                    if cb then cb(nc) end
                                end
                            end)
                        end

                        local openHit=new("TextButton",{
                            Size=UDim2.new(1,0,1,0),
                            BackgroundTransparency=1,Text="",ZIndex=17,
                        },row)

                        openHit.MouseButton1Click:Connect(function()
                            if pickerOpen then
                                if pickerFrame then pickerFrame:Destroy() end
                                pickerFrame=nil
                                pickerOpen=false
                                return
                            end
                            pickerOpen=true

                            pickerFrame=new("Frame",{
                                Size=UDim2.new(1,0,0,110),
                                BackgroundColor3=SURFACE2,
                                BorderSizePixel=0,
                                ZIndex=19,
                                LayoutOrder=itemOrder,
                            },sec)
                            itemOrder=itemOrder+1
                            corner(6,pickerFrame)
                            pad(10,10,8,8,pickerFrame)

                            buildHsvSlider(pickerFrame,"H",0,
                                function() return H end,
                                function(v) H=v end,
                                Color3.fromRGB(180,80,255))
                            buildHsvSlider(pickerFrame,"S",32,
                                function() return S end,
                                function(v) S=v end,
                                Color3.fromRGB(100,180,255))
                            buildHsvSlider(pickerFrame,"V",64,
                                function() return V end,
                                function(v) V=v end,
                                Color3.fromRGB(220,220,220))
                        end)

                        return {
                            Get=function() return def end,
                            Set=function(c)
                                def=c
                                preview.BackgroundColor3=c
                                H,S,V=Color3.toHSV(c)
                            end,
                        }
                    end

                    -- ── Input ──────────────────────────────────────────────
                    function Sec:AddInput(icfg)
                        local lname = icfg.Name        or "Input"
                        local ph    = icfg.Placeholder or "Write here..."
                        local cb    = icfg.Callback

                        local row=makeRow(28)

