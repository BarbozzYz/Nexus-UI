-- ⚠️ Declarado ANTES de create() pra evitar o erro "attempt to index nil with..."
local ThemedProps = { BackgroundColor3 = true, TextColor3 = true, ImageColor3 = true }
Nexus._paints = {}

local function registerThemed(inst, prop, color)
	for key, val in pairs(Theme) do
		if typeof(val) == "Color3" and val == color then
			local list = Nexus._paints[key]
			if not list then
				list = {}
				Nexus._paints[key] = list
			end
			list[#list + 1] = { inst = inst, prop = prop }
		end
	end
end

-- [CORRIGIDO] pcall em Instance.new + validação de nil antes de indexar `inst`
local function create(class, props, children)
	local ok, inst = pcall(Instance.new, class)
	if not ok or not inst then
		warn(("[Nexus] Falha ao criar instância da classe '%s'"):format(tostring(class)))
		return nil
	end
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		else
			local setOk, err = pcall(function()
				inst[k] = v
			end)
			if setOk and ThemedProps[k] and typeof(v) == "Color3" then
				registerThemed(inst, k, v)
			elseif not setOk then
				warn(("[Nexus] Falha ao setar '%s' em '%s': %s"):format(tostring(k), class, tostring(err)))
			end
		end
	end
	for _, child in ipairs(children or {}) do
		if child then
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

-- [CORRIGIDO] essa função estava faltando no arquivo original — causava
-- erro em cascata em qualquer elemento que chamasse tween(...)
local function tween(obj, info, props)
	if not obj then
		return nil
	end
	local ok, t = pcall(function()
		local created = TweenService:Create(obj, info, props)
		created:Play()
		return created
	end)
	if not ok then
		warn("[Nexus] Falha ao criar tween: " .. tostring(t))
		return nil
	end
	return t
end

local function apply(obj, info, props, instant)
	if not obj then
		return nil
	end
	if instant then
		for k, v in pairs(props) do
			pcall(function()
				obj[k] = v
			end)
		end
		return nil
	end
	return tween(obj, info, props)
end

local function corner(obj, radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius or 6), Parent = obj })
end

local function stroke(obj, color, thickness, transparency, mode)
	return create("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = mode or Enum.ApplyStrokeMode.Border,
		Parent = obj,
	})
end

