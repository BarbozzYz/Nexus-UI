function Window:CreatePreview(opts)
	opts = opts or {}
	local popup = self:_createPopup({
		Title = opts.Title or "Window Part Preview",
		Size = opts.Size or Vector2.new(335, 363),
		Slot = 1,
	})
	local viewport = create("ViewportFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(19, 19, 19),
		BorderSizePixel = 0,
		Parent = popup.Body,
	})
	local camera = create("Camera", { FieldOfView = 50, Parent = viewport })
	viewport.CurrentCamera = camera

	local preview = { Popup = popup }
	local subject, center, distance
	local angle = 0
	local conn

	function preview:SetModel(inst)
		if subject then
			subject:Destroy()
			subject = nil
		end
		if not inst then
			return
		end
		subject = inst:Clone()
		subject.Parent = viewport
		local cf, size
		if subject:IsA("Model") then
			cf, size = subject:GetBoundingBox()
		else
			cf, size = subject.CFrame, subject.Size
		end
		center = cf.Position
		distance = (size.Magnitude / 2) / math.tan(math.rad(camera.FieldOfView / 2)) * 1.15
	end

	popup.OnOpen = function()
		if conn then
			conn:Disconnect()
		end
		conn = RunService.RenderStepped:Connect(function(dt)
			if not subject then
				return
			end
			angle = angle + dt * 0.9
			local pos = center + Vector3.new(math.sin(angle) * distance, distance * 0.3, math.cos(angle) * distance)
			camera.CFrame = CFrame.lookAt(pos, center)
		end)
	end
	local function stop()
		if conn then
			conn:Disconnect()
			conn = nil
		end
	end
	popup.OnHide = stop
	popup.Destroying = stop

	function preview:Open()
		popup:Open(self.Window and self.Window:_sidePosition(popup))
	end
	preview.Window = self
	function preview:Close()
		popup:Close()
	end
	function preview:Toggle()
		if popup.IsOpen then
			popup:Close()
		else
			popup:Open(self.Window:_sidePosition(popup))
		end
	end

	return preview
end

