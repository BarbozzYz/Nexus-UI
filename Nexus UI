    create("Frame", {
        Size = UDim2.new(0, 10, 1, 0),
        Position = UDim2.new(1, -10, 0, 0),
        BackgroundColor3 = self.Theme.Sidebar,
        BorderSizePixel = 0,
        Parent = sidebar,
    })
    self.Sidebar = create("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, -60),
        Position = UDim2.new(0, 10, 0, 60),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = self.Theme.Border,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        Parent = sidebar,
    })
    create("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = self.Sidebar,
    })
    
    -- Logo
    create("TextLabel", {
        Size = UDim2.new(1, -20, 0, 30),
        Position = UDim2.new(0, 10, 0, 15),
        BackgroundTransparency = 1,
        Text = "Nexus",
        TextColor3 = self.Theme.Accent,
        TextSize = 22,
        Font = self.Theme.FontBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = sidebar,
    })
    create("TextLabel", {
        Size = UDim2.new(1, -20, 0, 20),
        Position = UDim2.new(0, 10, 0, 42),
        BackgroundTransparency = 1,
        Text = "Lib",
        TextColor3 = self.Theme.Text,
        TextSize = 14,
        Font = self.Theme.FontBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = sidebar,
    })
    
    -- User info no canto inferior
    local userFrame = create("Frame", {
        Size = UDim2.new(1, -20, 0, 40),
        Position = UDim2.new(0, 10, 1, -50),
        BackgroundColor3 = self.Theme.Background,
        BorderSizePixel = 0,
        Parent = sidebar,
    })
    corner(userFrame, 6)
    
    create("Frame", {
        Size = UDim2.new(0, 24, 0, 24),
        Position = UDim2.new(0, 8, 0.5, -12),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Parent = userFrame,
    })
    corner(userFrame:FindFirstChildOfClass("Frame"), 12)
    
    create("TextLabel", {
        Size = UDim2.new(1, -45, 1, 0),
        Position = UDim2.new(0, 40, 0, 0),
        BackgroundTransparency = 1,
        Text = LocalPlayer.Name,
        TextColor3 = self.Theme.Text,
        TextSize = 13,
        Font = self.Theme.Font,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = userFrame,
    })
    
    -- Content area
    local content = create("Frame", {
        Size = UDim2.new(1, -160, 1, -40),
        Position = UDim2.new(0, 160, 0, 40),
        BackgroundTransparency = 1,
        Parent = main,
    })
    self.Content = content
    
    -- Search bar
    local searchFrame = create("Frame", {
        Size = UDim2.new(0.5, -10, 0, 28),
        Position = UDim2.new(0, 10, 0, 8),
        BackgroundColor3 = self.Theme.Element,
        BorderSizePixel = 0,
        Parent = create("Frame", {
            Size = UDim2.new(1, -160, 0, 40),
            Position = UDim2.new(0, 160, 0, 0),
            BackgroundTransparency = 1,
            Parent = main,
        }),
    })
    corner(searchFrame, 6)
    
    create("TextBox", {
        Size = UDim2.new(1, -20, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Text = "",
        PlaceholderText = "Search Bar...",
        PlaceholderColor3 = self.Theme.SubText,
        TextColor3 = self.Theme.Text,
        TextSize = 13,
