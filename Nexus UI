function Nexus:CreateDropdown(parent, name, options, default, callback)
    local frame = create("Frame", {
        Size = UDim2.new(1, -20, 0, 32),
        BackgroundColor3 = self.Theme.Element,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = parent,
    })
    corner(frame, 4)
    
    local header = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundTransparency = 1,
        Text = "",
        Parent = frame,
    })
    
    create("TextLabel", {
        Size = UDim2.new(1, -30, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Text = name .. "  ▾",
        TextColor3 = self.Theme.Text,
        TextSize = 13,
        Font = self.Theme.Font,
        TextXAlignment = Enum.TextXAlignment.Center,
        Parent = header,
    })
    
    local listFrame = create("Frame", {
        Size = UDim2.new(1, 0, 0, #options * 28),
        Position = UDim2.new(0, 0, 0, 32),
        BackgroundTransparency = 1,
        Parent = frame,
    })
    
    local expanded = false
    local selected = default or options[1]
    
    header.MouseButton1Click:Connect(function()
        expanded = not expanded
        tween(frame, { Size = expanded and UDim2.new(1, -20, 0, 32 + #options * 28) or UDim2.new(1, -20, 0, 32) }, 0.2)
    end)
    
    for i, opt in ipairs(options) do
        local optBtn = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 28),
            Position = UDim2.new(0, 0, 0, (i - 1) * 28),
            BackgroundColor3 = self.Theme.Element,
            Text = opt,
            TextColor3 = self.Theme.Text,
            TextSize = 12,
            Font = self.Theme.Font,
            BorderSizePixel = 0,
            Parent = listFrame,
        })
        optBtn.MouseEnter:Connect(function()
            tween(optBtn, { BackgroundColor3 = self.Theme.ElementHover }, 0.1)
        end)
        optBtn.MouseLeave:Connect(function()
            tween(optBtn, { BackgroundColor3 = self.Theme.Element }, 0.1)
        end)
        optBtn.MouseButton1Click:Connect(function()
            selected = opt
            expanded = false
            tween(frame, { Size = UDim2.new(1, -20, 0, 32) }, 0.2)
            callback(opt)
        end)
    end
    
    return frame
end

function Nexus:CreateKeybind(parent, name, default, callback)
    local frame = create("Frame", {
        Size = UDim2.new(1, -20, 0, 30),
        BackgroundTransparency = 1,
        Parent = parent,
    })
    
    create("TextLabel", {
        Size = UDim2.new(0.5, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = self.Theme.Text,
        TextSize = 13,
        Font = self.Theme.Font,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })
    
    local btn = create("TextButton", {
        Size = UDim2.new(0, 80, 0, 24),
        Position = UDim2.new(1, -80, 0.5, -12),
        BackgroundColor3 = self.Theme.Element,
        Text = default or "...",
        TextColor3 = self.Theme.Text,
        TextSize = 12,
        Font = self.Theme.Font,
        BorderSizePixel = 0,
        Parent = frame,
    })
    corner(btn, 4)
    
    local listening = false
    btn.MouseButton1Click:Connect(function()
        listening = true
        btn.Text = "..."
    end)
    
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if listening then
            listening = false
            local key
            if input.UserInputType == Enum.UserInputType.MouseButton1 then key = "MB1"
            elseif input.UserInputType == Enum.UserInputType.MouseButton2 then key = "MB2"
            elseif input.UserInputType == Enum.UserInputType.Keyboard then key = input.KeyCode.Name
            end
            if key then
                btn.Text = key
                callback(key)
            end
        end
    end)
    
    return frame
end

