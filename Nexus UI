-- Sem roda — usa 3 sliders H/S/V + preview
local function createColorPicker(parent, defaultColor, callback)
    local h0,s0,v0 = Color3.toHSV(defaultColor or Color3.fromRGB(100,50,255))
    local H,S,V = h0,s0,v0

    local picker = Instance.new("Frame")
    picker.Size = UDim2.new(1,0,0,110)
    picker.BackgroundColor3 = C.Surface2
    picker.BorderSizePixel = 0
    picker.ZIndex = 10
    picker.Parent = parent
    Instance.new("UICorner",picker).CornerRadius = UDim.new(0,6)

    -- preview
    local preview = Instance.new("Frame")
    preview.Size = UDim2.new(0,28,0,28)
    preview.Position = UDim2.new(1,-36,0,8)
    preview.BackgroundColor3 = Color3.fromHSV(H,S,V)
    preview.BorderSizePixel = 0
    preview.ZIndex = 11
    preview.Parent = picker
    Instance.new("UICorner",preview).CornerRadius = UDim.new(0,5)

    local function buildSlider(label, yPos, getVal, setVal, trackCol)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0,14,0,14)
        lbl.Position = UDim2.new(0,8,0,yPos)
        lbl.BackgroundTransparency=1
        lbl.Text=label
        lbl.TextColor3=C.Muted
        lbl.TextSize=10
        lbl.Font=Enum.Font.GothamBold
        lbl.ZIndex=11
        lbl.Parent=picker

        local track = Instance.new("Frame")
        track.Size = UDim2.new(1,-72,0,6)
        track.Position = UDim2.new(0,24,0,yPos+4)
        track.BackgroundColor3 = C.Surface
        track.BorderSizePixel=0
        track.ZIndex=11
        track.Parent=picker
        Instance.new("UICorner",track).CornerRadius=UDim.new(1,0)

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(getVal(),0,1,0)
        fill.BackgroundColor3 = trackCol
        fill.BorderSizePixel=0
        fill.ZIndex=12
        fill.Parent=track
        Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)

        local thumb = Instance.new("Frame")
        thumb.Size = UDim2.new(0,12,0,12)
        thumb.Position = UDim2.new(getVal(),-6,0,-3)
        thumb.BackgroundColor3 = Color3.fromRGB(220,215,255)
        thumb.BorderSizePixel=0
        thumb.ZIndex=13
        thumb.Parent=track
        Instance.new("UICorner",thumb).CornerRadius=UDim.new(1,0)

        local valLbl = Instance.new("TextLabel")
        valLbl.Size = UDim2.new(0,30,0,14)
        valLbl.Position = UDim2.new(1,-38,0,yPos)
        valLbl.BackgroundTransparency=1
        valLbl.Text=math.floor(getVal()*255)..""
        valLbl.TextColor3=C.Muted
        valLbl.TextSize=10
        valLbl.Font=Enum.Font.Code
        valLbl.TextXAlignment=Enum.TextXAlignment.Right
        valLbl.ZIndex=11
        valLbl.Parent=picker

        local dragging=false
        track.InputBegan:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=true end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then
                local rel=(i.Position.X - track.AbsolutePosition.X)/track.AbsoluteSize.X
                rel=math.clamp(rel,0,1)
                setVal(rel)
                fill.Size=UDim2.new(rel,0,1,0)
                thumb.Position=UDim2.new(rel,-6,0,-3)
                if label=="H" then
                    valLbl.Text=math.floor(rel*360)
                else
                    valLbl.Text=math.floor(rel*255)
                end
                preview.BackgroundColor3=Color3.fromHSV(H,S,V)
                if callback then callback(Color3.fromHSV(H,S,V)) end
            end
        end)
    end

    buildSlider("H",10, function() return H end, function(v) H=v end,
        Color3.fromRGB(180,80,255))
    buildSlider("S",40, function() return S end, function(v) S=v end,
        Color3.fromRGB(100,180,255))
    buildSlider("V",70, function() return V end, function(v) V=v end,
        Color3.fromRGB(220,220,220))

    return picker
end

