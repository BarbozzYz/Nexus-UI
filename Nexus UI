        }
        table.insert(allPages,pageData)

        navHit.MouseButton1Click:Connect(function()
            showPage(pageData)
        end)

        -- hover
        navHit.MouseEnter:Connect(function()
            if currentPageData~=pageData then
                navLabel.TextColor3=TEXT
            end
        end)
        navHit.MouseLeave:Connect(function()
            if currentPageData~=pageData then
                navLabel.TextColor3=MUTED
            end
        end)

        -- auto-select first
        if #allPages==1 then
            task.defer(function() showPage(pageData) end)
        end

        -- ── AddTab ──────────────────────────────────────────────────────────
        function pageData:AddTab(tabName)
            local tname=tabName or "Tab"

            -- botão da tab
            local tbtn=new("TextButton",{
                Size=UDim2.new(0,100,0,32),
                BackgroundColor3=Color3.fromRGB(0,0,0),
                BackgroundTransparency=1,
                Text=tname,
                TextColor3=MUTED,
                TextSize=12,Font=Enum.Font.GothamBold,
                BorderSizePixel=0,
                ZIndex=13,
                AutoButtonColor=false,
            },tabBarFrame)  -- será movido para tabBarFrame quando a page for ativa
            corner(6,tbtn)

            -- underline roxo da tab ativa
            local underline=new("Frame",{
                Size=UDim2.new(0,0,0,2),   -- largura animada
                Position=UDim2.new(0,0,1,-2),
                BackgroundColor3=ACCENT2,
                BorderSizePixel=0,
                Visible=false,
                ZIndex=14,
            },tbtn)

            -- remove do tabBarFrame até a page ser selecionada
            tbtn.Parent=nil
            underline.Parent=nil

            -- frame de conteúdo desta tab (colunas)
            local tabContentFrame=new("Frame",{
                Size=UDim2.new(1,0,1,0),
                BackgroundTransparency=1,
                Visible=false,
                ZIndex=12,
            },pageScroll)

            local colLayout=new("UIListLayout",{
                FillDirection=Enum.FillDirection.Horizontal,
                Padding=UDim.new(0,6),
                VerticalAlignment=Enum.VerticalAlignment.Top,
                SortOrder=Enum.SortOrder.LayoutOrder,
            },tabContentFrame)
            pad(8,8,8,8,tabContentFrame)

            local tabData={
                name=tname,
                frame=tabContentFrame,
                btn=tbtn,
                underline=underline,
                columns={},
            }
            table.insert(pageData.tabs,tabData)

            tbtn.MouseButton1Click:Connect(function()
                showTab(pageData,tabData)
                -- anima underline
                tw(underline,.2,{Size=UDim2.new(1,0,0,2)},Enum.EasingStyle.Quad):Play()
            end)

            -- ── AddColumn ──────────────────────────────────────────────────
            function tabData:AddColumn()
                local colFrame=new("Frame",{
                    Size=UDim2.new(0,240,1,-16),
                    BackgroundTransparency=1,
                    ZIndex=13,
                },tabContentFrame)

                local colList=new("UIListLayout",{
                    Padding=UDim.new(0,6),
                    SortOrder=Enum.SortOrder.LayoutOrder,
                    VerticalAlignment=Enum.VerticalAlignment.Top,
                },colFrame)

                colList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                    -- recalcula canvas do scroll
                    local maxH=0
                    for _,child in ipairs(tabContentFrame:GetChildren()) do
                        if child:IsA("Frame") then
                            local ch=child:FindFirstChildOfClass("UIListLayout")
                            if ch then
                                maxH=math.max(maxH,ch.AbsoluteContentSize.Y+16)
                            end
                        end
                    end
                    pageScroll.CanvasSize=UDim2.new(0,0,0,maxH)
                end)

                local Col={}

                -- ── AddSection ─────────────────────────────────────────────
                function Col:AddSection(sectionName)
                    local sname=sectionName or "Section"

                    local sec=new("Frame",{
                        Size=UDim2.new(1,0,0,38),
                        BackgroundColor3=SURFACE,
                        BorderSizePixel=0,
                        ZIndex=14,
                        ClipsDescendants=false,
                    },colFrame)
                    corner(8,sec)

                    local secInnerLayout=new("UIListLayout",{
                        Padding=UDim.new(0,4),
