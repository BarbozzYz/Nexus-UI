		ZIndex = 4,
		Parent = hueBar,
	})
	corner(hueThumb, 4)
	stroke(hueThumb, Color3.new(1, 1, 1), 2, 0)

	---------------------------------------------------- campos hex / rgb
	local function makeInput(x, w, placeholder)
		local box = create("TextBox", {
			Position = UDim2.fromOffset(x, 246),
			Size = UDim2.fromOffset(w, 30),
			BackgroundColor3 = Theme.Input,
			BorderSizePixel = 0,
			Text = "",
			PlaceholderText = placeholder,
			PlaceholderColor3 = Color3.fromRGB(100, 100, 108),
			TextColor3 = Color3.fromRGB(215, 215, 215),
			Font = Theme.Font,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			ClearTextOnFocus = false,
			Parent = body,
		})
		corner(box, 4)
		create("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 8), Parent = box })
		local s2 = stroke(box, Theme.Accent, 1, 1)
		box.Focused:Connect(function()
			tween(s2, Ease.Fast, { Transparency = 0.2 })
		end)
		box.FocusLost:Connect(function()
			tween(s2, Ease.Fast, { Transparency = 1 })
		end)
		return box
	end
	local hexBox = makeInput(X0, 130, "Hex...")
	local rgbBox = makeInput(X0 + 144, SV_W - 144, "R, G, B")

	---------------------------------------------------- estado
	local function refresh(animate)
		local c = cp.Color
		svHolder.BackgroundColor3 = Color3.fromHSV(cp.H, 1, 1)
		hueThumb.BackgroundColor3 = Color3.fromHSV(cp.H, 1, 1)
		local svPos = UDim2.fromScale(cp.S, 1 - cp.V)
		local huePos = UDim2.new(cp.H, 0, 0.5, 0)
		if animate then
			tween(cursor, Ease.Fast, { Position = svPos })
			tween(hueThumb, Ease.Fast, { Position = huePos })
		else
			cursor.Position = svPos
			hueThumb.Position = huePos
		end
		hexBox.Text = "#" .. string.upper(c:ToHex())
		rgbBox.Text = string.format("%d, %d, %d", math.round(c.R * 255), math.round(c.G * 255), math.round(c.B * 255))
	end

	-- mantem o hue anterior quando a cor e cinza/preta (o hue seria perdido)
	local function setColor(color)
		cp.Color = color
		local h, sat, val = color:ToHSV()
		if sat > 0.001 and val > 0.001 then
			cp.H = h
		end
		cp.S, cp.V = sat, val
	end

	local function commit(color, animate)
		setColor(color)
		refresh(animate)
		if cp.Target then
			cp.Target:Set(color)
		end
	end

	function cp:Sync(color)
		if color == cp.Color then
			return
		end
		setColor(color)
		refresh(true)
	end
	cp.Refresh = refresh

	---------------------------------------------------- arrasto
	local mode, dragConn, lastMouse

	local function update()
		local m = mousePos()
		if m == lastMouse then
			return
		end
		lastMouse = m
		if mode == "sv" then
			local p, sz = svHolder.AbsolutePosition, svHolder.AbsoluteSize
			cp.S = math.clamp((m.X - p.X) / sz.X, 0, 1)
			cp.V = 1 - math.clamp((m.Y - p.Y) / sz.Y, 0, 1)
		elseif mode == "hue" then
			local p, sz = hueBar.AbsolutePosition, hueBar.AbsoluteSize
			cp.H = math.clamp((m.X - p.X) / sz.X, 0, 1)
		else
			return
		end
		cp.Color = Color3.fromHSV(cp.H, cp.S, cp.V)
		refresh(false)
		if cp.Target then
			cp.Target:Set(cp.Color, false, true)
		end
	end

	local function stopDrag()
		mode = nil
		lastMouse = nil
		if dragConn then
			dragConn:Disconnect()
			dragConn = nil
		end
	end

	local function beginDrag(newMode)
		stopDrag()
		mode = newMode
		update()
		dragConn = RunService.RenderStepped:Connect(update)
	end

	svHit.InputBegan:Connect(function(input)
		if isPress(input) then
			beginDrag("sv")
		end
	end)
	hueHit.InputBegan:Connect(function(input)
		if isPress(input) then
			beginDrag("hue")
		end
	end)
	table.insert(self.Connections, UserInputService.InputEnded:Connect(function(input)
		if isPress(input) then
			stopDrag()
		end
	end))
	popup.OnHide = stopDrag

	---------------------------------------------------- hex / rgb digitados
	hexBox.FocusLost:Connect(function()
		local txt = string.gsub(hexBox.Text, "[#%s]", "")
		if #txt == 3 then
			txt = string.gsub(txt, "(%x)", "%1%1")
		end
		if #txt == 6 and string.match(txt, "^%x+$") then
			local ok, color = pcall(Color3.fromHex, txt)
			if ok then
				commit(color, true)
				return
			end
		end
		refresh(false)
	end)

	rgbBox.FocusLost:Connect(function()
		local nums = {}
		for n in string.gmatch(rgbBox.Text, "%d+") do
			nums[#nums + 1] = math.clamp(tonumber(n), 0, 255)
		end
		if #nums >= 3 then
			commit(Color3.fromRGB(nums[1], nums[2], nums[3]), true)
			return
		end
		refresh(false)
	end)

	popup.OnClose = function()
		cp.Target = nil
	end

	self._cp = cp
	return cp
end

function Window:_toggleColorPicker(target)
	local cp = self:_getColorPicker()
	if cp.Popup.IsOpen and cp.Target == target then
		cp.Popup:Close()
		return
	end
	cp.Target = nil
	cp:Sync(target.Value)
	cp.Refresh(false)
	cp.Target = target
	if cp.Popup.IsOpen then
		return
	end
	cp.Popup:Open(self:_sidePosition(cp.Popup))
end

------------------------------------------------------------------ preview (Window Part Preview)

function Window:CreatePreview(opts)
	opts = opts or {}
	local popup = self:_createPopup({
		Title = opts.Title or "Window Part Preview",
		Size = opts.Size or Vector2.new(335, 363),
		Slot = 1,
	})
	local viewport = create("ViewportFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(19, 19, 19),
		BorderSizePixel = 0,
		Parent = popup.Body,
	})
	local camera = create("Camera", { FieldOfView = 50, Parent = viewport })
	viewport.CurrentCamera = camera

	local preview = { Popup = popup }
	local subject, center, distance
	local angle = 0
	local conn

	function preview:SetModel(inst)
		if subject then
			subject:Destroy()
			subject = nil
		end
		if not inst then
			return
		end
		subject = inst:Clone()
		subject.Parent = viewport
		local cf, size
		if subject:IsA("Model") then
			cf, size = subject:GetBoundingBox()
		else
			cf, size = subject.CFrame, subject.Size
		end
		center = cf.Position
		distance = (size.Magnitude / 2) / math.tan(math.rad(camera.FieldOfView / 2)) * 1.15
	end

	popup.OnOpen = function()
		if conn then
			conn:Disconnect()
		end
		conn = RunService.RenderStepped:Connect(function(dt)
			if not subject then
				return
			end
			angle = angle + dt * 0.9
			local pos = center + Vector3.new(math.sin(angle) * distance, distance * 0.3, math.cos(angle) * distance)
			camera.CFrame = CFrame.lookAt(pos, center)
		end)
	end
	local function stop()
		if conn then
			conn:Disconnect()
			conn = nil
		end
	end
	popup.OnHide = stop
	popup.Destroying = stop

	function preview:Open()
		popup:Open(self.Window and self.Window:_sidePosition(popup))
	end
	preview.Window = self
	function preview:Close()
		popup:Close()
	end
	function preview:Toggle()
		if popup.IsOpen then
			popup:Close()
		else
			popup:Open(self.Window:_sidePosition(popup))
		end
	end

	return preview
end

