-- ============================================================
-- UTILS
-- ============================================================
local function create(className, props, children)
    local inst = Instance.new(className)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    for _, c in ipairs(children or {}) do
        c.Parent = inst
    end
    return inst
end

local function corner(parent, radius)
    return create("UICorner", { CornerRadius = UDim.new(0, radius or 6), Parent = parent })
end

local function stroke(parent, color, thickness)
    return create("UIStroke", {
        Color = color or Nexus.Theme.Border,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
end

local function gradient(parent, colorA, colorB, rotation)
    return create("UIGradient", {
        Color = ColorSequence.new(colorA, colorB),
        Rotation = rotation or 0,
        Parent = parent,
    })
end

local function tween(obj, props, time, style, dir)
    local t = TweenService:Create(obj, TweenInfo.new(
        time or 0.15,
        style or Enum.EasingStyle.Quad,
        dir or Enum.EasingDirection.Out
    ), props)
    t:Play()
    return t
end

-- ============================================================
-- NOTIFICATION SYSTEM
-- ============================================================
Nexus.Notifications = {}

function Nexus:Notify(title, text, duration)
    duration = duration or 4
    local gui = self.Gui
    
    local frame = create("Frame", {
        Size = UDim2.new(0, 280, 0, 55),
        Position = UDim2.new(0, -300, 0, 20 + (#self.Notifications * 65)),
        BackgroundColor3 = self.Theme.Panel,
        BorderSizePixel = 0,
        Parent = gui,
    })
    corner(frame, 6)
    stroke(frame, self.Theme.Border)
    
    local accent = create("Frame", {
        Size = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = self.Theme.Accent,
        BorderSizePixel = 0,
        Parent = frame,
    })
    corner(accent, 3)
    
    create("TextLabel", {
        Size = UDim2.new(1, -20, 0, 20),
        Position = UDim2.new(0, 12, 0, 8),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = self.Theme.Text,
        TextSize = 14,
        Font = self.Theme.FontBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })
    
    create("TextLabel", {
        Size = UDim2.new(1, -20, 0, 20),
        Position = UDim2.new(0, 12, 0, 28),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = self.Theme.SubText,
        TextSize = 12,
        Font = self.Theme.Font,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })
    
    table.insert(self.Notifications, frame)
    
    tween(frame, { Position = UDim2.new(0, 20, 0, frame.Position.Y.Offset) }, 0.3)
    
    task.delay(duration, function()
        tween(frame, { Position = UDim2.new(0, -300, 0, frame.Position.Y.Offset) }, 0.3)
        task.wait(0.35)
        local idx = table.find(self.Notifications, frame)
        if idx then table.remove(self.Notifications, idx) end
        frame:Destroy()
        -- Reajusta notificações
        for i, n in ipairs(self.Notifications) do
            tween(n, { Position = UDim2.new(0, 20, 0, 20 + (i - 1) * 65) }, 0.2)
        end
    end)
end

