function Tab:CreateSubTab(cfg)
	if type(cfg) == "string" then cfg = {Title = cfg} end
	cfg = cfg or {}
	local win = self.Window
	local st = setmetatable({Tab = self, Window = win, Title = cfg.Title or "General", Cols = {}, CardList = {}}, SubTab)

	local item = Create("Frame", {Name = st.Title, BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 0, 34), LayoutOrder = #self.SubTabs + 1, Parent = self.SubBar})
	local label = Text({
		Text = st.Title, TextSize = 15, TextColor3 = T.TabIdle, TextXAlignment = Enum.TextXAlignment.Center,
		AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 1, 0), Parent = item,
	})
	Pad(label, 0, 22, 0, 22)
	local hit = Create("TextButton", {Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = item})
	st.LabelObj, st.Item = label, item
	hit.MouseEnter:Connect(function() if self.Current ~= st then Tw(label, 0.15, {TextColor3 = T.TabHover}) end end)
	hit.MouseLeave:Connect(function() if self.Current ~= st then Tw(label, 0.15, {TextColor3 = T.TabIdle}) end end)
	item:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() if self.Current == st then st:_place(false) end end)

	-- pagina com scroll e duas colunas
	local page = Create("ScrollingFrame", {
		Name = st.Title, BackgroundTransparency = 1, Position = UDim2.fromOffset(37, 92), Size = UDim2.new(1, -58, 1, -109),
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 3, ScrollBarImageColor3 = win.Accent,
		ScrollingDirection = Enum.ScrollingDirection.Y, Visible = false, Parent = self.Frame,
	})
	MakeDrag(win, page, win.Root)
	win:Bind(function(c) page.ScrollBarImageColor3 = c end)
	local cols = Create("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = page})
	for i = 1, 2 do
		local f = Create("Frame", {
			Name = "Col" .. i, BackgroundTransparency = 1, Position = UDim2.new(i == 1 and 0 or 0.5, i == 1 and 0 or 6, 0, 0),
			Size = UDim2.new(0.5, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = cols,
		})
		List(f, 12)
		st.Cols[i] = {Frame = f, Cards = {}}
	end
	st.Page = page

	hit.MouseButton1Click:Connect(function() st:Select() end)
	win:Bind(function() if self.Current == st then st:_paint(true) end end)
	table.insert(self.SubTabs, st)
	if #self.SubTabs == 1 then st:Select(true) end
	return st
end

function SubTab:_paint(sel)
	Tw(self.LabelObj, 0.2, {TextColor3 = sel and AccentText(self.Window) or T.TabIdle})
end

-- leva o indicador (pilula com glow) ate esta sub-tab
function SubTab:_place(animate)
	local tab = self.Tab
	local ind, bg, item = tab.SubInd, tab.SubBG, self.Item
	if not item.Parent or item.AbsoluteSize.X <= 0 then return end
	local p = item.AbsolutePosition - bg.AbsolutePosition
	local pos = UDim2.fromOffset(p.X, p.Y)
	local size = UDim2.fromOffset(item.AbsoluteSize.X, item.AbsoluteSize.Y)
	if animate and ind.Visible then
		Tw(ind, 0.28, {Position = pos, Size = size})
	else
		ind.Position, ind.Size = pos, size
	end
	ind.Visible = true
end

function SubTab:Select(first)
	local tab, win = self.Tab, self.Window
	win:_closeDropdown()
	if tab.Current == self and not first then return end
	local hadPrev = tab.Current ~= nil
	if tab.Current then
		tab.Current.Page.Visible = false
		tab.Current:_paint(false)
	end
	tab.Current = self
	self.Page.Visible = true
	self:_paint(true)
	task.spawn(function()
		RunService.Heartbeat:Wait()
		if tab.Current == self then self:_place(hadPrev) end
	end)
	if win.CurrentTab == tab then self:_play() end
end

-- animacao "legos": cada card cai de cima (0.4s) em sequencia
function SubTab:_play()
	for i, card in ipairs(self.CardList) do card:_enter((i - 1) * 0.05) end
end

function SubTab:_fit()
	for _, col in ipairs(self.Cols) do
		for _, c in ipairs(col.Cards) do
			c.Root.Size = UDim2.new(1, 0, 0, (#col.Cards == 1) and self.Window.PageHeight or 0)
		end
	end
end

