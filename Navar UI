local function ColorName(h, s, v)
	if v < 0.15 then return "Black" end
	if s < 0.12 then
		if v > 0.88 then return "White" elseif v > 0.55 then return "Light Gray" end
		return "Gray"
	end
	local d = h * 360
	local name
	if d < 15 or d >= 345 then name = "Red"
	elseif d < 40 then name = "Orange"
	elseif d < 70 then name = "Yellow"
	elseif d < 160 then name = "Green"
	elseif d < 195 then name = "Cyan"
	elseif d < 255 then name = "Blue"
	elseif d < 290 then name = "Purple"
	elseif d < 325 then name = "Magenta"
	else name = "Pink" end
	if name == "Orange" and v < 0.6 then name = "Brown" end
	return name
end

-- Toggle ---------------------------------------------------------------
function Card:CreateToggle(o)
	o = o or {}
	local win = self.Window
	local title = o.Title or "Toggle"
	local area
	if self._lastKind == "Toggle" and self._lastArea and self._lastArea.Parent and not o.Separate then
		area = self._lastArea
	else
		area = self:_newArea()
	end
	self._lastKind, self._lastArea = "Toggle", area

	local row = Create("TextButton", {Name = "Toggle", Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 25), LayoutOrder = self:_next(), Parent = area})
	Text({Text = title, TextSize = 14, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(18, 0), Size = UDim2.new(1, -100, 1, 0), Parent = row})
	local sw = Create("Frame", {BackgroundColor3 = T.SwitchOff, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -25, 0.5, 0), Size = UDim2.fromOffset(34, 18), Parent = row})
	Round(sw)
	Create("UIGradient", {Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(185, 185, 185)), Rotation = 90, Parent = sw})
	local knob = Create("Frame", {BackgroundColor3 = T.Knob, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 2, 0.5, 0), Size = UDim2.fromOffset(14, 14), Parent = sw})
	Round(knob)

	local on = o.State == true
	local OFF_X, ON_X, KW = 2, 18, 14
	local anim
	local function moveKnob(animate)
		local target = on and ON_X or OFF_X
		if anim then anim.Cancel() anim = nil end
		if not animate then
			knob.Position = UDim2.new(0, target, 0.5, 0)
			knob.Size = UDim2.fromOffset(KW, KW)
			return
		end
		local from = knob.Position.X.Offset
		local dir = target > from and 1 or -1
		anim = Anim(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, function(a)
			local x = from + (target - from) * a
			local s = 7 * math.sin(math.pi * a) -- estica para o lado que esta sendo puxado
			knob.Position = UDim2.new(0, dir == 1 and x or x - s, 0.5, 0)
			knob.Size = UDim2.fromOffset(KW + s, KW)
		end, function()
			knob.Position = UDim2.new(0, target, 0.5, 0)
			knob.Size = UDim2.fromOffset(KW, KW)
		end)
	end
	local function paint(animate)
		local col = on and win.Accent or T.SwitchOff
		if animate then Tw(sw, 0.2, {BackgroundColor3 = col}) else sw.BackgroundColor3 = col end
		moveKnob(animate)
	end
	paint(false)
	win:Bind(function(c) if on then sw.BackgroundColor3 = c end end)

	local obj = {}
	function obj:Set(v, silent)
		v = v and true or false
		if v == on then return end
		on = v
		paint(true)
		if not silent then
			win:Log(title .. (on and " Ativado !" or " Desativado !"))
			if o.Callback then task.spawn(o.Callback, on) end
		end
	end
	function obj:Get() return on end
	OnClick(win, row, function() obj:Set(not on) end)
	MakeDrag(win, row, win.Root, 6)

	-- engrenagem: define a tecla que ativa o toggle
	if o.Keybind or o.DefaultKey then
		local gear = Create("TextButton", {Text = "", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -3, 0.5, 0), Size = UDim2.fromOffset(18, 18), Parent = row})
		local gicon = MakeIcon(gear, o.KeybindIcon or "Settings", 14, 14, T.Text)
		local bind = win:_addBind(title, o.DefaultKey, function() obj:Set(not on) end, true)
		gear.MouseButton1Click:Connect(function()
			if win.Listening then return end
			gicon.SetColor(win.Accent, true)
			win:Log(title .. " : pressione uma tecla...")
			win:_listen(function(k)
				bind.Key = k
				gicon.SetColor(T.Text, true)
				win:_refreshKeybinds()
				win:Log(title .. " : " .. KeyName(k))
				if o.KeybindChanged then task.spawn(o.KeybindChanged, k) end
			end)
		end)
		function obj:SetKey(k) bind.Key = k win:_refreshKeybinds() end
	end
	return obj
end

-- Slider ---------------------------------------------------------------
function Card:CreateSlider(o)
	o = o or {}
	local win = self.Window
	local title = o.Title or "Slider"
	local area, row = self:_row(22, "Slider")
	local min, max = o.MinValue or o.Min or 0, o.MaxValue or o.Max or 100
	local inc = o.Increment or 1
	local decimals = 0
	local frac = tostring(inc):match("%.(%d+)")
	if frac then decimals = #frac end
	local fmt = "%." .. decimals .. "f"

	Text({Text = title, TextSize = 14, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(18, 0), Size = UDim2.new(0.285, -22, 1, 0), Parent = row})
	local track = Create("Frame", {BackgroundColor3 = T.Track, Position = UDim2.new(0.285, 0, 0.5, -3), Size = UDim2.new(0.53, 0, 0, 6), Parent = row})
	Round(track)
	local fill = Create("Frame", {BackgroundColor3 = win.Accent, Size = UDim2.fromScale(0, 1), Parent = track})
	Round(fill)
	win:Bind(function(c) fill.BackgroundColor3 = c end)
	local valueLabel = Text({TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -22, 0, 0), Size = UDim2.fromOffset(46, 22), Parent = row})
	local hit = Create("TextButton", {Text = "", BackgroundTransparency = 1, Size = UDim2.new(0.815, 0, 1, 0), ZIndex = 3, Parent = row})

	local value = math.clamp(o.Default or o.Value or min, min, max)
	local function render()
		valueLabel.Text = string.format(fmt, value)
		Tw(fill, 0.08, {Size = UDim2.fromScale((max > min) and (value - min) / (max - min) or 0, 1)}, Enum.EasingStyle.Quad)
	end
	render()

	local obj = {}
	function obj:Set(v, silent)
		v = math.clamp(math.floor((v - min) / inc + 0.5) * inc + min, min, max)
		if v == value then return end
		value = v
		render()
		if not silent then
			win:Log(title .. " : " .. string.format(fmt, value))
			if o.Callback then task.spawn(o.Callback, value) end
		end
	end
	function obj:Get() return value end

	local dragging = false
	local function update()
		local x = MousePos().X
		local r = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		obj:Set(min + (max - min) * r)
	end
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			update()
		end
	end)
	win:_c(UserInputService.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then update() end
	end))
	win:_c(UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end))
	return obj
end

