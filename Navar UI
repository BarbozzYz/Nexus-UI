----------------------------------------------------------------------
-- Utilidades
----------------------------------------------------------------------
local function Create(class, props, children)
	local obj = Instance.new(class)
	if obj:IsA("GuiObject") then obj.BorderSizePixel = 0 end
	if obj:IsA("GuiButton") then obj.AutoButtonColor = false end
	local parent
	if props then
		for k, v in pairs(props) do
			if k == "Parent" then parent = v else obj[k] = v end
		end
	end
	if children then for _, c in ipairs(children) do c.Parent = obj end end
	if parent then obj.Parent = parent end
	return obj
end

local function Corner(p, r) return Create("UICorner", {CornerRadius = UDim.new(0, r), Parent = p}) end
local function Round(p) return Create("UICorner", {CornerRadius = UDim.new(0.5, 0), Parent = p}) end
local function Stroke(p, color, th, tr)
	return Create("UIStroke", {Color = color, Thickness = th or 1, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = p})
end
local function Grad(p, a, b, rot)
	return Create("UIGradient", {Color = ColorSequence.new(a, b), Rotation = rot or 90, Parent = p})
end
local function Pad(p, t, r, b, l)
	return Create("UIPadding", {PaddingTop = UDim.new(0, t), PaddingRight = UDim.new(0, r), PaddingBottom = UDim.new(0, b), PaddingLeft = UDim.new(0, l), Parent = p})
end
local function List(p, gap, dir)
	return Create("UIListLayout", {Padding = UDim.new(0, gap or 0), FillDirection = dir or Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder, Parent = p})
end

local function Text(props)
	local d = {
		BackgroundTransparency = 1, FontFace = Navar.Fonts.Main, TextSize = 14, TextColor3 = T.Text,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center, Text = "",
	}
	for k, v in pairs(props) do d[k] = v end
	return Create("TextLabel", d)
end

local function Tw(obj, t, props, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

-- anima um valor 0..1 chamando step(alpha)
local function Anim(t, style, dir, step, done)
	local v = Instance.new("NumberValue")
	local tw = TweenService:Create(v, TweenInfo.new(t, style, dir), {Value = 1})
	local conn = v.Changed:Connect(step)
	tw.Completed:Connect(function(state)
		conn:Disconnect()
		v:Destroy()
		if done and state == Enum.PlaybackState.Completed then done() end
	end)
	tw:Play()
	return {Cancel = function() conn:Disconnect() tw:Cancel() end}
end

local function Viewport()
	local cam = workspace.CurrentCamera
	return cam and cam.ViewportSize or Vector2.new(1920, 1080)
end

local function Inside(obj, pos, margin)
	margin = margin or 0
	local p, s = obj.AbsolutePosition, obj.AbsoluteSize
	return pos.X >= p.X - margin and pos.X <= p.X + s.X + margin and pos.Y >= p.Y - margin and pos.Y <= p.Y + s.Y + margin
end

local function ParseColor(v)
	if typeof(v) == "Color3" then return v end
	if type(v) == "string" then
		if v:lower() == "menu" then return T.Accent end -- "menu" = cor principal padrao do menu
		local h = v:gsub("#", "")
		if #h == 6 and h:match("^%x+$") then return Color3.fromHex("#" .. h) end
		if #h == 3 and h:match("^%x+$") then
			return Color3.fromHex("#" .. h:sub(1, 1):rep(2) .. h:sub(2, 2):rep(2) .. h:sub(3, 3):rep(2))
		end
	end
	return nil
end

-- Navar:SetTheme({Menu = "#101010", Text = "#EEEEEE"}) ANTES de CreateWindow
function Navar:SetTheme(tbl)
	for k, v in pairs(tbl) do
		local c = ParseColor(v)
		if c then T[k] = c end
	end
end

local function ParseSize(v)
	if typeof(v) == "Vector2" then return v end
	if typeof(v) == "UDim2" then return Vector2.new(v.X.Offset, v.Y.Offset) end
	if type(v) == "table" then return Vector2.new(v[1] or 953, v[2] or 585) end
	if type(v) == "string" then
		local a, b = v:match("([%d%.]+)%s*,%s*([%d%.]+)")
		if a and b then return Vector2.new(tonumber(a), tonumber(b)) end
	end
	return nil
end

local function InputKey(i)
	if i.UserInputType == Enum.UserInputType.Keyboard then return i.KeyCode end
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.MouseButton2 then
		return i.UserInputType
	end
	return nil
end

local function KeyName(k)
	if k == nil then return "None" end
	if k == Enum.UserInputType.MouseButton1 then return "M1" end
	if k == Enum.UserInputType.MouseButton2 then return "M2" end
	return k.Name
end

----------------------------------------------------------------------
-- Icones (registro + provider; sem asset confiavel embutido)
----------------------------------------------------------------------
local function ResolveIcon(name)
	if name == nil or name == "" then return nil end
	if type(name) == "number" then return {Image = "rbxassetid://" .. name} end
	if type(name) == "table" then return name end
	if type(name) ~= "string" then return nil end
	if name:match("^%d+$") then return {Image = "rbxassetid://" .. name} end
	if name:find("rbxassetid://", 1, true) or name:find("rbxasset://", 1, true) then return {Image = name} end
	local reg = Navar.Icons[name] or Navar.Icons[name:lower()]
	if reg ~= nil then
		if type(reg) == "number" then return {Image = "rbxassetid://" .. reg} end
		if type(reg) == "string" then return {Image = reg:match("^%d+$") and ("rbxassetid://" .. reg) or reg} end
		return reg
	end
	if Navar.IconProvider then
		local ok, res = pcall(Navar.IconProvider, name)
		if ok and type(res) == "table" then return res end
	end
	return nil
end

-- cria icone (imagem se existir; senao a bolinha usada nas imagens). Retorna objeto com SetColor
local function MakeIcon(parent, name, circlePx, imagePx, color)
	local info = ResolveIcon(name)
	local obj
	if info and info.Image then
		obj = Create("ImageLabel", {
			BackgroundTransparency = 1, Image = info.Image, ImageColor3 = color, AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(imagePx, imagePx), Parent = parent,
		})
		if info.RectOffset then
			obj.ImageRectOffset = info.RectOffset
			obj.ImageRectSize = info.RectSize
		end
	else
		obj = Create("Frame", {
			BackgroundColor3 = color, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(circlePx, circlePx), Parent = parent,
		})
		Round(obj)
	end
	local icon = {Obj = obj, IsImage = info ~= nil and info.Image ~= nil}
	function icon.SetColor(c, animate)
		local prop = obj:IsA("ImageLabel") and "ImageColor3" or "BackgroundColor3"
		if animate then Tw(obj, 0.2, {[prop] = c}) else obj[prop] = c end
	end
	return icon
end

