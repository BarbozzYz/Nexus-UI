----------------------------------------------------------------------
-- Janela do ColorPicker (separada, fade, Enter/clique fora fecha)
----------------------------------------------------------------------
function Window:_buildPicker()
	local win = self
	local W, H = 460, 420
	local P = {Open = false}
	self.Picker = P
	local root = Create("CanvasGroup", {
		Name = "ColorPicker", BackgroundColor3 = T.Menu, Size = UDim2.fromOffset(W, H), Visible = false, GroupTransparency = 1, Parent = State.Windows,
	})
	Corner(root, 8)
	P.Root = root
	self.PickerRoot = root
	local top = Create("Frame", {BackgroundColor3 = win.Accent, Active = true, Size = UDim2.new(1, 0, 0, 34), Parent = root})
	win:Bind(function(c) top.BackgroundColor3 = c end)
	Text({Text = "ColorPicker", FontFace = Navar.Fonts.Mono, TextSize = 15, Position = UDim2.fromOffset(18, 0), Size = UDim2.new(1, -36, 1, 0), Parent = top})
	MakeDrag(win, top, root)

	local state = {h = 0, s = 1, v = 1}
	local sv = Create("Frame", {BackgroundColor3 = Color3.fromHSV(0, 1, 1), Position = UDim2.new(0.5, -170, 0, 52), Size = UDim2.fromOffset(340, 230), Parent = root})
	Corner(sv, 8)
	local white = Create("Frame", {BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromScale(1, 1), Parent = sv})
	Corner(white, 8)
	Create("UIGradient", {Rotation = 0, Transparency = NumberSequence.new(0, 1), Parent = white})
	local black = Create("Frame", {BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.fromScale(1, 1), Parent = sv})
	Corner(black, 8)
	Create("UIGradient", {Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = black})
	local svHit = Create("TextButton", {Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = sv})
	local ring = Create("Frame", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(16, 16), ZIndex = 6, Parent = sv})
	Round(ring)
	Stroke(ring, T.Ring, 3, 0)

	local hue = Create("Frame", {BackgroundColor3 = Color3.new(1, 1, 1), Position = UDim2.new(0.5, -170, 0, 296), Size = UDim2.fromOffset(340, 14), Parent = root})
	Corner(hue, 7)
	local keys = {}
	for i = 0, 6 do table.insert(keys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(math.min(i / 6, 0.9999), 1, 1))) end
	Create("UIGradient", {Color = ColorSequence.new(keys), Parent = hue})
	local hueHit = Create("TextButton", {Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = hue})
	local hring = Create("Frame", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(18, 18), ZIndex = 6, Parent = hue})
	Round(hring)
	Stroke(hring, T.Ring, 3, 0)

	local function MakeBox(x, ph)
		local b = Create("Frame", {BackgroundColor3 = T.InputBg, Position = UDim2.new(x, 0, 0, 332), Size = UDim2.new(0.4, 0, 0, 32), Parent = root})
		Corner(b, 4)
		local st = Stroke(b, win.Accent, 1, 0.35)
		win:Bind(function(c) st.Color = c end)
		return Create("TextBox", {
			BackgroundTransparency = 1, ClearTextOnFocus = false, PlaceholderText = ph, PlaceholderColor3 = T.InputPlaceholder, Text = "",
			TextColor3 = T.Text, FontFace = Navar.Fonts.Mono, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0), Parent = b,
		})
	end
	local hexBox, rgbBox = MakeBox(0.09, "Hex"), MakeBox(0.51, "R, G, B")
	local nameLabel = Text({Text = "Color: Red", FontFace = Navar.Fonts.Mono, TextSize = 14, Position = UDim2.new(0, 18, 1, -34), Size = UDim2.new(0.5, 0, 0, 20), Parent = root})
	Text({Text = CREDIT, FontFace = Navar.Fonts.Mono, TextSize = 11, TextColor3 = T.Credit, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -18, 1, -32), Size = UDim2.new(0.5, 0, 0, 16), Parent = root})

	local ringTarget = Vector2.new(1, 0)
	local ringPos = ringTarget
	local function current() return Color3.fromHSV(state.h, state.s, state.v) end
	local function refresh()
		local c = current()
		sv.BackgroundColor3 = Color3.fromHSV(state.h, 1, 1)
		ringTarget = Vector2.new(state.s, 1 - state.v)
		hring.Position = UDim2.new(state.h, 0, 0.5, 0)
		nameLabel.Text = "Color: " .. ColorName(state.h, state.s, state.v)
		nameLabel.TextColor3 = c
		local r, g, b = math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)
		if not hexBox:IsFocused() then hexBox.Text = string.format("#%02X%02X%02X", r, g, b) end
		if not rgbBox:IsFocused() then rgbBox.Text = string.format("%d, %d, %d", r, g, b) end
		if P.cb then P.cb(c) end
	end
	function P.Set(c)
		state.h, state.s, state.v = c:ToHSV()
		refresh()
		ringPos = ringTarget
		ring.Position = UDim2.fromScale(ringPos.X, ringPos.Y)
	end

	local function pickSV()
		local m = MousePos()
		local ns = math.clamp((m.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
		local nv = 1 - math.clamp((m.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
		if ns == state.s and nv == state.v then return end
		state.s, state.v = ns, nv
		refresh()
	end
	local function pickHue()
		local m = MousePos()
		local nh = math.clamp((m.X - hue.AbsolutePosition.X) / math.max(hue.AbsoluteSize.X, 1), 0, 0.9999)
		if nh == state.h then return end
		state.h = nh
		refresh()
	end
	local svDrag, hueDrag = false, false
	local travel = 0
	svHit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			svDrag = true
			pickSV()
			-- clique longe do picker: viaja rapido ate la; depois disso gruda no mouse sem atraso
			travel = ((ringTarget - ringPos).Magnitude > 0.15) and 0.12 or 0
		end
	end)
	hueHit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then hueDrag = true pickHue() end
	end)
	win:_c(UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then svDrag, hueDrag = false, false end
	end))

	-- atualiza no mesmo frame do cursor (RenderStepped): o aro fica exatamente embaixo do mouse
	win:_c(RunService.RenderStepped:Connect(function(dt)
		if not P.Open then return end
		if svDrag then pickSV() elseif hueDrag then pickHue() end
		if svDrag and travel <= 0 then
			ringPos = ringTarget
		else
			if travel > 0 then travel = travel - dt end
			ringPos = ringPos:Lerp(ringTarget, 1 - math.exp(-dt * (svDrag and 40 or 26)))
		end
		ring.Position = UDim2.fromScale(ringPos.X, ringPos.Y)
	end))

	hexBox.FocusLost:Connect(function()
		local c = ParseColor(hexBox.Text)
		if c then state.h, state.s, state.v = c:ToHSV() end
		refresh()
	end)
	rgbBox.FocusLost:Connect(function()
		local r, g, b = rgbBox.Text:match("(%d+)[,%s]+(%d+)[,%s]+(%d+)")
		if r then
			local c = Color3.fromRGB(math.clamp(tonumber(r), 0, 255), math.clamp(tonumber(g), 0, 255), math.clamp(tonumber(b), 0, 255))
			state.h, state.s, state.v = c:ToHSV()
		end
		refresh()
	end)

	win:_c(UserInputService.InputBegan:Connect(function(i)
		if not P.Open then return end
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			local m = MousePos()
			if not Inside(root, m) and not (P.row and Inside(P.row, m)) then win:_closePicker() end
		elseif (i.KeyCode == Enum.KeyCode.Return or i.KeyCode == Enum.KeyCode.KeypadEnter) and not UserInputService:GetFocusedTextBox() then
			win:_closePicker()
		end
	end))
end

function Window:_openPicker(owner, color, cb, row)
	if not self.Picker then self:_buildPicker() end
	local P = self.Picker
	P.cb = nil
	P.owner, P.row = owner, row
	P.Set(color)
	P.cb = cb
	if not P.Placed then
		local vp, mp, ms = Viewport(), self.Root.AbsolutePosition, self.Root.AbsoluteSize
		local x = mp.X + ms.X + 16
		if x + 460 > vp.X - 10 then x = mp.X - 460 - 16 end
		x = math.clamp(x, 0, math.max(0, vp.X - 460))
		local y = math.clamp(mp.Y + (ms.Y - 420) / 2, 0, math.max(0, vp.Y - 420))
		local o = State.Windows.AbsolutePosition -- janela do picker fica ATRAS do menu principal
		P.Root.Position = UDim2.fromOffset(x - o.X, y - o.Y)
		P.Placed = true
	end
	P.Open = true
	P.Root.Visible = true
	Tw(P.Root, 0.2, {GroupTransparency = 0})
end

function Window:_closePicker(instant)
	local P = self.Picker
	if not P or not P.Open then return end
	P.Open = false
	P.owner, P.cb = nil, nil
	if instant then
		P.Root.Visible = false
		P.Root.GroupTransparency = 1
	else
		Tw(P.Root, 0.2, {GroupTransparency = 1}) -- fade ao sumir
		task.delay(0.22, function() if not P.Open then P.Root.Visible = false end end)
	end
end

----------------------------------------------------------------------
-- Window Preview (2D frente / 3D girando e arrastavel)
----------------------------------------------------------------------
function Window:CreatePreview(cfg)
	cfg = cfg or {}
	if self.PreviewObj then return self.PreviewObj end
	local win = self
	local W, H = 420, 400
	local f = Create("Frame", {
		Name = "WindowPreview", BackgroundColor3 = T.Menu, Active = true, Size = UDim2.fromOffset(W, H),
		Position = UDim2.fromOffset(cfg.X or 24, cfg.Y or 90), Visible = false, Parent = State.Windows,
	})
	Corner(f, 8)
	local top = Create("Frame", {BackgroundColor3 = win.Accent, Size = UDim2.new(1, 0, 0, 34), Parent = f})
	Corner(top, 8)
	local patch = Create("Frame", {BackgroundColor3 = win.Accent, Position = UDim2.new(0, 0, 1, -8), Size = UDim2.new(1, 0, 0, 8), Parent = top})
	win:Bind(function(c) top.BackgroundColor3 = c patch.BackgroundColor3 = c end)
	Text({Text = cfg.Title or "Window", FontFace = Navar.Fonts.Mono, TextSize = 15, Position = UDim2.fromOffset(18, 0), Size = UDim2.new(1, -36, 1, 0), Parent = top})
	-- (sem drag: a janela fica sempre grudada na direita do menu)

	local vp = Create("ViewportFrame", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 1, -68),
		Ambient = Color3.fromRGB(190, 190, 190), LightColor = Color3.new(1, 1, 1), Parent = f,
	})
	local cam = Create("Camera", {FieldOfView = 35, CFrame = CFrame.lookAt(Vector3.new(0, 0.4, -12), Vector3.new(0, 0.2, 0)), Parent = vp})
	vp.CurrentCamera = cam
	Text({Text = CREDIT, FontFace = Navar.Fonts.Mono, TextSize = 11, TextColor3 = T.Credit, Position = UDim2.new(0, 14, 1, -28), Size = UDim2.fromOffset(200, 20), Parent = f})
	local modeBtn = GradBox(f, {
		Size = UDim2.fromOffset(70, 22), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, -10), Height = 22,
		Top = win.Accent, Bottom = T.ButtonDark, Text = "2D", TextSize = 12, Font = Navar.Fonts.Mono, Radius = 4,
	})
	win:Bind(function(c) modeBtn.SetColors(c, T.ButtonDark) end)

	-- sempre ao lado direito do menu principal, com um espaco
	local gap = cfg.Gap or 12
	do -- ao abrir, centraliza o conjunto menu + preview na tela
		local r = win.Root
		local nx = math.max(10, r.Position.X.Offset - (W + gap) / 2)
		r.Position = UDim2.fromOffset(nx, r.Position.Y.Offset)
	end
	local function attach()
		local r = win.Root
		f.Position = UDim2.fromOffset(r.Position.X.Offset + r.AbsoluteSize.X + gap, r.Position.Y.Offset)
		f.Size = UDim2.fromOffset(W, r.AbsoluteSize.Y) -- sempre a mesma altura do menu
	end
	attach()
	win:_c(RunService.RenderStepped:Connect(attach))

	local model
	local mode, angle, dragging = "2D", 0, false
	local function rebuild()
		if model then model:Destroy() model = nil end
		local char = LocalPlayer.Character
		if not char or not char:FindFirstChild("HumanoidRootPart") then return end
		char.Archivable = true
		local ok, clone = pcall(function() return char:Clone() end)
		if not ok or not clone then return end
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") then d:Destroy() end
		end
		local hum = clone:FindFirstChildOfClass("Humanoid")
		if hum then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
		clone.Parent = vp
		clone:PivotTo(CFrame.new(0, 0, 0))
		model = clone
	end
	win:_c(LocalPlayer.CharacterAdded:Connect(function() task.wait(1) rebuild() end))

	modeBtn.Button.MouseButton1Click:Connect(function()
		mode = (mode == "2D") and "3D" or "2D"
		modeBtn.Label.Text = mode
		if mode == "2D" then angle = (angle + math.pi) % (2 * math.pi) - math.pi end
	end)
	win:_c(RunService.RenderStepped:Connect(function(dt)
		if not f.Visible or not model or not model.Parent then return end
		if mode == "3D" then
			if not dragging then angle = angle + dt * 0.8 end
		else
			angle = angle * (1 - math.min(1, dt * 10))
		end
		model:PivotTo(CFrame.Angles(0, angle, 0))
	end))
	win:_c(UserInputService.InputBegan:Connect(function(i)
		if mode == "3D" and f.Visible and i.UserInputType == Enum.UserInputType.MouseButton1 and Inside(vp, MousePos(), 30) then
			dragging = true
		end
	end))
	win:_c(UserInputService.InputChanged:Connect(function(i)
		if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then angle = angle - i.Delta.X * 0.012 end
	end))
	win:_c(UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
	end))

	local obj = {Frame = f, Wanted = cfg.Visible ~= false}
	function obj:_sync() f.Visible = self.Wanted and win.Visible end
	function obj:SetVisible(v) self.Wanted = v self:_sync() end
	function obj:SetMode(m) if m == "2D" or m == "3D" then mode = m modeBtn.Label.Text = m end end
	function obj:Refresh() rebuild() end
	rebuild()
	self.PreviewObj, self.PreviewFrame = obj, f
	obj:_sync()
	return obj
end

function Window:SetPreviewVisible(v)
	if v and not self.PreviewObj then self:CreatePreview({}) end
	if self.PreviewObj then self.PreviewObj:SetVisible(v) end
end

return Navar
