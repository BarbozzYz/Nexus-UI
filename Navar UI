		Top = T.GrayTop, Bottom = T.GrayBottom, Radius = 5,
	})
	local stroke = Stroke(box.Button, win.Accent, 1, 1)
	win:Bind(function(c) stroke.Color = c end)
	local tb = Create("TextBox", {
		BackgroundTransparency = 1, ClearTextOnFocus = false, Text = o.Default or "", PlaceholderText = o.Placeholder or "Write here...",
		PlaceholderColor3 = T.Placeholder, TextColor3 = T.Text, FontFace = Navar.Fonts.Main, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4, Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -16, 1, 0), Parent = box.Button,
	})
	tb.MouseEnter:Connect(function() box.SetHover(true) end)
	tb.MouseLeave:Connect(function() box.SetHover(false) end)
	-- clicar em qualquer ponto da barra foca o campo; clicar fora tira o foco e salva (comportamento nativo do TextBox)
	box.Button.MouseButton1Click:Connect(function() tb:CaptureFocus() end)
	tb.Focused:Connect(function() Tw(stroke, 0.15, {Transparency = 0.5}) end)
	tb:GetPropertyChangedSignal("Text"):Connect(function()
		if o.Numeric then
			local clean = tb.Text:gsub("[^%d%.%-]", "")
			if clean ~= tb.Text then tb.Text = clean return end
		end
		stroke.Transparency = 0.1 -- pulso a cada letra digitada
		Tw(stroke, 0.25, {Transparency = tb:IsFocused() and 0.5 or 1})
	end)
	tb.FocusLost:Connect(function()
		Tw(stroke, 0.2, {Transparency = 1})
		win:Log(title .. " : " .. tb.Text)
		if o.Callback then task.spawn(o.Callback, tb.Text) end
	end)
	local obj = {}
	function obj:Set(v) tb.Text = tostring(v) end
	function obj:Get() return tb.Text end
	return obj
end

