function Window:AddTab(name, icon)
    local tab = {
        Name = name,
        Icon = icon or "dashboard",
        Cards = {},
        SubTabs = {},
        CurrentSubTab = nil,
        Active = false,
    }

    local Button = Create("TextButton", {
        Size = UDim2.new(1, -20, 0, 30),
        Position = UDim2.fromOffset(10, 10 + (#self.Tabs * 34)),
        BackgroundTransparency = 1,
        Text = "",
        BorderSizePixel = 0,
        Parent = self.Sidebar,
    })
    Corner(Button, 6)

    local IconLabel = Create("TextLabel", {
        Size = UDim2.fromOffset(24, 30),
        Position = UDim2.fromOffset(8, 0),
        BackgroundTransparency = 1,
        Text = "●",
        TextColor3 = Theme.TabUnselected,
        TextSize = 14,
        Font = Enum.Font.GothamBold,
        Parent = Button,
    })

    local TextLabel = Create("TextLabel", {
        Size = UDim2.new(1, -40, 1, 0),
        Position = UDim2.fromOffset(35, 0),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = Theme.TabUnselected,
        TextSize = 13,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Button,
    })

    local Indicator = Create("Frame", {
        Size = UDim2.fromOffset(3, 20),
        Position = UDim2.new(1, -5, 0.5, -10),
        BackgroundColor3 = self.Accent,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = Button,
    })
    Corner(Indicator, 2)

    tab.Button = Button
    tab.Indicator = Indicator
    tab.IconLabel = IconLabel
    tab.TextLabel = TextLabel

    -- Conteúdo
    local ContentFrame = Create("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = self.Accent,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        Parent = self.Content,
    })
    tab.ContentFrame = ContentFrame

    Button.MouseEnter:Connect(function()
        if self.CurrentTab ~= tab then
            Tween(TextLabel, { TextColor3 = Color3.fromRGB(180, 180, 180) }, 0.15)
            Tween(IconLabel, { TextColor3 = Color3.fromRGB(180, 180, 180) }, 0.15)
        end
    end)
    Button.MouseLeave:Connect(function()
        if self.CurrentTab ~= tab then
            Tween(TextLabel, { TextColor3 = Theme.TabUnselected }, 0.15)
            Tween(IconLabel, { TextColor3 = Theme.TabUnselected }, 0.15)
        end
    end)

    Button.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    table.insert(self.Tabs, tab)
    if #self.Tabs == 1 then
        task.defer(function() self:SelectTab(tab) end)
    end
    return tab
end

function Window:SelectTab(tab)
    if self.CurrentTab == tab then return end
    
    for _, t in ipairs(self.Tabs) do
        t.ContentFrame.Visible = false
        t.Active = false
        Tween(t.TextLabel, { TextColor3 = Theme.TabUnselected }, 0.2)
        Tween(t.IconLabel, { TextColor3 = Theme.TabUnselected }, 0.2)
        Tween(t.Indicator, { BackgroundTransparency = 1 }, 0.15)
    end

    tab.ContentFrame.Visible = true
    tab.Active = true
    Tween(tab.TextLabel, { TextColor3 = self.Accent }, 0.25)
    Tween(tab.IconLabel, { TextColor3 = self.Accent }, 0.25)
    Tween(tab.Indicator, { BackgroundTransparency = 0 }, 0.15)

    self.CurrentTab = tab
    self:_log("Tab: " .. tab.Name)
end

