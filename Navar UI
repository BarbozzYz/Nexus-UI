-- Dropdown -------------------------------------------------------------
function Card:CreateDropdown(o)
	o = o or {}
	local win = self.Window
	local title = o.Title or "Dropdown"
	local items = o.Items or o.Options or {}
	local selected = o.Default or items[1]
	local area, row = self:_row(24, "Dropdown")
	Text({Text = title, TextSize = 14, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(18, 0), Size = UDim2.new(1, -190, 1, 0), Parent = row})
	local hitRow = Create("TextButton", {Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = row})
	local box = GradBox(row, {
		Size = UDim2.fromOffset(157, 24), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -25, 0.5, 0), Height = 24,
		Top = T.GrayTop, Bottom = T.GrayBottom, Text = tostring(selected or ""), TextSize = 13, Radius = 5,
	})
	box.Label.TextXAlignment = Enum.TextXAlignment.Left
	box.Label.TextTruncate = Enum.TextTruncate.AtEnd
	box.Label.Position = UDim2.fromOffset(10, 0)
	box.Label.Size = UDim2.new(1, -34, 1, 0)
	local chev = Chevron(box.Button, T.Text)
	chev.Position = UDim2.new(1, -16, 0.5, 0)
	chev.ZIndex = 4

	local open, clip, panel, outConn = false, nil, nil, nil
	local closeFn
	local function close(instant)
		if not open then return end
		open = false
		Tw(chev, 0.2, {Rotation = 0})
		if outConn then outConn:Disconnect() outConn = nil end
		if win.CloseDropdown == closeFn then win.CloseDropdown = nil end
		local c = clip
		clip, panel = nil, nil
		if c then
			if instant then
				c:Destroy()
			else
				Tw(c, 0.2, {Size = UDim2.fromOffset(0, 0)}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				task.delay(0.22, function() c:Destroy() end)
			end
		end
	end
	closeFn = function() close() end

	local obj = {}
	function obj:Set(v, silent)
		selected = v
		box.Label.Text = tostring(v)
		if not silent then
			win:Log(title .. " : " .. tostring(v))
			if o.Callback then task.spawn(o.Callback, v) end
		end
	end
	function obj:Get() return selected end
	function obj:SetItems(list) items = list end

	local function openList()
		win:_closeDropdown()
		open = true
		win.CloseDropdown = closeFn
		Tw(chev, 0.2, {Rotation = 180})
		local btn = box.Button
		local bw = btn.AbsoluteSize.X
		local itemH, gap, pad = 26, 4, 5
		local visible = math.min(#items, 6)
		local listH = visible * itemH + math.max(visible - 1, 0) * gap + pad * 2
		local pos = btn.AbsolutePosition - State.Overlay.AbsolutePosition
		local y = pos.Y + btn.AbsoluteSize.Y + 4 -- sempre ABAIXO da caixa
		clip = Create("Frame", {
			Name = "DropdownClip", BackgroundTransparency = 1, ClipsDescendants = true,
			Position = UDim2.fromOffset(pos.X, y), Size = UDim2.fromOffset(0, 0), Parent = State.Overlay,
		})
		panel = Create("ScrollingFrame", {
			BackgroundColor3 = T.Popup, Size = UDim2.fromOffset(bw, listH), CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 2, ScrollBarImageColor3 = win.Accent, Parent = clip,
		})
		Corner(panel, 8)
		Stroke(panel, T.Outline, 1, 0)
		Pad(panel, pad, pad, pad, pad)
		List(panel, gap)
		for i, name in ipairs(items) do
			local b = Create("TextButton", {
				Text = tostring(name), BackgroundColor3 = T.DropdownItem, FontFace = Navar.Fonts.Main, TextSize = 13,
				TextColor3 = (name == selected) and AccentText(win) or T.Text, TextXAlignment = Enum.TextXAlignment.Left,
				Size = UDim2.new(1, 0, 0, itemH), LayoutOrder = i, Parent = panel,
			})
			Corner(b, 6)
			Pad(b, 0, 0, 0, 10)
			b.MouseButton1Click:Connect(function()
				obj:Set(name)
				close()
			end)
		end
		Tw(clip, 0.25, {Size = UDim2.fromOffset(bw, listH)}, Enum.EasingStyle.Quad) -- "folheando" do canto superior esquerdo ao inferior direito
		local thePanel = panel
		outConn = UserInputService.InputBegan:Connect(function(i)
			if i.UserInputType ~= Enum.UserInputType.MouseButton1 or not thePanel or not thePanel.Parent then return end
			local m = MousePos()
			if not Inside(thePanel, m) and not Inside(row, m) then close() end
		end)
	end
	local function toggle() if open then close() else openList() end end
	OnClick(win, hitRow, toggle)
	MakeDrag(win, hitRow, win.Root, 6)
	box.Button.MouseButton1Click:Connect(toggle)
	return obj
end

-- ColorPicker (componente) ----------------------------------------------
function Card:CreateColorPicker(o)
	o = o or {}
	local win = self.Window
	local title = o.Title or "ColorPicker"
	local area, row = self:_row(22, "ColorPicker")
	local color = ParseColor(o.Default or o.Color) or win.Accent
	Text({Text = title, TextSize = 14, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(18, 0), Size = UDim2.new(1, -90, 1, 0), Parent = row})
	local hit = Create("TextButton", {Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = row})
	local glows = {}
	for _, s in ipairs({{6, 0.82}, {12, 0.88}, {18, 0.92}, {26, 0.95}, {34, 0.97}}) do
		local g = Create("Frame", {
			BackgroundColor3 = color, BackgroundTransparency = s[2], AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -39.5, 0.5, 0), Size = UDim2.fromOffset(19 + s[1], 19 + s[1]), Parent = row,
		})
		Corner(g, 4 + s[1] / 2)
		table.insert(glows, g)
	end
	local sw = Create("TextButton", {Text = "", BackgroundColor3 = color, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -30, 0.5, 0), Size = UDim2.fromOffset(19, 19), ZIndex = 3, Parent = row})
	Corner(sw, 4)

	local obj = {}
	local function apply(c, silent)
		color = c
		sw.BackgroundColor3 = c
		for _, g in ipairs(glows) do g.BackgroundColor3 = c end -- o glow sempre acompanha a cor
		if not silent then
			win:Log(title .. " : #" .. c:ToHex():upper())
			if o.Callback then task.spawn(o.Callback, c) end
		end
	end
	function obj:Set(c, silent) c = ParseColor(c) if c then apply(c, silent) end end
	function obj:Get() return color end
	local function click()
		if win.Picker and win.Picker.Open and win.Picker.owner == obj then
			win:_closePicker()
		else
			win:_openPicker(obj, color, function(c) apply(c) end, row)
		end
	end
	OnClick(win, hit, click)
	MakeDrag(win, hit, win.Root, 6)
	sw.MouseButton1Click:Connect(click)
	return obj
end

