local function EscapeRich(s) return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")) end

function Window:_refreshKeybinds()
	if not self.KeybindsList then return end
	for _, ch in ipairs(self.KeybindsList:GetChildren()) do
		if ch:IsA("TextLabel") then ch:Destroy() end
	end
	local acc = self.Accent:ToHex()
	local n = 0
	for _, b in ipairs(self.Binds) do
		if b.Show and b.Key then
			n = n + 1
			Text({
				RichText = true, Text = string.format('%s   <font color="#%s">[ %s ]</font>', EscapeRich(b.Name), acc, KeyName(b.Key)),
				FontFace = Navar.Fonts.Mono, TextSize = 14, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = n, Parent = self.KeybindsList,
			})
		end
	end
end

