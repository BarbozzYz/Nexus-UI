        Size = UDim2.new(1, 0, 0, 2),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = NotifyFrame,
    })
    Corner(TopGrad, 2)
    
    Create("TextLabel", {
        Size = UDim2.new(1, -20, 0, 20),
        Position = UDim2.fromOffset(10, 8),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = Theme.Text,
        TextSize = 13,
        Font = Enum.Font.Code,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = NotifyFrame,
    })
    Create("TextLabel", {
        Size = UDim2.new(1, -20, 0, 14),
        Position = UDim2.fromOffset(10, 28),
        BackgroundTransparency = 1,
        Text = desc,
        TextColor3 = Theme.SubText,
        TextSize = 11,
        Font = Enum.Font.Code,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = NotifyFrame,
    })

    if showButtons then
        local yesBtn = Create("TextButton", {
            Size = UDim2.fromOffset(60, 22),
            Position = UDim2.new(1, -140, 0, 50),
            BackgroundColor3 = Theme.Accent,
            BorderSizePixel = 0,
            Text = "Yes",
            TextColor3 = Color3.new(1, 1, 1),
            TextSize = 11,
            Font = Enum.Font.Code,
            Parent = NotifyFrame,
        })
        Corner(yesBtn, 4)
        
        local noBtn = Create("TextButton", {
            Size = UDim2.fromOffset(60, 22),
            Position = UDim2.new(1, -75, 0, 50),
            BackgroundColor3 = Theme.Accent,
            BorderSizePixel = 0,
            Text = "No",
            TextColor3 = Color3.new(1, 1, 1),
            TextSize = 11,
            Font = Enum.Font.Code,
            Parent = NotifyFrame,
        })
        Corner(noBtn, 4)
    end

    -- Progress bar
    local Bar = Create("Frame", {
        Size = UDim2.new(1, -20, 0, 3),
        Position = UDim2.new(0, 10, 1, -6),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = NotifyFrame,
    })
    Corner(Bar, 2)

    Tween(Bar, { Size = UDim2.new(0, 0, 0, 3) }, duration, Enum.EasingStyle.Linear)
    
    task.delay(duration, function()
        Tween(NotifyFrame, { BackgroundTransparency = 1 }, 0.3)
        task.wait(0.3)
        NotifyFrame:Destroy()
    end)
end

-- ============================================================
-- WINDOW PREVIEW (separado)
-- ============================================================
function Navar:CreateWindowPreview(opts)
    opts = opts or {}
    
    local PreviewFrame = Create("Frame", {
        Name = "WindowPreview",
        Position = opts.Position or UDim2.new(1, -340, 0.5, -180),
        Size = UDim2.fromOffset(320, 360),
        BackgroundColor3 = Theme.MenuBg,
        BorderSizePixel = 0,
        Parent = ScreenGui,
    })
    Corner(PreviewFrame, 8)
    
    -- TopBar
    local TopBar = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = PreviewFrame,
    })
    Corner(TopBar, 8)
    Create("Frame", {
        Size = UDim2.new(1, 0, 0, 8),
        Position = UDim2.new(0, 0, 1, -8),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = TopBar,
    })
    Create("TextLabel", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = opts.Title or "Window",
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 12,
        Font = Enum.Font.Code,
        Parent = TopBar,
    })
    
    Drag(TopBar, PreviewFrame)
    
    -- Viewport
    local Viewport = Create("ViewportFrame", {
        Size = UDim2.new(1, -20, 1, -80),
        Position = UDim2.fromOffset(10, 36),
        BackgroundColor3 = Color3.fromRGB(25, 25, 25),
        BorderSizePixel = 0,
        Parent = PreviewFrame,
    })
    Corner(Viewport, 6)
    
    local Cam = Create("Camera", {
        FieldOfView = 50,
        Parent = Viewport,
    })
    Viewport.CurrentCamera = Cam
    
    -- Footer
    Create("TextLabel", {
        Size = UDim2.new(1, -20, 0, 16),
        Position = UDim2.new(0, 10, 1, -22),
        BackgroundTransparency = 1,
        Text = "Made by BarbozaW",
        TextColor3 = Theme.SubText,
        TextSize = 9,
        Font = Enum.Font.Code,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = PreviewFrame,
    })
    
    -- Botão 3D / 2D
    local toggleBtn = Create("TextButton", {
        Size = UDim2.fromOffset(60, 20),
        Position = UDim2.new(1, -70, 1, -24),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Text = "2D",
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 10,
        Font = Enum.Font.Code,
        Parent = PreviewFrame,
    })
    Corner(toggleBtn, 4)
    
    local is3D = false
    
    toggleBtn.MouseButton1Click:Connect(function()
        is3D = not is3D
        toggleBtn.Text = is3D and "3D" or "2D"
    end)
    
    -- Carrega personagem do jogador
    task.spawn(function()
        local char = LocalPlayer.Character
        if not char then return end
        
        local clone = char:Clone()
        clone.Parent = Viewport
        
        -- Posiciona câmera
        local hrp = clone:FindFirstChild("HumanoidRootPart")
        if hrp then
            local pos = hrp.Position
            Cam.CFrame = CFrame.new(pos + Vector3.new(0, 0, 5), pos)
        end
        
        -- Rotação 3D
        RunService.RenderStepped:Connect(function()
            if is3D then
                local hrp2 = clone:FindFirstChild("HumanoidRootPart")
                if hrp2 then
                    hrp2.CFrame = hrp2.CFrame * CFrame.Angles(0, math.rad(1), 0)
                end
            end
        end)
    end)
    
    return PreviewFrame
end

