	})

	-- Binds globais --------------------------------------------------
	self:_addBind("Menu", cfg.ToggleKey or Enum.KeyCode.End, function() self:Toggle() end, true)
	self:_c(UserInputService.InputBegan:Connect(function(input)
		if self.Listening or UserInputService:GetFocusedTextBox() then return end
		local k = InputKey(input)
		if not k then return end
		for _, b in ipairs(self.Binds) do
			if b.Key == k and b.Fn then task.spawn(b.Fn) end
		end
	end))

	State.VisibleMenus = State.VisibleMenus + 1
	table.insert(State.WindowList, self)
	RefreshCursor()

	if cfg.Keybinds then self:SetKeybindsVisible(true) end
	if cfg.Performance then self:SetPerformanceVisible(true) end
	if cfg.Preview then self:CreatePreview(type(cfg.Preview) == "table" and cfg.Preview or {}) end
	return self
end

