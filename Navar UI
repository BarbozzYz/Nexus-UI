function Tab:_paint(sel)
	local col = sel and AccentText(self.Window) or T.TabIdle
	Tw(self.Label, 0.2, {TextColor3 = col})
	self.Icon.SetColor(col, true)
end

function Tab:Select()
	local win = self.Window
	if win.CurrentTab == self then return end
	win:_closeDropdown()
	local prev = win.CurrentTab
	win.CurrentTab = self
	if prev then
		prev:_paint(false)
		prev.Frame.Visible = false
	end
	self.Frame.Visible = true
	self:_paint(true)
	win:_moveIndicator(self.Button, prev ~= nil)
	if self.Current then
		self.Current:_play()
		self.Current:_place(false)
	end
end

