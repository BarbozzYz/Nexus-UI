----------------------------------------------------------------------
-- Caixa com gradiente + hover "fill" subindo de baixo pra cima
----------------------------------------------------------------------
local function GradBox(parent, p)
	local h, radius = p.Height, p.Radius or 5
	local box = Create("TextButton", {
		Name = p.Name or "GradBox", Text = "", BackgroundColor3 = Color3.new(1, 1, 1),
		Size = p.Size, Position = p.Position or UDim2.new(), AnchorPoint = p.AnchorPoint or Vector2.new(), Parent = parent,
	})
	Corner(box, radius)
	local base = Grad(box, p.Top, p.Bottom, 90)
	local wipe = Create("Frame", {
		Name = "Wipe", BackgroundTransparency = 1, ClipsDescendants = true, AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 0), Parent = box,
	})
	local fill = Create("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1), AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, h), Parent = wipe,
	})
	Corner(fill, radius)
	local inv = Grad(fill, p.Bottom, p.Top, 90)
	local label = Text({
		Name = "Label", Text = p.Text or "", TextSize = p.TextSize or 13, FontFace = p.Font or Navar.Fonts.Main,
		TextXAlignment = p.Align or Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 3, Parent = box,
	})
	if p.Padding then Pad(label, 0, p.Padding, 0, p.Padding) end
	local obj = {Button = box, Label = label}
	function obj.SetHover(on)
		Tw(wipe, 0.18, {Size = UDim2.new(1, 0, on and 1 or 0, 0)}, Enum.EasingStyle.Quad)
	end
	function obj.SetColors(top, bottom)
		base.Color = ColorSequence.new(top, bottom)
		inv.Color = ColorSequence.new(bottom, top)
	end
	box.MouseEnter:Connect(function() obj.SetHover(true) end)
	box.MouseLeave:Connect(function() obj.SetHover(false) end)
	return obj
end

-- chevron desenhado com duas barras (Rotation 0 = "^", 180 = "v")
local function Chevron(parent, color)
	local c = Create("Frame", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 14), Parent = parent})
	local bars = {}
	for i = 1, 2 do
		bars[i] = Create("Frame", {
			BackgroundColor3 = color, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(8, 2),
			Position = UDim2.new(i == 1 and 0.3 or 0.7, 0, 0.5, 0), Rotation = i == 1 and -45 or 45, Parent = c,
		})
		Corner(bars[i], 1)
	end
	return c
end

-- drag centralizado por janela. thr = nil: arrasta na hora; thr = n: so arrasta depois de mover n px (para botoes clicaveis)
local function MakeDrag(win, handle, target, thr)
	win:_c(handle.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			win:_beginDrag(target, thr)
		end
	end))
end

-- clique que e ignorado quando o usuario acabou de arrastar a janela
local function OnClick(win, btn, fn)
	btn.MouseButton1Click:Connect(function()
		if win._noClick then return end
		fn()
	end)
end

