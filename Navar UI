function SubTab:CreateCard(cfg)
	if type(cfg) == "string" then cfg = {Title = cfg} end
	cfg = cfg or {}
	local win = self.Window
	local idx = cfg.Column
	if idx == "Left" then idx = 1 elseif idx == "Right" then idx = 2 end
	if idx ~= 1 and idx ~= 2 then idx = (#self.Cols[2].Cards < #self.Cols[1].Cards) and 2 or 1 end
	local col = self.Cols[idx]

	local holder = Create("Frame", {Name = "CardHolder", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 60), LayoutOrder = #col.Cards + 1, Parent = col.Frame})
	local root = Create("CanvasGroup", {Name = "Card", BackgroundColor3 = T.Card, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = holder})
	Corner(root, 8)
	MakeDrag(win, root, win.Root)
	root:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		holder.Size = UDim2.new(1, 0, 0, root.AbsoluteSize.Y)
	end)

	local content = Create("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = root})
	List(content, 0)
	local header = Create("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 1, Parent = content})
	local iconHolder = Create("Frame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(16, 12), Size = UDim2.fromOffset(20, 20), Parent = header})
	local icon = MakeIcon(iconHolder, cfg.Icon, 18, 18, win.Accent)
	local title = Text({Text = cfg.Title or "Card", TextSize = 15, TextColor3 = win.Accent, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(45, 0), Size = UDim2.new(1, -60, 1, 0), Parent = header})
	local body = Create("Frame", {Name = "Body", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = content})
	Pad(body, 0, 16, 16, 16)
	List(body, 12)

	local border = Create("Frame", {Name = "Border", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 10, Parent = root})
	Corner(border, 8)
	local stroke = Stroke(border, T.CardEdge, 2, 0)
	local sg = Create("UIGradient", {Rotation = Navar.CardGradientRotation, Parent = stroke})
	win:Bind(function(c)
		sg.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, T.CardEdge), ColorSequenceKeypoint.new(0.5, c), ColorSequenceKeypoint.new(1, T.CardEdge)})
		icon.SetColor(c)
		title.TextColor3 = T.TextAccent or c
	end)

	local card = setmetatable({Window = win, SubTab = self, Root = root, Body = body, Holder = holder, _n = 0}, Card)
	table.insert(col.Cards, card)
	table.insert(self.CardList, card)
	self:_fit()
	if self.Page.Visible and win.CurrentTab == self.Tab then card:_enter(math.min(#self.CardList - 1, 6) * 0.05) end
	return card
end

function Card:_enter(delayT)
	self.Root.Position = UDim2.fromOffset(0, -28)
	self.Root.GroupTransparency = 1
	task.delay(delayT or 0, function()
		if self.Root.Parent then
			Tw(self.Root, 0.4, {Position = UDim2.fromOffset(0, 0), GroupTransparency = 0})
		end
	end)
end

function Card:_next()
	self._n = self._n + 1
	return self._n
end

function Card:_newArea()
	local area = Create("Frame", {Name = "Area", BackgroundColor3 = T.Area, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = self:_next(), Parent = self.Body})
	Corner(area, 6)
	MakeDrag(self.Window, area, self.Window.Root)
	Pad(area, 12, 0, 12, 0)
	List(area, 4)
	self._lastKind = nil
	return area
end

-- cria uma linha de componente (area propria)
function Card:_row(height, kind)
	local area = self:_newArea()
	self._lastKind = kind
	return area, Create("Frame", {Name = kind or "Row", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, height), Parent = area})
end
