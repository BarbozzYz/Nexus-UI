-- Cursor proprio (so aparece com a UI aberta) + onda ao clicar
----------------------------------------------------------------------
local function SpawnRipple(pos)
	local layer = State.Cursor.Layer
	for n = 1, 2 do
		task.delay((n - 1) * 0.04, function()
			if not layer.Parent then return end
			local c = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(pos.X, pos.Y), Size = UDim2.fromOffset(8, 8),
				BackgroundColor3 = State.Accent or T.Accent, BackgroundTransparency = 0.3, ZIndex = 1, Parent = layer,
			})
			Round(c)
			Tw(c, 0.1, {Size = UDim2.fromOffset(34, 34), BackgroundTransparency = 1}, Enum.EasingStyle.Quad)
			task.delay(0.15, function() c:Destroy() end)
		end)
	end
end

-- calibracao do ponto do cursor (a imagem pode ter margem transparente): Alt + setas ajusta, e salva no executor
local OFFSET_FILE = "NavarCursorOffset.txt"
local function LoadCursorOffset()
	if Navar.CursorOffset ~= Vector2.new(0, 0) then return end
	pcall(function()
		if isfile and readfile and isfile(OFFSET_FILE) then
			local x, y = readfile(OFFSET_FILE):match("(-?[%d%.]+)%s*,%s*(-?[%d%.]+)")
			if x and y then Navar.CursorOffset = Vector2.new(tonumber(x), tonumber(y)) end
		end
	end)
end
local function SaveCursorOffset()
	pcall(function()
		if writefile then writefile(OFFSET_FILE, Navar.CursorOffset.X .. "," .. Navar.CursorOffset.Y) end
	end)
end

local function InitCursor()
	if State.Cursor and State.Cursor.Gui.Parent then return end
	local gui = Create("ScreenGui", {
		Name = "NavarCursor", ResetOnSpawn = false, IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 2147483647,
	})
	pcall(function() gui.ScreenInsets = Enum.ScreenInsets.None end)
	ParentGui(gui)
	local layer = Create("Frame", {Name = "Layer", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = gui})
	local img = Create("ImageLabel", {
		Name = "Pointer", BackgroundTransparency = 1, Size = UDim2.fromOffset(18, 18), Image = Navar.Assets.Cursor,
		ImageColor3 = State.Accent or T.Accent, ZIndex = 5, Visible = false, Parent = layer,
	})
	State.Cursor = {Gui = gui, Layer = layer, Img = img}
	LoadCursorOffset()
	table.insert(State.Conns, RunService.RenderStepped:Connect(function()
		if img.Visible then
			local p = MousePos(gui) + Navar.CursorOffset
			img.Position = UDim2.fromOffset(p.X, p.Y)
			if UserInputService.MouseIconEnabled then UserInputService.MouseIconEnabled = false end
		end
	end))
	table.insert(State.Conns, UserInputService.InputBegan:Connect(function(i)
		if not img.Visible then return end
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			SpawnRipple(MousePos(gui))
		elseif i.UserInputType == Enum.UserInputType.Keyboard
			and (UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt)) then
			-- Alt + setas: move a imagem do cursor 1px (Shift = 5px). Cima/esquerda = valores negativos
			local step = (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)) and 5 or 1
			local d = ({[Enum.KeyCode.Up] = Vector2.new(0, -step), [Enum.KeyCode.Down] = Vector2.new(0, step),
				[Enum.KeyCode.Left] = Vector2.new(-step, 0), [Enum.KeyCode.Right] = Vector2.new(step, 0)})[i.KeyCode]
			if d then
				Navar.CursorOffset = Navar.CursorOffset + d
				SaveCursorOffset()
				local msg = string.format("Cursor offset: %d, %d  (Navar.CursorOffset)", Navar.CursorOffset.X, Navar.CursorOffset.Y)
				print("[Navar] " .. msg)
				for _, w in ipairs(State.WindowList) do w:Log(msg) end
			end
		end
	end))
end

local function RefreshCursor()
	InitCursor()
	local any = State.VisibleMenus > 0
	local img = State.Cursor.Img
	if any and not img.Visible then State.SavedMouseIcon = UserInputService.MouseIconEnabled end
	if (not any) and img.Visible then UserInputService.MouseIconEnabled = State.SavedMouseIcon end
	img.Visible = any
end

