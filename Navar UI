local function NotifyHolder(left)
	local key = left and "NotifyLeft" or "NotifyRight"
	if State[key] and State[key].Parent then return State[key] end
	local f = Create("Frame", {
		Name = key, BackgroundTransparency = 1, AnchorPoint = Vector2.new(left and 0 or 1, 1),
		Position = UDim2.new(left and 0 or 1, left and 20 or -20, 1, -20), Size = UDim2.fromOffset(270, 0),
		AutomaticSize = Enum.AutomaticSize.Y, Parent = State.NotifyLayer,
	})
	Create("UIListLayout", {
		Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = left and Enum.HorizontalAlignment.Left or Enum.HorizontalAlignment.Right, Parent = f,
	})
	State[key] = f
	return f
end

function Navar:Notify(cfg)
	cfg = cfg or {}
	GetGui()
	local left = cfg.Side == "Left"
	local accent = State.Accent or T.Accent
	local offX = left and -1.3 or 1.3
	State.NotifyCount = State.NotifyCount + 1
	local slot = Create("Frame", {
		Name = "Slot", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = State.NotifyCount, Parent = NotifyHolder(left),
	})
	local box = Create("CanvasGroup", {
		Name = "Notify", BackgroundColor3 = T.NotifyBg, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.new(offX, 0, 0, 0), GroupTransparency = 1, Parent = slot,
	})
	Corner(box, 10)
	local content = Create("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = box})
	Pad(content, 10, 12, 16, 12)
	List(content, 4)

	local titleRow = Create("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 1, Parent = content})
	local tx = 0
	local bell = ResolveIcon(cfg.Icon == nil and "Bell" or cfg.Icon)
	if bell and bell.Image then
		local holder = Create("Frame", {BackgroundTransparency = 1, Size = UDim2.fromOffset(16, 18), Parent = titleRow})
		MakeIcon(holder, bell, 12, 13, T.Text)
		tx = 22
	end
	Text({Text = cfg.Title or "Notify", FontFace = Navar.Fonts.Mono, TextSize = 14, Position = UDim2.fromOffset(tx, 0), Size = UDim2.new(1, -tx, 1, 0), Parent = titleRow})
	if cfg.Description and cfg.Description ~= "" then
		Text({
			Text = cfg.Description, FontFace = Navar.Fonts.Mono, TextSize = 11, TextColor3 = T.NotifyDesc, TextWrapped = true,
			AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2, Parent = content,
		})
	end

	local closed = false
	local function close()
		if closed then return end
		closed = true
		Tw(box, 0.3, {Position = UDim2.new(offX, 0, 0, 0), GroupTransparency = 1}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		task.delay(0.35, function() slot:Destroy() end)
	end

	if cfg.Buttons and #cfg.Buttons > 0 then
		local row = Create("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 3, Parent = content})
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right,
			Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = row,
		})
		for idx, b in ipairs(cfg.Buttons) do
			local title = type(b) == "table" and (b.Title or b.Text) or tostring(b)
			local gb = GradBox(row, {
				Name = "Btn" .. idx, Size = UDim2.fromOffset(60, 20), Height = 20, Top = accent, Bottom = T.ButtonDark,
				Text = title, TextSize = 11, Font = Navar.Fonts.Mono, Radius = 4,
			})
			gb.Button.LayoutOrder = idx
			gb.Button.MouseButton1Click:Connect(function()
				close()
				if type(b) == "table" and b.Callback then task.spawn(b.Callback, title, idx) end
				if cfg.Callback then task.spawn(cfg.Callback, title, idx) end
			end)
		end
	end

	local duration = cfg.Duration or 5
	local bar = Create("Frame", {
		Name = "Duration", BackgroundColor3 = accent, Position = UDim2.new(0, 12, 1, -6), Size = UDim2.new(1, -24, 0, 2), Parent = box,
	})
	Round(bar)
	Tw(box, 0.35, {Position = UDim2.new(0, 0, 0, 0), GroupTransparency = 0}, Enum.EasingStyle.Quint)
	Tw(bar, duration, {Size = UDim2.new(0, 0, 0, 2)}, Enum.EasingStyle.Linear)
	task.delay(duration, close)
	return {Close = close}
end

function Navar:SetIconProvider(fn) Navar.IconProvider = fn end
function Navar:RegisterIcon(name, icon) Navar.Icons[name] = icon end
function Navar:RegisterIcons(tbl) for k, v in pairs(tbl) do Navar.Icons[k] = v end end

-- baixa uma fonte .ttf e cria uma Font (precisa de writefile/getcustomasset). Use antes de CreateWindow.
function Navar:LoadFont(name, url, weight)
	if not (writefile and getcustomasset) then return nil end
	local ok, res = pcall(function()
		writefile(name .. ".ttf", game:HttpGet(url))
		writefile(name .. ".json", HttpService:JSONEncode({
			name = name, faces = {{name = "Regular", weight = 400, style = "normal", assetId = getcustomasset(name .. ".ttf")}},
		}))
		return Font.new(getcustomasset(name .. ".json"), weight or Enum.FontWeight.Regular, Enum.FontStyle.Normal)
	end)
	if ok then return res end
	return nil
end
