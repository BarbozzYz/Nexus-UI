-- KEYBIND
-- ============================================================
function Navar:AddKeybind(card, opts)
    opts = opts or {}
    local title = opts.Title or "Keybind"
    local default = opts.Default or "End"
    local callback = opts.Callback or function() end
    
    card.ElementCount = card.ElementCount + 1
    local key = default
    local listening = false
    local dotCount = 0
    local dotLoop = nil

    local Holder = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundTransparency = 1,
        LayoutOrder = card.ElementCount + 1,
        Parent = card.Frame,
    })

    Create("TextLabel", {
        Size = UDim2.new(0.5, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = Theme.Text,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })

    local KeyBtn = Create("TextButton", {
        Size = UDim2.new(0.5, 0, 1, 0),
        Position = UDim2.new(0.5, 0, 0, 0),
        BackgroundColor3 = Theme.ButtonBg,
        BorderSizePixel = 0,
        Text = key,
        TextColor3 = Theme.Text,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        AutoButtonColor = false,
        Parent = Holder,
    })
    Corner(KeyBtn, 6)
    Stroke(KeyBtn, Theme.Outline, 1, 0.4)

    local function StartListening()
        listening = true
        dotCount = 0
        KeyBtn.Text = "..."
        
        dotLoop = task.spawn(function()
            while listening do
                task.wait(0.5)
                dotCount = dotCount + 1
                if dotCount > 3 then dotCount = 1 end
                KeyBtn.Text = string.rep(".", dotCount)
            end
        end)
    end

    local function StopListening(newKey)
        listening = false
        if dotLoop then pcall(task.cancel, dotLoop) end
        dotCount = 0
        if newKey then
            key = newKey
            KeyBtn.Text = key
            self:_log(title .. ": " .. key)
            if self.AddKeybindToList then
                -- Atualiza a lista de keybinds
                for _, child in ipairs(self.KeybindList:GetChildren()) do
                    if child:IsA("Frame") then
                        local lbl = child:FindFirstChildOfClass("TextLabel")
                        if lbl and lbl.Text == title then
                            local keyLbl = child:GetChildren()[2]
                            if keyLbl then keyLbl.Text = "[ " .. key .. " ]" end
                        end
                    end
                end
            end
            callback(key)
        else
            KeyBtn.Text = key
        end
    end

    KeyBtn.MouseButton1Click:Connect(function()
        if not listening then
            StartListening()
        end
    end)

    UserInputService.InputBegan:Connect(function(input, gp)
        if not listening then return end
        if gp then return end
        
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode == Enum.KeyCode.Backspace then
                StopListening()
            else
                StopListening(input.KeyCode.Name)
            end
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
            StopListening("M1")
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
            StopListening("M2")
        end
    end)

    -- Adiciona na lista de keybinds se existir
    if self.AddKeybindToList then
        self:AddKeybindToList(title, key)
    end

    local keybind = {
        Value = key,
        Set = function(v)
            key = v
            KeyBtn.Text = v
        end,
        Get = function() return key end,
        Frame = Holder,
    }
    
    table.insert(card.Elements, keybind)
    return keybind
end

