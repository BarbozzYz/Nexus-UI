		local stats = Text({Text = "FPS: 0    MS: 0", FontFace = Navar.Fonts.Mono, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 29), Size = UDim2.new(1, 0, 0, 20), Parent = f})
		Text({Text = CREDIT, FontFace = Navar.Fonts.Mono, TextSize = 11, TextColor3 = T.Credit, Position = UDim2.fromOffset(12, 54), Size = UDim2.new(1, -24, 0, 16), Parent = f})
		local frames = 0
		self:_c(RunService.Heartbeat:Connect(function() frames = frames + 1 end))
