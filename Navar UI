local Window, Tab, SubTab, Card = {}, {}, {}, {}
Window.__index = Window
Tab.__index = Tab
SubTab.__index = SubTab
Card.__index = Card

local SIDE, DOWNBAR = 207, 18

function Window:_c(conn) table.insert(self.Conns, conn) return conn end

-- registra uma funcao que recebe a cor principal (chamada agora e a cada SetAccent)
function Window:Bind(fn)
	table.insert(self.AccentFns, fn)
	fn(self.Accent)
end

function Window:SetAccent(c)
	local col = ParseColor(c)
	if not col then return end
	self.Accent = col
	State.Accent = col
	TintCursor(col)
	for _, fn in ipairs(self.AccentFns) do pcall(fn, col) end
end

function Window:Log(text)
	if self.LogLabel then self.LogLabel.Text = tostring(text) end
end

function Window:Notify(cfg) return Navar:Notify(cfg) end

function Window:_closeDropdown()
	if self.CloseDropdown then self.CloseDropdown() end
end

function Window:_addBind(name, key, fn, show)
	local b = {Name = name, Key = key, Fn = fn, Show = show}
	table.insert(self.Binds, b)
	self:_refreshKeybinds()
	return b
end

-- espera a proxima tecla/mouse (M1/M2). Esc/Backspace limpa
function Window:_beginDrag(target, thr)
	local m = MousePos()
	self._d = {
		target = target, thr = thr, start = m, dragging = (thr == nil),
		pos = Vector2.new(target.Position.X.Offset, target.Position.Y.Offset),
	}
	if thr == nil then self:_closeDropdown() end
end

function Window:_initDrag()
	self:_c(UserInputService.InputChanged:Connect(function(i)
		local d = self._d
		if not d then return end
		if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
		local delta = MousePos() - d.start
		if not d.dragging then
			if delta.Magnitude < d.thr then return end
			d.dragging = true
			self._noClick = true
			self:_closeDropdown()
		end
		-- sem clamp: a janela pode sair da tela
		d.target.Position = UDim2.fromOffset(d.pos.X + delta.X, d.pos.Y + delta.Y)
	end))
	self:_c(UserInputService.InputEnded:Connect(function(i)
		if (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) and self._d then
			local was = self._d.dragging and self._d.thr ~= nil
			self._d = nil
			if was then task.delay(0.15, function() self._noClick = false end) end
		end
	end))
end

function Window:_listen(cb)
	if self._listenConn then self._listenConn:Disconnect() end
	self.Listening = true
	self._listenConn = UserInputService.InputBegan:Connect(function(input)
		local k = InputKey(input)
		if not k then return end
		self._listenConn:Disconnect()
		self._listenConn = nil
		if k == Enum.KeyCode.Escape or k == Enum.KeyCode.Backspace then k = nil end
		task.delay(0.1, function() self.Listening = false end)
		cb(k)
	end)
end

function Window:SetVisible(v)
	if self.Visible == v then return end
	self.Visible = v
	self.Root.Visible = v
	State.VisibleMenus = State.VisibleMenus + (v and 1 or -1)
	if not v then
		self:_closeDropdown()
		self:_closePicker(true)
	end
	if self.PreviewObj then self.PreviewObj:_sync() end
	RefreshCursor()
end

function Window:Toggle() self:SetVisible(not self.Visible) end

function Window:Destroy()
	if self.Destroyed then return end
	self.Destroyed = true
	if self.Visible then State.VisibleMenus = State.VisibleMenus - 1 end
	for _, c in ipairs(self.Conns) do pcall(function() c:Disconnect() end) end
	if self._listenConn then self._listenConn:Disconnect() end
	for _, f in ipairs({self.Root, self.KeybindsFrame, self.PerfFrame, self.PickerRoot, self.PreviewFrame}) do
		if f then pcall(function() f:Destroy() end) end
	end
	RefreshCursor()
end

function Navar:Unload()
	for _, w in ipairs(State.WindowList) do w:Destroy() end
	State.WindowList = {}
	for _, c in ipairs(State.Conns) do pcall(function() c:Disconnect() end) end
	State.Conns = {}
	if State.Cursor then
		UserInputService.MouseIconEnabled = State.SavedMouseIcon
		State.Cursor.Gui:Destroy()
		State.Cursor = nil
	end
	if State.Gui then State.Gui:Destroy() end
	State.Gui, State.NotifyLeft, State.NotifyRight = nil, nil, nil
	State.VisibleMenus = 0
end

