function Window:AddSubTabs(tab, subtabs)
    if not tab.SubTabs then tab.SubTabs = {} end
    
    local Container = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundTransparency = 1,
        Parent = tab.ContentFrame,
    })
    
    local rowWidth = 120
    for i, sub in ipairs(subtabs) do
        local SubBtn = Create("TextButton", {
            Size = UDim2.fromOffset(rowWidth, 30),
            Position = UDim2.fromOffset((i - 1) * (rowWidth + 5), 0),
            BackgroundTransparency = 1,
            Text = sub,
            TextColor3 = Theme.TabUnselected,
            TextSize = 12,
            Font = Enum.Font.GothamMedium,
            AutoButtonColor = false,
            Parent = Container,
        })
        
        local Line = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 2),
            Position = UDim2.new(0, 0, 1, -2),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Parent = SubBtn,
        })
        Corner(Line, 1)
        Create("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, self.Accent),
                ColorSequenceKeypoint.new(1, Theme.MenuBg),
            }),
            Parent = Line,
        })
        
        local subTab = {
            Name = sub,
            Button = SubBtn,
            Line = Line,
            Cards = {},
        }
        table.insert(tab.SubTabs, subTab)
        
        SubBtn.MouseButton1Click:Connect(function()
            for _, st in ipairs(tab.SubTabs) do
                Tween(st.Button, { TextColor3 = Theme.TabUnselected }, 0.2)
                Tween(st.Line, { BackgroundTransparency = 1 }, 0.2)
            end
            Tween(SubBtn, { TextColor3 = self.Accent }, 0.2)
            Tween(Line, { BackgroundTransparency = 0 }, 0.2)
            tab.CurrentSubTab = subTab
            self:_log("Sub-tab: " .. sub)
        end)
    end
    
    -- Seleciona primeira
    if #tab.SubTabs > 0 then
        local first = tab.SubTabs[1]
        first.Button.TextColor3 = self.Accent
        first.Line.BackgroundTransparency = 0
        tab.CurrentSubTab = first
    end
    
    return tab.SubTabs
end

