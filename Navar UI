local State = {Gui = nil, Windows = nil, Overlay = nil, NotifyLayer = nil, Cursor = nil, Accent = nil,
	NotifyCount = 0, VisibleMenus = 0, SavedMouseIcon = true, TopZ = 10, Conns = {}, WindowList = {}}

-- posicao do mouse no MESMO espaco do AbsolutePosition (desconta o inset da topbar, se houver)
local function MousePos(gui)
	local m = UserInputService:GetMouseLocation()
	local g = gui or State.Gui
	if g and g.Parent then
		local cam = workspace.CurrentCamera
		local dy = (cam and cam.ViewportSize.Y or 0) - g.AbsoluteSize.Y
		if dy > 0 and dy < 80 then m = Vector2.new(m.X, m.Y - dy) end
	end
	return m
end

local function ParentGui(gui)
	if syn and syn.protect_gui then pcall(syn.protect_gui, gui) end
	local ok, hui = pcall(function() return gethui and gethui() end)
	if ok and hui then gui.Parent = hui return end
	local ok2 = pcall(function() gui.Parent = CoreGui end)
	if not ok2 or gui.Parent == nil then gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end
end

local function Cleanup()
	local places = {}
	pcall(function() table.insert(places, CoreGui) end)
	local ok, hui = pcall(function() return gethui and gethui() end)
	if ok and hui then table.insert(places, hui) end
	for _, p in ipairs(places) do
		for _, n in ipairs({"Navar", "NavarCursor"}) do
			pcall(function()
				local o = p:FindFirstChild(n)
				if o then o:Destroy() end
			end)
		end
	end
end

local function GetGui()
	if State.Gui and State.Gui.Parent then return State.Gui end
	Cleanup()
	local gui = Create("ScreenGui", {
		Name = "Navar", ResetOnSpawn = false, IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 1000,
	})
	pcall(function() gui.ScreenInsets = Enum.ScreenInsets.None end)
	ParentGui(gui)
	local function layer(name, z)
		return Create("Frame", {Name = name, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = z, Parent = gui})
	end
	State.Gui = gui
	State.Windows = layer("Windows", 1)
	State.Overlay = layer("Overlay", 5)
	State.NotifyLayer = layer("Notifications", 10)
	return gui
end

