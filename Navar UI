function Navar:AddSlider(card, opts)
    opts = opts or {}
    local title = opts.Title or "Slider"
    local min = opts.MinValue or 0
    local max = opts.MaxValue or 100
    local default = opts.Default or min
    local callback = opts.Callback or function() end
    
    card.ElementCount = card.ElementCount + 1
    local value = default

    local Holder = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundTransparency = 1,
        LayoutOrder = card.ElementCount + 1,
        Parent = card.Frame,
    })

    Create("TextLabel", {
        Size = UDim2.new(1, -50, 0, 16),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = Theme.Text,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })

    local ValueLabel = Create("TextLabel", {
        Size = UDim2.fromOffset(40, 16),
        Position = UDim2.new(1, -40, 0, 0),
        BackgroundTransparency = 1,
        Text = tostring(value),
        TextColor3 = Theme.Text,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = Holder,
    })

    local BarBg = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 6),
        Position = UDim2.fromOffset(0, 22),
        BackgroundColor3 = Theme.ToggleOffGrad1,
        BorderSizePixel = 0,
        Parent = Holder,
    })
    Corner(BarBg, 3)

    local Fill = Create("Frame", {
        Size = UDim2.fromScale((value - min) / (max - min), 1),
        BackgroundColor3 = self.Accent,
        BorderSizePixel = 0,
        Parent = BarBg,
    })
    Corner(Fill, 3)

    local Knob = Create("Frame", {
        Size = UDim2.fromOffset(12, 12),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = BarBg,
    })
    Corner(Knob, 6)

    local HitArea = Create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = BarBg,
    })

    local dragging = false

    local function Update(input)
        local pos = input.Position.X
        local rel = math.clamp((pos - BarBg.AbsolutePosition.X) / BarBg.AbsoluteSize.X, 0, 1)
        value = math.floor(min + (max - min) * rel)
        ValueLabel.Text = tostring(value)
        Tween(Fill, { Size = UDim2.fromScale(rel, 1) }, 0.05)
        Tween(Knob, { Position = UDim2.new(rel, 0, 0.5, 0) }, 0.05)
        self:_log(title .. ": " .. value)
        callback(value)
    end

    HitArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            Update(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            Update(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    local slider = {
        Value = value,
        Set = function(v)
            value = math.clamp(v, min, max)
            ValueLabel.Text = tostring(value)
            local rel = (value - min) / (max - min)
            Fill.Size = UDim2.fromScale(rel, 1)
            Knob.Position = UDim2.new(rel, 0, 0.5, 0)
            callback(value)
        end,
        Get = function() return value end,
        Frame = Holder,
    }
    
    table.insert(card.Elements, slider)
    return slider
end

