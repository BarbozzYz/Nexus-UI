	show()
	local bind = win:_addBind(title, key, function()
		win:Log(title .. " : Pressionado !")
		if o.Callback then o.Callback(key) end
	end, o.ShowInList ~= false)
	box.Button.MouseButton1Click:Connect(function()
		if listening or win.Listening then return end
		listening = true
		task.spawn(function()
			local n = 0
			while listening do
				n = n % 3 + 1
				box.Label.Text = string.rep(".", n) -- . -> .. -> ... em loop a cada 0.5s
				task.wait(0.5)
			end
		end)
		win:_listen(function(k)
			listening = false
			key = k
			bind.Key = k
			show()
			win:_refreshKeybinds()
			win:Log(title .. " : " .. KeyName(k))
			if o.Changed then task.spawn(o.Changed, k) end
		end)
	end)
	local obj = {}
	function obj:Get() return key end
	function obj:Set(k) key = k bind.Key = k show() win:_refreshKeybinds() end
	return obj
end

